From 3f6dc8fa42e8cbf1dd4af76e0627e2db24235cbf Mon Sep 17 00:00:00 2001
From: Vortiago <atle@havso.net>
Date: Wed, 7 Oct 2026 20:28:45 +0200
Subject: [PATCH] perf(ggml-cpu): run the routed experts of a small batch as
 one op

At decode and MTP verify (fewer than 64 routed rows) the routed MoE FFN
ran as up MUL_MAT_ID, gate MUL_MAT_ID, SWIGLU and down MUL_MAT_ID: seven
barriers, the input quantized twice, and three threadpool passes over
the expert rows that each end with the threads waiting for the slowest.

ggml_cpu_try_fuse_ops now matches this pattern, as build_moe_ffn emits
it for separate gate and up experts, and runs it in three steps:
1. quantize the input once and group the routed rows by expert; barrier.
2. per block of 32 rows of one expert: the gate and up rows, the SWIGLU
   of the block, and the block quantized for down; barrier.
3. down, in blocks of 64 rows of one expert.
In steps 2 and 3 the threads take the blocks in expert order from a
counter, so a thread that runs late hands its share to the others. A
first version gave each thread one fixed run of blocks; it waited longer
at the barriers than the unfused ops.

The result is bit-exact. Each output is the same vec_dot over the same
quantized rows. The SWIGLU blocks start at multiples of 16, the widest
fixed SIMD step of ggml_vec_swiglu_f32, so each element takes the same
SIMD or scalar path as before. The down input is quantized per block, as
from_float does. The fusion only takes MUL_MAT_IDs that the unfused op
computes with one_chunk: below 64 routed rows the sgemm path never runs,
and tiled and repacked weights are left out.

The work buffer of the fused op holds both quantized inputs; ggml_graph_plan
reserves it at the down node.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01C6MCJC4HTKxvuGjKjqDuqQ
---
 ggml/src/ggml-cpu/ggml-cpu.c | 251 +++++++++++++++++++++++++++++++++++
 1 file changed, 251 insertions(+)

diff --git a/ggml/src/ggml-cpu/ggml-cpu.c b/ggml/src/ggml-cpu/ggml-cpu.c
index db75962b6..106bd71cc 100644
--- a/ggml/src/ggml-cpu/ggml-cpu.c
+++ b/ggml/src/ggml-cpu/ggml-cpu.c
@@ -2126,6 +2126,180 @@ static void ggml_compute_forward_mul_mat_id(
     }
 }
 
+// The routed experts of a MoE FFN in one op: up and gate MUL_MAT_ID, the SWIGLU of the two,
+// and the down MUL_MAT_ID. Used for small batches (decode and MTP verify), where the unfused
+// ops run with seven barriers and the expert reads leave threads idle at each one. Here:
+//   1. quantize src1 once for up and gate, group the routed rows by expert;    barrier
+//   2. per block of rows of one expert: gate and up rows, SWIGLU of the block, and the
+//      block quantized for down;                                                 barrier
+//   3. down.
+// Each output is the same vec_dot over the same quantized rows as in the unfused ops, the
+// SWIGLU blocks start at multiples of 16 (the widest fixed SIMD step of ggml_vec_swiglu_f32),
+// and the down quantization works per block, so the result is bit-exact.
+
+// Rows in a block of step 2. A multiple of 16, and of the block size of down's vec_dot type,
+// so that the quantization of a block is whole.
+static int64_t ggml_moe_ffn_block_rows(const struct ggml_tensor * down) {
+    const enum ggml_type vdt = type_traits_cpu[down->src[0]->type].vec_dot_type;
+    return MAX(32, ggml_blck_size(vdt));
+}
+
+static size_t ggml_moe_ffn_wsize(const struct ggml_tensor * gate, const struct ggml_tensor * glu, const struct ggml_tensor * down) {
+    const struct ggml_tensor * x   = gate->src[1];
+    const struct ggml_tensor * ids = gate->src[2];
+    const int64_t n_as = gate->src[0]->ne[2];
+    const enum ggml_type vdt_ug = type_traits_cpu[gate->src[0]->type].vec_dot_type;
+    const enum ggml_type vdt_dn = type_traits_cpu[down->src[0]->type].vec_dot_type;
+
+    return ggml_row_size(vdt_ug, ggml_nelements(x))   + CACHE_LINE_SIZE +
+           ggml_row_size(vdt_dn, ggml_nelements(glu)) + CACHE_LINE_SIZE +
+           n_as*sizeof(int64_t) + CACHE_LINE_SIZE +
+           n_as*ids->ne[0]*ids->ne[1]*sizeof(struct mmid_row_mapping) + CACHE_LINE_SIZE +
+           (n_as + 1)*sizeof(int32_t) + CACHE_LINE_SIZE +
+           2*CACHE_LINE_SIZE + CACHE_LINE_SIZE;
+}
+
+// unit u of n_active experts with nb blocks of blk rows each: the rows of that block for all
+// routed rows of the expert, through one_chunk
+static void ggml_moe_ffn_run_unit(
+        struct ggml_tensor * dst, const int32_t * active, int64_t nb, int64_t blk, int64_t u,
+        const int64_t * counts, const struct mmid_row_mapping * matrix_rows, const void * wdata, size_t row_size) {
+    const struct ggml_tensor * src0 = dst->src[0];
+
+    const int32_t cur_a = active[u / nb];
+    const int64_t r0    = (u % nb)*blk;
+    const int64_t r1    = MIN(r0 + blk, src0->ne[1]);
+
+    ggml_compute_forward_mul_mat_id_one_chunk(dst, src0, dst->src[1], dst->src[2], cur_a,
+        r0, r1, 0, counts[cur_a], (const char *) src0->data + cur_a*src0->nb[2],
+        matrix_rows, row_size, true, wdata);
+}
+
+static void ggml_compute_forward_moe_ffn(
+        const struct ggml_compute_params * params,
+        struct ggml_tensor * up,
+        struct ggml_tensor * gate,
+        struct ggml_tensor * glu,
+        struct ggml_tensor * down) {
+
+    const struct ggml_tensor * x   = gate->src[1];
+    const struct ggml_tensor * ids = gate->src[2];
+
+    const int ith = params->ith;
+    const int nth = params->nth;
+
+    const int64_t n_as  = gate->src[0]->ne[2];
+    const int     n_ids = ids->ne[0];
+
+    const enum ggml_type vdt_ug = type_traits_cpu[gate->src[0]->type].vec_dot_type;
+    const enum ggml_type vdt_dn = type_traits_cpu[down->src[0]->type].vec_dot_type;
+    ggml_from_float_t const from_float_ug = type_traits_cpu[vdt_ug].from_float;
+    ggml_from_float_t const from_float_dn = type_traits_cpu[vdt_dn].from_float;
+
+    const size_t row_ug = ggml_row_size(vdt_ug, x->ne[0]);
+    const size_t row_dn = ggml_row_size(vdt_dn, glu->ne[0]);
+
+    void * wdata_cur = params->wdata;
+    char * wx = incr_ptr_aligned(&wdata_cur, ggml_row_size(vdt_ug, ggml_nelements(x)), CACHE_LINE_SIZE);
+    char * wg = incr_ptr_aligned(&wdata_cur, ggml_row_size(vdt_dn, ggml_nelements(glu)), CACHE_LINE_SIZE);
+    int64_t * counts = incr_ptr_aligned(&wdata_cur, n_as*sizeof(int64_t), CACHE_LINE_SIZE);
+    struct mmid_row_mapping * matrix_rows =
+        incr_ptr_aligned(&wdata_cur, n_as*ids->ne[0]*ids->ne[1]*sizeof(struct mmid_row_mapping), CACHE_LINE_SIZE);
+    int32_t * active = incr_ptr_aligned(&wdata_cur, (n_as + 1)*sizeof(int32_t), CACHE_LINE_SIZE);
+    // the next unit of steps 2 and 3, one cache line each
+    char (*next_unit)[CACHE_LINE_SIZE] = incr_ptr_aligned(&wdata_cur, 2*CACHE_LINE_SIZE, CACHE_LINE_SIZE);
+
+    GGML_ASSERT(params->wsize >= (size_t) ((char *) wdata_cur - (char *) params->wdata));
+
+    // 1. quantize x, split by blocks as mul_mat_id does; group the rows by expert
+    {
+        const size_t  bs   = ggml_blck_size(vdt_ug);
+        const int64_t ne10 = x->ne[0];
+        const int64_t b0   = (ith*ne10/bs)/nth;
+        const int64_t b1   = ((ith + 1)*ne10/bs)/nth;
+        for (int64_t i13 = 0; i13 < x->ne[3]; ++i13) {
+            for (int64_t i12 = 0; i12 < x->ne[2]; ++i12) {
+                for (int64_t i11 = 0; i11 < x->ne[1]; ++i11) {
+                    const int64_t row = i11 + x->ne[1]*(i12 + x->ne[2]*i13);
+                    from_float_ug((const float *) ((const char *) x->data + i13*x->nb[3] + i12*x->nb[2] + i11*x->nb[1] + b0*bs*x->nb[0]),
+                                  wx + row*row_ug + b0*ggml_type_size(vdt_ug), (b1 - b0)*bs);
+                }
+            }
+        }
+    }
+
+    if (ith == 0) {
+        memset(counts, 0, n_as*sizeof(int64_t));
+        for (int64_t iid1 = 0; iid1 < ids->ne[1]; ++iid1) {
+            for (int id = 0; id < n_ids; ++id) {
+                const int32_t i02 = *(const int32_t *) ((const char *) ids->data + iid1*ids->nb[1] + id*ids->nb[0]);
+                GGML_ASSERT(i02 >= 0 && i02 < n_as);
+                MMID_MATRIX_ROW(i02, counts[i02]) = (struct mmid_row_mapping) {id, iid1};
+                counts[i02] += 1;
+            }
+        }
+        // the experts with rows, in expert order; the count goes in the last slot
+        int32_t n = 0;
+        for (int64_t a = 0; a < n_as; ++a) {
+            if (counts[a] > 0) {
+                active[n++] = (int32_t) a;
+            }
+        }
+        active[n_as] = n;
+
+        // every thread starts at unit ith
+        atomic_store_explicit((atomic_int *) next_unit[0], nth, memory_order_relaxed);
+        atomic_store_explicit((atomic_int *) next_unit[1], nth, memory_order_relaxed);
+    }
+
+    ggml_barrier(params->threadpool);
+
+    const int64_t n_active = active[n_as];
+
+    // 2. gate, up, SWIGLU and down's quantization. The units are (expert, block of rows) in
+    // expert order, taken from a counter, so a thread that runs late hands its share to the others.
+    {
+        const int64_t blk = ggml_moe_ffn_block_rows(down);
+        const int64_t nc  = gate->ne[0];
+        const int64_t nb  = (nc + blk - 1)/blk;
+        const size_t  bsz = ggml_type_size(vdt_dn);
+        const int64_t bln = ggml_blck_size(vdt_dn);
+
+        for (int64_t u = ith; u < n_active*nb;
+                u = atomic_fetch_add_explicit((atomic_int *) next_unit[0], 1, memory_order_relaxed)) {
+            ggml_moe_ffn_run_unit(gate, active, nb, blk, u, counts, matrix_rows, wx, row_ug);
+            ggml_moe_ffn_run_unit(up,   active, nb, blk, u, counts, matrix_rows, wx, row_ug);
+
+            const int32_t cur_a = active[u / nb];
+            const int64_t r0    = (u % nb)*blk;
+            const int64_t r1    = MIN(r0 + blk, nc);
+
+            for (int64_t j = 0; j < counts[cur_a]; ++j) {
+                const struct mmid_row_mapping m = MMID_MATRIX_ROW(cur_a, j);
+                const float * g = (const float *) ((const char *) gate->data + m.i1*gate->nb[1] + m.i2*gate->nb[2]);
+                const float * v = (const float *) ((const char *) up->data   + m.i1*up->nb[1]   + m.i2*up->nb[2]);
+                float       * y = (float *)       ((char *)       glu->data  + m.i1*glu->nb[1]  + m.i2*glu->nb[2]);
+
+                ggml_vec_swiglu_f32((int) (r1 - r0), y + r0, g + r0, v + r0);
+                from_float_dn(y + r0, wg + (m.i1 + m.i2*glu->ne[1])*row_dn + (r0/bln)*bsz, r1 - r0);
+            }
+        }
+    }
+
+    ggml_barrier(params->threadpool);
+
+    // 3. down, in units of 64 rows of one expert, taken the same way
+    {
+        const int64_t blk = 64;
+        const int64_t nb  = (down->src[0]->ne[1] + blk - 1)/blk;
+
+        for (int64_t u = ith; u < n_active*nb;
+                u = atomic_fetch_add_explicit((atomic_int *) next_unit[1], 1, memory_order_relaxed)) {
+            ggml_moe_ffn_run_unit(down, active, nb, blk, u, counts, matrix_rows, wg, row_dn);
+        }
+    }
+}
+
 /////////////////////////////////
 
 static void ggml_compute_forward(struct ggml_compute_params * params, struct ggml_tensor * tensor) {
@@ -3338,6 +3512,11 @@ struct ggml_cplan ggml_graph_plan(
                         // Workspace for the sgemm path, plus its cache line alignment
                         cur += ggml_mmid_sgemm_wdata_size(n_tasks, node) + CACHE_LINE_SIZE;
 #endif
+                        // ggml_compute_forward_moe_ffn, which runs at the up node, holds both
+                        // converted inputs: reserve it at the down node
+                        if (src1->op == GGML_OP_GLU && src1->src[0] != NULL && src1->src[0]->op == GGML_OP_MUL_MAT_ID) {
+                            cur = MAX(cur, ggml_moe_ffn_wsize(src1->src[0], src1, node));
+                        }
                     } break;
                 case GGML_OP_OUT_PROD:
                     {
@@ -3574,6 +3753,70 @@ static int ggml_cpu_try_gdn_cache_fusion(
     return skip;
 }
 
+// Routed rows (n_expert_used * n_tokens) below which ggml_compute_forward_moe_ffn runs. Below it
+// the sgemm path of MUL_MAT_ID never runs (MMID_SGEMM_MIN_GATHERED), so the unfused ops take the
+// one_chunk path that the fused op takes.
+#define GGML_CPU_MOE_FFN_MAX_ROUTED 64
+
+struct ggml_cpu_moe_ffn_match {
+    struct ggml_tensor * up;
+    struct ggml_tensor * gate;
+    struct ggml_tensor * glu;
+    struct ggml_tensor * down;
+};
+
+// a MUL_MAT_ID that the unfused op computes with one_chunk over src1 converted to vec_dot_type
+static bool ggml_cpu_moe_ffn_mmid_ok(struct ggml_tensor * mm, const struct ggml_tensor * ids) {
+    if (mm->op != GGML_OP_MUL_MAT_ID || mm->src[2] != ids) {
+        return false;
+    }
+    const struct ggml_tensor * src0 = mm->src[0];
+    const enum ggml_type       vdt  = type_traits_cpu[src0->type].vec_dot_type;
+    return mm->type == GGML_TYPE_F32 && ggml_is_contiguous(mm) &&
+           mm->src[1]->type == GGML_TYPE_F32 && ggml_is_contiguous(mm->src[1]) &&
+           src0->nb[0] == ggml_type_size(src0->type) && src0->extra == NULL &&
+           vdt != GGML_TYPE_F32 && type_traits_cpu[vdt].from_float != NULL &&
+           ggml_tiled_wdata_size(1, mm) == 0 &&
+           ids->ne[0]*ids->ne[1] < GGML_CPU_MOE_FFN_MAX_ROUTED;
+}
+
+// up and gate MUL_MAT_ID (either order), SWIGLU(gate, up), down MUL_MAT_ID, as build_moe_ffn
+// emits them for a model with separate gate and up experts
+static bool ggml_cpu_match_moe_ffn(const struct ggml_cgraph * cgraph, int node_n, struct ggml_cpu_moe_ffn_match * m) {
+    if (node_n + 4 > cgraph->n_nodes) {
+        return false;
+    }
+    struct ggml_tensor * a    = cgraph->nodes[node_n];
+    struct ggml_tensor * b    = cgraph->nodes[node_n + 1];
+    struct ggml_tensor * glu  = cgraph->nodes[node_n + 2];
+    struct ggml_tensor * down = cgraph->nodes[node_n + 3];
+
+    if (glu->op != GGML_OP_GLU || ggml_get_glu_op(glu) != GGML_GLU_OP_SWIGLU || glu->src[1] == NULL ||
+            glu->type != GGML_TYPE_F32 || !ggml_is_contiguous(glu)) {
+        return false;
+    }
+    struct ggml_tensor * gate = glu->src[0];
+    struct ggml_tensor * up   = glu->src[1];
+    if (!((gate == a && up == b) || (gate == b && up == a))) {
+        return false;
+    }
+    const struct ggml_tensor * ids = gate->src[2];
+    if (!ggml_cpu_moe_ffn_mmid_ok(gate, ids) || !ggml_cpu_moe_ffn_mmid_ok(up, ids) || !ggml_cpu_moe_ffn_mmid_ok(down, ids) ||
+            up->src[1] != gate->src[1] || up->src[0]->type != gate->src[0]->type ||
+            !ggml_are_same_shape(up, gate) || !ggml_are_same_shape(glu, gate) || down->src[1] != glu) {
+        return false;
+    }
+    if (!ggml_node_has_n_uses(cgraph, node_n, 1) || !ggml_node_has_n_uses(cgraph, node_n + 1, 1) ||
+            !ggml_node_has_n_uses(cgraph, node_n + 2, 1)) {
+        return false;
+    }
+    m->up   = up;
+    m->gate = gate;
+    m->glu  = glu;
+    m->down = down;
+    return true;
+}
+
 struct ggml_cpu_moe_weighted_reduction_match {
     const struct ggml_tensor * experts;
     const struct ggml_tensor * expert_scale;
@@ -3761,6 +4004,14 @@ static int ggml_cpu_try_fuse_ops(
         }
     }
 
+    if (node->op == GGML_OP_MUL_MAT_ID) {
+        struct ggml_cpu_moe_ffn_match match;
+        if (ggml_cpu_match_moe_ffn(cgraph, node_n, &match)) {
+            ggml_compute_forward_moe_ffn(params, match.up, match.gate, match.glu, match.down);
+            return 3;
+        }
+    }
+
     if (node->op == GGML_OP_MUL) {
         struct ggml_cpu_moe_weighted_reduction_match match;
         if (ggml_cpu_match_moe_weighted_reduction(cgraph, node_n, cplan, &match)) {
