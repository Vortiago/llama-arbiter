     const ggml_tensor * shared_up = nullptr;
     const ggml_tensor * shared_gate = nullptr;
     ggml_tensor * shared_dst = nullptr;
+    // MUL_MAT nodes after this one with the same src1: one quantized src1, one launch for all
+    ggml_tensor * const * multi = nullptr;
+    int n_multi = 0;
 };
+
+#define GGML_CUDA_MMVQ_MULTI_MAX 4
+
 struct ggml_cuda_mm_fusion_args_device {
     const void * x_bias = nullptr;
     const void * gate = nullptr;
@@ -1606,6 +1612,11 @@ struct ggml_cuda_mm_fusion_args_device {
     const void * shared_gate = nullptr;
     float * shared_dst = nullptr;
     uint32_t shared_stride_col_dst = 0;
+    // matrices on one src1 in one launch: matrix k takes the CUDA blocks after those of matrices 0..k-1
+    int multi_n = 0;
+    const void * multi_x[GGML_CUDA_MMVQ_MULTI_MAX] = {};
+    float * multi_dst[GGML_CUDA_MMVQ_MULTI_MAX] = {};
+    uint32_t multi_nrows[GGML_CUDA_MMVQ_MULTI_MAX] = {};
 };
 
 struct ggml_cuda_kernel_launch_params {
diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index 5b79b3966..f7df7a697 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -1824,6 +1824,48 @@ static bool ggml_cuda_should_fuse_mul_mat_vec_q(const ggml_tensor * tensor) {
     return use_mul_mat_vec_q;
 }
 
+// A MUL_MAT that ggml_cuda_mul_mat runs as MMVQ on a weight matrix. Adjacent ones with the same src1
+// run as one launch on one quantized src1.
+static bool ggml_cuda_mul_mat_is_mmvq_on_weight(const ggml_tensor * node) {
+    if (node->op != GGML_OP_MUL_MAT) {
+        return false;
+    }
+    const ggml_tensor * src0 = node->src[0];
+    const ggml_tensor * src1 = node->src[1];
+    const int cc = ggml_cuda_info().devices[ggml_cuda_get_device()].cc;
+
+    return src0->op == GGML_OP_NONE && src0->buffer &&
+           ggml_backend_buffer_get_usage(src0->buffer) != GGML_BACKEND_BUFFER_USAGE_COMPUTE &&
+           ggml_is_quantized(src0->type) && src0->ne[2] == 1 && src0->ne[3] == 1 &&
+           src1->type == GGML_TYPE_F32 && src1->ne[2] == 1 && src1->ne[3] == 1 &&
+           node->type == GGML_TYPE_F32 && ggml_is_contiguous(node) &&
+           ggml_cuda_should_use_mmvq(src0->type, cc, src1->ne[1]);
+}
+
+// Whether the MUL_MAT at node_idx can run in one launch with the one before it.
+static bool ggml_cuda_mul_mat_joins_mmvq(const ggml_tensor * first, const ggml_tensor * node) {
+    return node->src[1] == first->src[1] && ggml_cuda_mul_mat_is_mmvq_on_weight(node) &&
+           node->src[0]->type == first->src[0]->type && node->src[0]->ne[0] == first->src[0]->ne[0] &&
+           node->src[0]->nb[1] == first->src[0]->nb[1];
+}
+
+// A single-column MUL_MAT whose result an op right after it reads: the evaluator may fuse the two
+// (bias, scale, GLU), so the grouping below leaves it in place.
+static bool ggml_cuda_mul_mat_may_fuse_next(const ggml_cgraph * cgraph, int node_idx) {
+    const ggml_tensor * node = cgraph->nodes[node_idx];
+    if (node->ne[1] != 1) {
+        return false;
+    }
+    for (int j = node_idx + 1; j < std::min(node_idx + 3, cgraph->n_nodes); ++j) {
+        for (int s = 0; s < GGML_MAX_SRC; ++s) {
+            if (cgraph->nodes[j]->src[s] == node) {
+                return true;
+            }
+        }
+    }
+    return false;
+}
+
 static bool ggml_cuda_match_shared_expert(const ggml_cgraph * graph, int routed_idx, int shared_idx) {
     if (routed_idx + 2 >= graph->n_nodes || shared_idx + 2 >= graph->n_nodes || shared_idx < routed_idx + 3) {
         return false;
@@ -4275,6 +4317,30 @@ static int ggml_cuda_try_fuse(ggml_backend_cuda_context * cuda_ctx, ggml_cgraph
         return 2;
     }
 
+    // adjacent MMVQ products of one src1: quantize it once and run them in one launch
+    if (ggml_cuda_mul_mat_is_mmvq_on_weight(node) && cuda_ctx->stream_context().concurrent_events.empty()) {
+        ggml_tensor * multi[GGML_CUDA_MMVQ_MULTI_MAX - 1];
+        int n_multi = 0;
+        while (n_multi < GGML_CUDA_MMVQ_MULTI_MAX - 1 && i + 1 + n_multi < cgraph->n_nodes) {
+            ggml_tensor * next = cgraph->nodes[i + 1 + n_multi];
+            if ((next->flags & GGML_TENSOR_FLAG_COMPUTE) == 0 || !ggml_cuda_mul_mat_joins_mmvq(node, next)) {
+                break;
+            }
+            multi[n_multi++] = next;
+        }
+        int outputs[GGML_CUDA_MMVQ_MULTI_MAX];
+        for (int k = 0; k <= n_multi; ++k) {
+            outputs[k] = i + k;
+        }
+        if (n_multi > 0 && ggml_cuda_check_fusion_memory_ranges(cgraph, i, n_multi + 1, outputs, n_multi + 1)) {
+            ggml_cuda_mm_fusion_args_host fusion{};
+            fusion.multi   = multi;
+            fusion.n_multi = n_multi;
+            ggml_cuda_mul_mat_vec_q(*cuda_ctx, node->src[0], node->src[1], nullptr, node, &fusion);
+            return n_multi;
+        }
+    }
+
     return 0;
 }
 
@@ -4639,6 +4705,47 @@ static void ggml_backend_cuda_graph_optimize(ggml_backend_t backend, ggml_cgraph
                 break;
             }
         }
+        // Move MMVQ products of one src1 next to the first of them, so the evaluator runs them in one launch.
+        // A moved product reads only a weight and that src1, so it can run as soon as the first one does.
+        {
+            std::unordered_map<const ggml_tensor *, std::vector<int>> by_src1;
+            for (int i = 0; i < cgraph->n_nodes; ++i) {
+                ggml_tensor * node = cgraph->nodes[i];
+                if (ggml_cuda_mul_mat_is_mmvq_on_weight(node) && !ggml_cuda_mul_mat_may_fuse_next(cgraph, i)) {
+                    std::vector<int> & group = by_src1[node->src[1]];
+                    if (group.empty() || ggml_cuda_mul_mat_joins_mmvq(cgraph->nodes[group[0]], node)) {
+                        group.push_back(i);
+                    }
+                }
+            }
+            std::vector<int>  next_in_group(cgraph->n_nodes, -1);
+            std::vector<bool> moved(cgraph->n_nodes, false);
+            bool              any = false;
+            for (const auto & [src1, group] : by_src1) {
+                for (size_t g = 0; g < group.size(); ++g) {
+                    if (g % GGML_CUDA_MMVQ_MULTI_MAX != 0) {
+                        next_in_group[group[g - 1]] = group[g];
+                        moved[group[g]]             = true;
+                        any                         = true;
+                    }
+                }
+            }
+            if (any) {
+                std::vector<ggml_tensor *> order;
+                order.reserve(cgraph->n_nodes);
+                for (int i = 0; i < cgraph->n_nodes; ++i) {
+                    if (moved[i]) {
+                        continue;
+                    }
+                    for (int j = i; j >= 0; j = next_in_group[j]) {
+                        order.push_back(cgraph->nodes[j]);
+                    }
+                }
+                GGML_ASSERT((int) order.size() == cgraph->n_nodes);
+                std::copy(order.begin(), order.end(), cgraph->nodes);
+            }
+        }
+
         for (int i = 0; i < cgraph->n_nodes; ++i) {
             ggml_cuda_moe_weighted_reduction_match match;
             if (ggml_cuda_match_moe_weighted_reduction(cgraph, i, match)) {
