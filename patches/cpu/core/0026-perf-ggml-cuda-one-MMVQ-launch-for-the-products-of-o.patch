+// MUL_MAT of several weight matrices on one src1, in adjacent graph nodes (a backend may run them as one)
+struct test_mul_mat_multi : public test_case {
+    const ggml_type type;
+    const int64_t k;
+    const int64_t n;
+    const std::vector<int64_t> rows;
+
+    test_mul_mat_multi(ggml_type type, int64_t k, int64_t n, std::vector<int64_t> rows)
+        : type(type), k(k), n(n), rows(std::move(rows)) {}
+
+    std::string vars() override { return VARS_TO_STR4(type, k, n, rows); }
+    std::string op_desc(ggml_tensor *) override { return "MUL_MAT_MULTI"; }
+    bool run_whole_graph() override { return true; }
+    double max_nmse_err() override { return 5e-4; }
+
+    uint64_t op_flops(ggml_tensor *) override {
+        int64_t m = 0;
+        for (int64_t r : rows) {
+            m += r;
+        }
+        return 2 * m * k * n;
+    }
+
+    ggml_tensor * build_graph(ggml_context * ctx) override {
