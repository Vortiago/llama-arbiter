diff --git a/ggml/src/ggml-backend-impl.h b/ggml/src/ggml-backend-impl.h
index dc7367dec..33921ac1e 100644
--- a/ggml/src/ggml-backend-impl.h
+++ b/ggml/src/ggml-backend-impl.h
@@ -154,6 +154,10 @@ extern "C" {
 
         // (optional) sort/optimize the nodes in the graph
         void                      (*graph_optimize)    (ggml_backend_t backend, struct ggml_cgraph * cgraph, struct ggml_backend_graph_optimize_params * params);
+
+        // (optional) queue a call of func(data) on the host: it runs after the work queued before it,
+        // and the work queued after it waits for it to return; func must not call this backend
+        void (*launch_host_func)(ggml_backend_t backend, void (*func)(void * data), void * data);
     };
 
     struct ggml_backend {
diff --git a/ggml/src/ggml-backend-meta.cpp b/ggml/src/ggml-backend-meta.cpp
index 0394433c0..706169daa 100644
--- a/ggml/src/ggml-backend-meta.cpp
+++ b/ggml/src/ggml-backend-meta.cpp
@@ -2494,6 +2494,7 @@ static const ggml_backend_i ggml_backend_meta_i = {
