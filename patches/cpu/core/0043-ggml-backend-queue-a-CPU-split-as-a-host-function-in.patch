diff --git a/tests/test-backend-sched-host.cpp b/tests/test-backend-sched-host.cpp
new file mode 100644
index 000000000..5a6d6c1c7
--- /dev/null
+++ b/tests/test-backend-sched-host.cpp
@@ -0,0 +1,133 @@
+// The scheduler's result when CPU splits alternate with the splits of a GPU backend.
+//
+// Each layer runs a matmul on the GPU, a matmul with a weight in host memory on the CPU, and
+// an add on the GPU. The plain run (no eval callback) may queue the CPU splits in the GPU
+// backend's stream; the reference run sets an eval callback, which makes the scheduler run
+// every split in order on the calling thread. Both must give the same bits.
+#include "ggml.h"
+#include "ggml-alloc.h"
+#include "ggml-backend.h"
+#include "ggml-cpu.h"
+
+#include <cmath>
+#include <cstdio>
+#include <cstring>
+#include <random>
+#include <vector>
+
+static bool ask_host_nodes(ggml_tensor * t, bool ask, void * data) {
+    (void) data;
+    const bool host = t->buffer == nullptr || ggml_backend_buffer_is_host(t->buffer);
+    return ask ? host : true;
+}
+
+int main() {
+    ggml_backend_load_all();
+    ggml_backend_t gpu = ggml_backend_init_by_type(GGML_BACKEND_DEVICE_TYPE_GPU, nullptr);
+    if (gpu == nullptr) {
+        printf("no GPU backend, skipped\n");
+        return 0;
+    }
+    ggml_backend_t cpu = ggml_backend_init_by_type(GGML_BACKEND_DEVICE_TYPE_CPU, nullptr);
+
+    const int n_layer = 24, n_embd = 256, n_tok = 4;
+
+    // weights: one GPU and one CPU matrix a layer
+    ggml_init_params wp = { ggml_tensor_overhead() * (2 * n_layer + 1), nullptr, true };
+    ggml_context * ctx_g = ggml_init(wp);
+    ggml_context * ctx_c = ggml_init(wp);
+    std::vector<ggml_tensor *> wg(n_layer), wc(n_layer);
+    for (int i = 0; i < n_layer; i++) {
+        wg[i] = ggml_new_tensor_2d(ctx_g, GGML_TYPE_F32, n_embd, n_embd);
+        wc[i] = ggml_new_tensor_2d(ctx_c, GGML_TYPE_F32, n_embd, n_embd);
+    }
+    ggml_backend_buffer_t buf_g = ggml_backend_alloc_ctx_tensors(ctx_g, gpu);
+    ggml_backend_buffer_t buf_c = ggml_backend_alloc_ctx_tensors(ctx_c, cpu);
+    ggml_backend_buffer_set_usage(buf_g, GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+    ggml_backend_buffer_set_usage(buf_c, GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+
+    std::mt19937 rng(42);
+    std::normal_distribution<float> nd(0.0f, 1.0f / std::sqrt((float) n_embd));
+    std::vector<float> w(n_embd * n_embd);
+    for (int i = 0; i < n_layer; i++) {
+        for (auto & v : w) v = nd(rng);
+        ggml_backend_tensor_set(wg[i], w.data(), 0, ggml_nbytes(wg[i]));
+        for (auto & v : w) v = nd(rng);
+        ggml_backend_tensor_set(wc[i], w.data(), 0, ggml_nbytes(wc[i]));
+    }
+
+    ggml_backend_t backends[2] = { gpu, cpu };
+    ggml_backend_sched_t sched = nullptr;
+
+    auto run = [&](bool callback, const std::vector<float> & x_in) {
+        ggml_init_params gp = { ggml_tensor_overhead() * 4096 + ggml_graph_overhead(), nullptr, true };
+        ggml_context * ctx = ggml_init(gp);
+        ggml_tensor * x = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, n_embd, n_tok);
+        ggml_set_input(x);
+        ggml_tensor * h = x;
+        std::vector<ggml_tensor *> on_gpu;
+        for (int i = 0; i < n_layer; i++) {
+            ggml_tensor * g = ggml_tanh(ctx, ggml_mul_mat(ctx, wg[i], h));
+            ggml_tensor * c = ggml_mul_mat(ctx, wc[i], g);
+            h = ggml_add(ctx, g, c);
+            on_gpu.push_back(g->src[0]);
+            on_gpu.push_back(g);
+            on_gpu.push_back(h);
+        }
+        ggml_set_output(h);
+        ggml_cgraph * gf = ggml_new_graph_custom(ctx, 4096, false);
+        ggml_build_forward_expand(gf, h);
+
+        ggml_backend_sched_reset(sched);
+        for (ggml_tensor * t : on_gpu) {
+            ggml_backend_sched_set_tensor_backend(sched, t, gpu);
+        }
+        ggml_backend_sched_set_eval_callback(sched, callback ? ask_host_nodes : nullptr, nullptr);
+        if (!ggml_backend_sched_alloc_graph(sched, gf)) {
+            printf("alloc failed\n");
+            exit(1);
+        }
+        ggml_backend_tensor_set(x, x_in.data(), 0, ggml_nbytes(x));
+        if (ggml_backend_sched_graph_compute(sched, gf) != GGML_STATUS_SUCCESS) {
+            printf("compute failed\n");
+            exit(1);
+        }
+        std::vector<float> out(n_embd * n_tok);
+        ggml_backend_tensor_get(h, out.data(), 0, ggml_nbytes(h));
+        const int n_splits = ggml_backend_sched_get_n_splits(sched);
+        ggml_free(ctx);
+        return std::make_pair(out, n_splits);
+    };
+
+    int fails = 0;
+    // the CPU splits' buffers in pageable memory, then in the GPU's pinned host memory
+    ggml_backend_buffer_type_t host_buft = ggml_backend_dev_host_buffer_type(ggml_backend_get_device(gpu));
+    ggml_backend_buffer_type_t bufts[2] = { ggml_backend_get_default_buffer_type(gpu), host_buft };
+    for (int it = 0; it < 8; it++) {
+        if (it % 4 == 0) {
+            ggml_backend_sched_free(sched);
+            if (it == 4 && host_buft == nullptr) {
+                break;
+            }
+            sched = ggml_backend_sched_new(backends, it == 0 ? nullptr : bufts, 2, 4096, false, true);
+        }
+        std::vector<float> x(n_embd * n_tok);
+        for (auto & v : x) v = nd(rng) * std::sqrt((float) n_embd);
+        auto [ref, splits_ref] = run(true, x);
+        auto [out, splits]     = run(false, x);
+        const bool same = memcmp(ref.data(), out.data(), ref.size() * sizeof(float)) == 0;
+        printf("%s host memory, iteration %d: %d splits, %s\n", it < 4 ? "pageable" : "pinned", it % 4, splits,
+               same ? "same bits" : "DIFFERENT");
+        fails += !same || splits < 2 * n_layer;
+    }
+
+    ggml_backend_sched_free(sched);
+    ggml_backend_buffer_free(buf_g);
+    ggml_backend_buffer_free(buf_c);
+    ggml_free(ctx_g);
+    ggml_free(ctx_c);
+    ggml_backend_free(gpu);
+    ggml_backend_free(cpu);
+    printf(fails ? "FAILED\n" : "OK\n");
+    return fails ? 1 : 0;
+}
