 };
 
 bool ggml_backend_is_meta(ggml_backend_t backend) {
diff --git a/ggml/src/ggml-backend.cpp b/ggml/src/ggml-backend.cpp
index f2885fb31..8be13c18f 100644
--- a/ggml/src/ggml-backend.cpp
+++ b/ggml/src/ggml-backend.cpp
@@ -20,6 +20,8 @@
 #include <stdlib.h>
 #include <string.h>
 #include <algorithm>
+#include <condition_variable>
+#include <mutex>
 #include <unordered_map>
 #include <vector>
 
@@ -921,8 +923,17 @@ struct ggml_backend_sched_split {
     int inputs_capacity;
     // graph view of this split
     struct ggml_cgraph graph;
+    // a split queued to run on the host from another backend's queue: its backend and its result
+    ggml_backend_t       host_backend;
+    enum ggml_status     host_status;
 };
 
+// runs a split queued with launch_host_func
+static void ggml_backend_sched_host_split(void * data) {
+    struct ggml_backend_sched_split * split = (struct ggml_backend_sched_split *) data;
+    split->host_status = ggml_backend_graph_compute_async(split->host_backend, &split->graph);
+}
+
 struct ggml_backend_sched {
     bool is_reset; // true if the scheduler has been reset since the last graph split
     bool is_alloc;
@@ -1801,6 +1812,34 @@ static bool ggml_backend_sched_alloc_splits(ggml_backend_sched_t sched) {
     return true;
 }
 
+// an input of a split that is a copy from the backend's pinned host memory to its own buffer, queued on
+// the backend: the copy reads the host memory when the backend runs it, not when it is queued
+static bool ggml_backend_sched_queued_host_copy(ggml_backend_t split_backend, const struct ggml_tensor * input, const struct ggml_tensor * input_cpy) {
+    return !(input->flags & GGML_TENSOR_FLAG_INPUT) && ggml_backend_buffer_is_host(input->buffer) &&
+        ggml_backend_buffer_get_usage(input->buffer) != GGML_BACKEND_BUFFER_USAGE_WEIGHTS &&
+        input->buffer->buft == ggml_backend_dev_host_buffer_type(ggml_backend_get_device(split_backend)) &&
+        split_backend->iface.set_tensor_async != NULL &&
+        input_cpy->buffer->buft == ggml_backend_get_default_buffer_type(split_backend);
+}
+
+// wait for a backend with queued host splits: asleep, so that the host splits keep every core
+static void ggml_backend_sched_wait_host_queue(ggml_backend_t backend) {
+    struct waiter {
+        std::mutex              mutex;
+        std::condition_variable cv;
+        bool                    done = false;
+    } w;
+    backend->iface.launch_host_func(backend, [](void * data) {
+        waiter * w = (waiter *) data;
+        std::lock_guard<std::mutex> lock(w->mutex);
+        w->done = true;
+        w->cv.notify_one();
+    }, &w);
+    std::unique_lock<std::mutex> lock(w.mutex);
+    w.cv.wait(lock, [&] { return w.done; });
+    ggml_backend_synchronize(backend);
+}
+
 static enum ggml_status ggml_backend_sched_compute_splits(ggml_backend_sched_t sched) {
     GGML_ASSERT(sched);
     struct ggml_backend_sched_split * splits = sched->splits;
@@ -1814,11 +1853,67 @@ static enum ggml_status ggml_backend_sched_compute_splits(ggml_backend_sched_t s
     // backends that read host memory in a queued copy during this call
     bool reads_host[GGML_SCHED_MAX_BACKENDS] = { false };
 
+    // A host split that only reads the outputs of the split before it, from a backend that can queue
+    // a host function, is queued there behind the copies of its inputs; the split after it then reads
+    // its outputs in copies queued behind it. The calling thread does not wait for the backend between
+    // the splits, and so queues the next splits while the host computes.
+    // host_queue is the backend with queued host splits that the calling thread has not waited for.
+    int host_queue = -1;
+    bool host_splits = false;
+
+    auto queue_on_host = [&](int split_id) -> int {
+        struct ggml_backend_sched_split * split = &splits[split_id];
+        if (sched->callback_eval || split_id == 0 || split->n_inputs == 0 ||
+            ggml_backend_dev_type(ggml_backend_get_device(sched->backends[split->backend_id])) != GGML_BACKEND_DEVICE_TYPE_CPU) {
+            return -1;
+        }
+        const int q = splits[split_id - 1].backend_id;
+        ggml_backend_t qb = sched->backends[q];
+        if (q == split->backend_id || (host_queue >= 0 && host_queue != q) ||
+            qb->iface.launch_host_func == NULL || qb->iface.get_tensor_async == NULL) {
+            return -1;
+        }
+        // every input is a queued copy from the queue's own buffer to host memory
+        for (int input_id = 0; input_id < split->n_inputs; input_id++) {
+            struct ggml_tensor * input = split->inputs[input_id];
+            struct ggml_tensor * input_cpy = tensor_copy(input, split->backend_id, sched->cur_copy);
+            if ((input->flags & GGML_TENSOR_FLAG_INPUT) || ggml_backend_sched_get_tensor_backend(sched, input) != qb ||
+                ggml_backend_buffer_is_host(input->buffer) || !ggml_backend_buffer_is_host(input_cpy->buffer) ||
+                input->buffer->buft != ggml_backend_get_default_buffer_type(qb)) {
+                return -1;
+            }
+        }
+        return q;
+    };
+
+    // a split on the queue whose inputs from host memory are all queued copies needs no wait
+    auto reads_after_host = [&](int split_id) -> bool {
+        struct ggml_backend_sched_split * split = &splits[split_id];
+        if (split->backend_id != host_queue || split->n_inputs == 0) {
+            return false;
+        }
+        for (int input_id = 0; input_id < split->n_inputs; input_id++) {
+            struct ggml_tensor * input = split->inputs[input_id];
+            if (!ggml_backend_sched_queued_host_copy(sched->backends[host_queue], input,
+                    tensor_copy(input, split->backend_id, sched->cur_copy))) {
+                return false;
+            }
+        }
+        return true;
+    };
+
     for (int split_id = 0; split_id < sched->n_splits; split_id++) {
         struct ggml_backend_sched_split * split = &splits[split_id];
         int split_backend_id = split->backend_id;
         ggml_backend_t split_backend = sched->backends[split_backend_id];
 
+        const int queue_id = queue_on_host(split_id);
+        if (host_queue >= 0 && queue_id < 0 && !reads_after_host(split_id)) {
+            ggml_backend_sched_wait_host_queue(sched->backends[host_queue]);
+            host_queue = -1;
+        }
+        split->host_backend = NULL;
+
         // ensure the previous split's async work has completed before we start
         // this split, the allocator may have reused buffer regions across splits
         if (split->n_inputs == 0 && prev_backend_id >= 0 && prev_backend_id != split_backend_id) {
@@ -1847,10 +1942,11 @@ static enum ggml_status ggml_backend_sched_compute_splits(ggml_backend_sched_t s
                 }
                 ggml_backend_tensor_copy(input, input_cpy);
             } else {
-                // wait for the split backend to finish using the input before overwriting it
+                // wait for the split backend to finish using the input before overwriting it;
+                // a copy queued on the split backend runs after that use without a wait
                 if (sched->events[split_backend_id][sched->cur_copy] != NULL) {
                     ggml_backend_event_wait(split_backend, sched->events[split_backend_id][sched->cur_copy]);
-                } else {
+                } else if (!ggml_backend_sched_queued_host_copy(split_backend, input, input_cpy)) {
                     ggml_backend_synchronize(split_backend);
                 }
 
@@ -1976,15 +2072,26 @@ static enum ggml_status ggml_backend_sched_compute_splits(ggml_backend_sched_t s
             }
         }
 
-        for (int b = 0; b < sched->n_backends; b++) {
+        for (int b = 0; b < sched->n_backends && queue_id < 0; b++) {
             if (writes_host[b]) {
                 ggml_backend_synchronize(sched->backends[b]);
             }
         }
 
-        if (!sched->callback_eval) {
+        if (queue_id >= 0) {
+            // the input copies above are queued on queue_id: the split runs behind them
+            ggml_backend_t qb = sched->backends[queue_id];
+            split->host_backend = split_backend;
+            split->host_status  = GGML_STATUS_SUCCESS;
+            qb->iface.launch_host_func(qb, ggml_backend_sched_host_split, split);
+            host_queue  = queue_id;
+            host_splits = true;
+        } else if (!sched->callback_eval) {
             enum ggml_status ec = ggml_backend_graph_compute_async(split_backend, &split->graph);
             if (ec != GGML_STATUS_SUCCESS) {
+                if (host_queue >= 0) {
+                    ggml_backend_sched_wait_host_queue(sched->backends[host_queue]);
+                }
                 return ec;
             }
         } else {
@@ -2029,6 +2136,17 @@ static enum ggml_status ggml_backend_sched_compute_splits(ggml_backend_sched_t s
         prev_backend_id = split_backend_id;
     }
 
+    if (host_queue >= 0) {
+        ggml_backend_sched_wait_host_queue(sched->backends[host_queue]);
+    }
+    if (host_splits) {
+        for (int split_id = 0; split_id < sched->n_splits; split_id++) {
+            if (splits[split_id].host_backend != NULL && splits[split_id].host_status != GGML_STATUS_SUCCESS) {
+                return splits[split_id].host_status;
+            }
+        }
+    }
+
     // the caller may write host memory as soon as this returns: wait for the queued reads of it
     for (int b = 0; b < sched->n_backends; b++) {
         if (!reads_host[b]) {
