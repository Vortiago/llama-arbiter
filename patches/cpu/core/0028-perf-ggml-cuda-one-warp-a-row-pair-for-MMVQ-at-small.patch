 // Grid: (ceil(nrows_x / c_rows_per_block), nchannels_dst)
 // Block: (warp_size, ncols_dst) - each warp handles one token independently.
@@ -1197,6 +1281,33 @@ static void mul_mat_vec_q_switch_ncols_dst(
         return idle * 8 <= iters_wide * 2;
     };
 
+    const bool has_fusion = fusion.gate != nullptr || fusion.x_bias != nullptr || fusion.gate_bias != nullptr ||
+                            fusion.x_scale != nullptr || fusion.gate_scale != nullptr || fusion.shared_up != nullptr ||
+                            fusion.multi_n > 0;
+    if (!has_ids && !has_fusion && nchannels_dst == 1 && nsamples_dst == 1 &&
+            blocks_per_row_x <= calc_nwarps(type, ncols_dst, table_id) * blocks_per_iter_1warp) {
+        const int64_t nwarps_total = (nrows_x + MMVQ_WARP_ROWS_ROWS - 1) / MMVQ_WARP_ROWS_ROWS;
+        const dim3 block_nums((nwarps_total + MMVQ_WARP_ROWS_NWARPS - 1) / MMVQ_WARP_ROWS_NWARPS, 1, 1);
+        const dim3 block_dims(warp_size, MMVQ_WARP_ROWS_NWARPS, 1);
+        const ggml_cuda_kernel_launch_params launch_params = ggml_cuda_kernel_launch_params(block_nums, block_dims, 0, stream);
+        const auto launch = [&](auto kernel) {
+            ggml_cuda_kernel_launch(kernel, launch_params, vx, vy, dst, (uint32_t) ncols_x, (uint32_t) nrows_x,
+                (uint32_t) stride_row_x, (uint32_t) stride_col_y, (uint32_t) stride_col_dst);
+        };
+        switch (ncols_dst) {
+            case 1: launch(mul_mat_vec_q_warp_rows<type, 1>); break;
+            case 2: launch(mul_mat_vec_q_warp_rows<type, 2>); break;
+            case 3: launch(mul_mat_vec_q_warp_rows<type, 3>); break;
+            case 4: launch(mul_mat_vec_q_warp_rows<type, 4>); break;
+            case 5: launch(mul_mat_vec_q_warp_rows<type, 5>); break;
+            case 6: launch(mul_mat_vec_q_warp_rows<type, 6>); break;
+            case 7: launch(mul_mat_vec_q_warp_rows<type, 7>); break;
+            case 8: launch(mul_mat_vec_q_warp_rows<type, 8>); break;
+            default: GGML_ABORT("fatal error");
+        }
+        return;
+    }
+
