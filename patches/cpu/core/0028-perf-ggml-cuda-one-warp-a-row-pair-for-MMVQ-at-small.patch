From e51bcc9fe1cb14744bb73c6acbaeeea56028a5ac Mon Sep 17 00:00:00 2001
From: Vortiago <atle@havso.net>
Date: Wed, 7 Oct 2026 19:20:17 +0200
Subject: [PATCH] perf(ggml-cuda): one warp a row pair for MMVQ at small K

The hyper-connection up weight [320, 10240] at 4 tokens took about 24 us a
call, 145 GB/s: with K = 320 (10 Q8_0 blocks) a 4-warp MMVQ block has
work for 40 of its 128 threads, two of its warps only add zeros, and each
block of 2 rows ends in a block-wide sum.

When each thread of the block-wide kernel makes at most one trip of its
K loop, a new kernel gives each warp its own 2 rows: lane x adds the
products that lanes x of the reference kernel's warps would hold, in the
same order, then sums over the lanes the same way. No shared memory and
no block barrier; the results are bit-identical.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01C6MCJC4HTKxvuGjKjqDuqQ
---
 ggml/src/ggml-cuda/mmvq.cu | 111 +++++++++++++++++++++++++++++++++++++
 tests/test-backend-ops.cpp |  11 ++++
 2 files changed, 122 insertions(+)

diff --git a/ggml/src/ggml-cuda/mmvq.cu b/ggml/src/ggml-cuda/mmvq.cu
index ae8b333ad..c8c9ecbd7 100644
--- a/ggml/src/ggml-cuda/mmvq.cu
+++ b/ggml/src/ggml-cuda/mmvq.cu
@@ -865,6 +865,90 @@ static __global__ void mul_mat_vec_q(
     }
 }
 
+// MMVQ for a K so small that each thread of mul_mat_vec_q makes at most one trip of its K loop.
+// There most of the block-wide kernel's warps idle and its blocks end in a block-wide sum. Here one
+// warp does all of a block's K work for its own rows: lane x adds the products the lanes x of the
+// reference kernel's warps 0, 1, ... would hold, in their order, and then sums over the lanes the
+// same way. The results are bit-identical to mul_mat_vec_q.
+#define MMVQ_WARP_ROWS_NWARPS 4
+#define MMVQ_WARP_ROWS_ROWS   2
+
+template <ggml_type type, int ncols_dst>
+__launch_bounds__(MMVQ_WARP_ROWS_NWARPS*ggml_cuda_get_physical_warp_size(), 1)
+static __global__ void mul_mat_vec_q_warp_rows(
+        const void * __restrict__ vx, const void * __restrict__ vy, float * __restrict__ dst,
+        const uint32_t ncols_x, const uint32_t nrows_x, const uint32_t stride_row_x, const uint32_t stride_col_y,
+        const uint32_t stride_col_dst) {
+    constexpr int qk  = ggml_cuda_type_traits<type>::qk;
+    constexpr int qi  = ggml_cuda_type_traits<type>::qi;
+    constexpr int vdr = get_vdr_mmvq(type);
+    constexpr mmvq_parameter_table_id table_id = get_device_table_id();
+    constexpr int nwarps_ref = calc_nwarps(type, ncols_dst, table_id);
+    constexpr int warp_size = ggml_cuda_get_physical_warp_size();
+    constexpr int blocks_per_iter = vdr * nwarps_ref*warp_size / qi;
+    constexpr int nrows = MMVQ_WARP_ROWS_ROWS;
+
+    constexpr vec_dot_q_cuda_t vec_dot_q_cuda = get_vec_dot_q_cuda(type);
+
+    const int row0 = nrows*(blockIdx.x*blockDim.y + threadIdx.y);
+    if (row0 >= (int) nrows_x) {
+        return;
+    }
+    const int blocks_per_row_x = ncols_x / qk;
+    const block_q8_1 * y = (const block_q8_1 *) vy;
+
+    // a row past the end reads the last row and is not written
+    int kbx_row[nrows];
+#pragma unroll
+    for (int i = 0; i < nrows; ++i) {
+        kbx_row[i] = min(row0 + i, (int) nrows_x - 1)*stride_row_x;
+    }
+
+    ggml_cuda_pdl_sync();
+
+    // at most one trip of the reference K loop, so the trips of all reference warps are straight-line
+    // code and their loads can be in flight together
+    static_assert(blocks_per_iter > 0, "");
+    float tmp[ncols_dst][nrows];
+#pragma unroll
+    for (int w = 0; w < nwarps_ref; ++w) {
+        float part[ncols_dst][nrows] = {{0.0f}};
+        const int tid = w*warp_size + threadIdx.x;
+        const int kbx = tid / (qi/vdr);
+        if (kbx < blocks_per_row_x) {
+            const int kby = kbx * (qk/QK8_1);
+            const int kqs = vdr * (tid % (qi/vdr));
+#pragma unroll
+            for (int j = 0; j < ncols_dst; ++j) {
+#pragma unroll
+                for (int i = 0; i < nrows; ++i) {
+                    part[j][i] += vec_dot_q_cuda(vx, &y[j*stride_col_y + kby], kbx_row[i] + kbx, kqs);
+                }
+            }
+        }
+#pragma unroll
+        for (int j = 0; j < ncols_dst; ++j) {
+#pragma unroll
+            for (int i = 0; i < nrows; ++i) {
+                tmp[j][i] = w == 0 ? part[j][i] : tmp[j][i] + part[j][i];
+            }
+        }
+    }
+
+    ggml_cuda_pdl_lc();
+
+#pragma unroll
+    for (int j = 0; j < ncols_dst; ++j) {
+#pragma unroll
+        for (int i = 0; i < nrows; ++i) {
+            const float sum = warp_reduce_sum<warp_size>(tmp[j][i]);
+            if (threadIdx.x == i && row0 + i < (int) nrows_x) {
+                dst[j*stride_col_dst + row0 + i] = sum;
+            }
+        }
+    }
+}
+
