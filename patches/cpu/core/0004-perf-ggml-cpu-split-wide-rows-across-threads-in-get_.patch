@@ -9965,6 +9969,10 @@ static std::vector<std::unique_ptr<test_case>> make_test_cases_eval() {
     test_cases.emplace_back(new test_cpy(GGML_TYPE_F16, GGML_TYPE_F16, {128, 2, 3, 1}, {128, 2, 3, 1}, {0, 0, 0, 0}, {0, 0, 0, 0}, false, {128, 4, 3, 1})); // strided dst
     test_cases.emplace_back(new test_cpy(GGML_TYPE_F32, GGML_TYPE_F32, {64, 16, 1, 1}, {1, 64, 16, 1}, {1, 2, 0, 3}, {0, 0, 0, 0}, false, {32, 64, 16, 1})); // permuted src, strided dst
     test_cases.emplace_back(new test_cpy(GGML_TYPE_F16, GGML_TYPE_F16, {64, 16, 1, 1}, {1, 64, 16, 1}, {1, 2, 0, 3}, {0, 0, 0, 0}, false, {32, 64, 16, 1})); // permuted src, strided dst
+    // few wide rows, such as recurrent state snapshots, split by bytes on the CPU
+    test_cases.emplace_back(new test_cpy(GGML_TYPE_F32,  GGML_TYPE_F32,  {786432, 1, 2, 1}, {786432, 1, 2, 1}, {0, 0, 0, 0}, {0, 0, 0, 0}, false, {786432, 2, 2, 1})); // strided dst
+    test_cases.emplace_back(new test_cpy(GGML_TYPE_F16,  GGML_TYPE_F16,  { 65541, 1, 2, 1}, { 65541, 1, 2, 1}, {0, 0, 0, 0}, {0, 0, 0, 0}, false, { 65541, 2, 2, 1})); // strided dst
+    test_cases.emplace_back(new test_cpy(GGML_TYPE_Q8_0, GGML_TYPE_Q8_0, { 65536, 1, 3, 1}, { 65536, 1, 3, 1}, {0, 0, 0, 0}, {0, 0, 0, 0}, false, { 65536, 2, 3, 1})); // strided dst
 
     // CPY - different src/dst shapes (reshaping via CPY)
     // Use permutations of {3, 5, 7, 32}. Total elements: 3*5*7*32 = 3360.
