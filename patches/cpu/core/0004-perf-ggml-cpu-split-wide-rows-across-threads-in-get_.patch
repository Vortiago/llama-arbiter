diff --git a/ggml/src/ggml-cpu/ggml-cpu.c b/ggml/src/ggml-cpu/ggml-cpu.c
index c4d6c5837..ef6c42640 100644
--- a/ggml/src/ggml-cpu/ggml-cpu.c
+++ b/ggml/src/ggml-cpu/ggml-cpu.c
@@ -2699,6 +2699,13 @@ static int ggml_get_n_tasks(struct ggml_tensor * node, int n_threads) {
                 // decreases performance with GPU offloading
                 //n_tasks = n_threads;
                 n_tasks = 1;
+                // a graph of single-task nodes runs on one thread, so a few F32 or I32 rows wider than any
+                // token embedding, such as a recurrent state, ask for all threads to split the rows by columns
+                if (node->op == GGML_OP_GET_ROWS &&
+                    (node->src[0]->type == GGML_TYPE_F32 || node->src[0]->type == GGML_TYPE_I32) &&
+                    node->ne[0] >= 65536 && ggml_nrows(node) < n_threads) {
+                    n_tasks = n_threads;
+                }
             } break;
         case GGML_OP_SCALE:
         case GGML_OP_SET:
diff --git a/ggml/src/ggml-cpu/ops.cpp b/ggml/src/ggml-cpu/ops.cpp
index 16a916d20..96aca2e89 100644
--- a/ggml/src/ggml-cpu/ops.cpp
+++ b/ggml/src/ggml-cpu/ops.cpp
@@ -322,6 +322,51 @@ static void ggml_compute_forward_dup_to_q(
     }
 }
 
+// Copies rows of the same shape and type whose elements are contiguous, with any row strides.
+static void ggml_compute_forward_dup_bytes_rows(
+        const ggml_compute_params * params,
+        ggml_tensor * dst) {
+    const ggml_tensor * src0 = dst->src[0];
+
+    GGML_TENSOR_UNARY_OP_LOCALS;
+
+    const int ith = params->ith; // thread index
+    const int nth = params->nth; // number of threads
+
+    const size_t  rs = ggml_row_size(src0->type, ne00);
+    const int64_t nr = ne01*ne02*ne03;
+
+    int64_t ir0 = 0;
+    int64_t ir1 = nr;
+    size_t  ib0 = 0;
+    size_t  ib1 = rs;
+
+    if (!params->use_ref && nr < nth) {
+        // few rows: each thread copies one cache-line-sized range of every row
+        const size_t db = CACHE_LINE_SIZE*((rs + CACHE_LINE_SIZE*nth - 1)/(CACHE_LINE_SIZE*nth));
+
+        ib0 = MIN(db*ith, rs);
+        ib1 = MIN(ib0 + db, rs);
+    } else {
+        // rows per thread
+        const int64_t dr = (nr + nth - 1)/nth;
+
+        ir0 = dr*ith;
+        ir1 = MIN(ir0 + dr, nr);
+    }
+
+    for (int64_t ir = ir0; ir < ir1 && ib0 < ib1; ++ir) {
+        const int64_t i03 = ir/(ne01*ne02);
+        const int64_t i02 = (ir - i03*ne01*ne02)/ne01;
+        const int64_t i01 = ir - i03*ne01*ne02 - i02*ne01;
+
+        memcpy(
+            ((char *)  dst->data + i01*nb1  + i02*nb2  + i03*nb3  + ib0),
+            ((char *) src0->data + i01*nb01 + i02*nb02 + i03*nb03 + ib0),
+            ib1 - ib0);
+    }
+}
+
 // A simplified version of ggml_compute_forward_dup that doesn't do float upcasting, and just plain old memcpy.
 static void ggml_compute_forward_dup_bytes(
         const ggml_compute_params * params,
@@ -340,6 +385,11 @@ static void ggml_compute_forward_dup_bytes(
 
     const size_t type_size = ggml_type_size(src0->type);
 
+    if (ggml_are_same_shape(src0, dst) && nb00 == type_size && nb0 == type_size) {
+        ggml_compute_forward_dup_bytes_rows(params, dst);
+        return;
+    }
+
     const int ith = params->ith; // thread index
     const int nth = params->nth; // number of threads
 
@@ -351,24 +401,6 @@ static void ggml_compute_forward_dup_bytes(
     const int ir0 = dr * ith;
     const int ir1 = MIN(ir0 + dr, nr);
 
-    if (src0->type == dst->type &&
-        ggml_are_same_shape(src0, dst) &&
-        nb00 == type_size && nb0 == type_size) {
-        // copy by rows
-        const size_t rs = ggml_row_size(src0->type, ne00);
-        for (int64_t i03 = 0; i03 < ne03; i03++) {
-            for (int64_t i02 = 0; i02 < ne02; i02++) {
-                for (int64_t i01 = ir0; i01 < ir1; i01++) {
-                    memcpy(
-                        ((char *)  dst->data + i01*nb1  + i02*nb2  + i03*nb3),
-                        ((char *) src0->data + i01*nb01 + i02*nb02 + i03*nb03),
-                        rs);
-                }
-            }
-        }
-        return;
-    }
-
     if (ggml_is_contiguous(dst)) {
         size_t id = 0;
         char * dst_ptr = (char *) dst->data;
@@ -5327,6 +5359,10 @@ static void ggml_compute_forward_get_rows_bf16(
     }
 }
 
+// At this row width, in elements, get_rows_f32 splits fewer rows than threads by columns.
+// In a model graph every node already has all threads, so the split is free.
+static const int64_t GGML_GET_ROWS_SPLIT_MIN_COLS = 4096;
+
 static void ggml_compute_forward_get_rows_f32(
         const ggml_compute_params * params,
               ggml_tensor * dst) {
@@ -5347,14 +5383,27 @@ static void ggml_compute_forward_get_rows_f32(
     const int ith = params->ith;
     const int nth = params->nth;
 
-    // rows per thread
-    const int dr = (nr + nth - 1)/nth;
+    int64_t ir0 = 0;
+    int64_t ir1 = nr;
+    int64_t ic0 = 0;
+    int64_t ic1 = nc;
 
-    // row range for this thread
-    const int ir0 = dr*ith;
-    const int ir1 = MIN(ir0 + dr, nr);
+    if (!params->use_ref && nr < nth && nc >= GGML_GET_ROWS_SPLIT_MIN_COLS) {
+        // few wide rows: each thread copies one cache-line-sized range of every row
+        const int64_t cl = CACHE_LINE_SIZE_F32;
+        const int64_t dc = cl*((nc + cl*nth - 1)/(cl*nth));
 
-    for (int64_t i = ir0; i < ir1; ++i) {
+        ic0 = MIN(dc*ith, nc);
+        ic1 = MIN(ic0 + dc, nc);
+    } else {
+        // rows per thread
+        const int64_t dr = (nr + nth - 1)/nth;
+
+        ir0 = dr*ith;
+        ir1 = MIN(ir0 + dr, nr);
+    }
+
+    for (int64_t i = ir0; i < ir1 && ic0 < ic1; ++i) {
         const int64_t i12 = i/(ne11*ne10);
         const int64_t i11 = (i - i12*ne11*ne10)/ne10;
         const int64_t i10 = (i - i12*ne11*ne10 - i11*ne10);
@@ -5362,9 +5411,9 @@ static void ggml_compute_forward_get_rows_f32(
 
         GGML_ASSERT(i01 >= 0 && i01 < ne01);
 
-        ggml_vec_cpy_f32(nc,
-                (float *) ((char *)  dst->data + i10*nb1  + i11*nb2  + i12*nb3),
-                (float *) ((char *) src0->data + i01*nb01 + i11*nb02 + i12*nb03));
+        ggml_vec_cpy_f32(ic1 - ic0,
+                (float *) ((char *)  dst->data + i10*nb1  + i11*nb2  + i12*nb3) + ic0,
+                (float *) ((char *) src0->data + i01*nb01 + i11*nb02 + i12*nb03) + ic0);
     }
 }
 
