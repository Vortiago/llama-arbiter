diff --git a/src/llama-moe-split.cpp b/src/llama-moe-split.cpp
new file mode 100644
index 000000000..d9d9938bf
--- /dev/null
+++ b/src/llama-moe-split.cpp
@@ -0,0 +1,355 @@
+#include "llama-moe-split.h"
+
+#include "llama-impl.h"
+
+#include "ggml-alloc.h"
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <cstdlib>
+#include <cstring>
+#include <mutex>
+#include <thread>
+
+// One split runs at a time: begin and end of a layer bracket it, and the layers of a graph run
+// in order. The card's share runs on its own backend instance and stream, from a helper thread,
+// so that its uploads overlap the CPU's share.
+
+using clk = std::chrono::steady_clock;
+
+static int env_int(const char * name, int def) {
+    const char * s = getenv(name);
+    return s ? atoi(s) : def;
+}
+
+int llama_moe_split_min_tokens() {
+    static const int v = env_int("LLAMA_MOE_SPLIT", 0);
+    return v;
+}
+
+namespace {
+
+struct split_state {
+    int  max_experts = env_int("LLAMA_MOE_SPLIT_MAX", 64);
+    bool debug       = env_int("LLAMA_MOE_SPLIT_DEBUG", 0) != 0;
+
+    bool init_done = false;
+    bool failed    = false;
+
+    ggml_backend_t gpu = nullptr;
+
+    // the uploaded experts: up, gate, down, max_experts each
+    ggml_context *        wctx = nullptr;
+    ggml_backend_buffer_t wbuf = nullptr;
+    ggml_tensor *         w[3] = {};
+
+    // the card's graph, for one shape at a time
+    ggml_context * gctx   = nullptr;
+    ggml_cgraph *  gf     = nullptr;
+    ggml_gallocr_t galloc = nullptr;
+    int64_t g_embd = -1, g_tokens = -1;
+    int     g_used = -1;
+    ggml_tensor * gx = nullptr, * gids = nullptr, * gw = nullptr, * gout = nullptr;
+
+    // the job of the current layer
+    std::atomic<bool> busy{false};
+    std::atomic<int>  done{1};
+    bool active = false;
+    const ggml_tensor * src[3] = {};
+    const float * x = nullptr;
+    int64_t n_embd = 0, n_tokens = 0;
+    int     n_used = 0;
+    std::vector<int32_t> heavy, ids_gpu;
+    std::vector<float>   w_gpu, out;
+    double t_upload = 0, t_total = 0;
+    clk::time_point t_begin;
+
+    std::thread             th;
+    std::mutex              mu;
+    std::condition_variable cv;
+    bool have_job = false;
+};
+
+split_state & state() {
+    static split_state * st = new split_state(); // never freed: the helper thread outlives main
+    return *st;
+}
+
+bool init(split_state & st, const llama_moe_split_exps & exps) {
+    ggml_backend_dev_t dev = ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_GPU);
+    if (dev == nullptr) {
+        return false;
+    }
+    st.gpu = ggml_backend_dev_init(dev, nullptr);
+    if (st.gpu == nullptr) {
+        return false;
+    }
+
+    ggml_init_params ip = { 4*ggml_tensor_overhead(), nullptr, true };
+    st.wctx = ggml_init(ip);
+    const ggml_tensor * src[3] = { exps.up, exps.gate, exps.down };
+    for (int i = 0; i < 3; i++) {
+        st.w[i] = ggml_new_tensor_3d(st.wctx, src[i]->type, src[i]->ne[0], src[i]->ne[1], st.max_experts);
+    }
+    st.wbuf = ggml_backend_alloc_ctx_tensors(st.wctx, st.gpu);
+    if (st.wbuf == nullptr) {
+        return false;
+    }
+    // MMQ may read past the last expert: keep the padding finite
+    ggml_backend_buffer_clear(st.wbuf, 0);
+    st.galloc = ggml_gallocr_new(ggml_backend_get_default_buffer_type(st.gpu));
+
+    LLAMA_LOG_INFO("%s: experts with >= %d tokens of a ubatch run on %s, at most %d a layer (%.0f MiB)\n", __func__,
+        llama_moe_split_min_tokens(), ggml_backend_dev_name(dev), st.max_experts, ggml_backend_buffer_get_size(st.wbuf)/1048576.0);
+    return true;
+}
+
+// the card's share: up, gate, SWIGLU and down of the uploaded experts, weighted and summed per token
+bool build_graph(split_state & st) {
+    if (st.gctx && st.g_embd == st.n_embd && st.g_tokens == st.n_tokens && st.g_used == st.n_used) {
+        return true;
+    }
+    if (st.gctx) {
+        ggml_free(st.gctx);
+    }
+    ggml_init_params ip = { 64*ggml_tensor_overhead() + ggml_graph_overhead(), nullptr, true };
+    st.gctx = ggml_init(ip);
+    ggml_context * ctx = st.gctx;
+
+    st.gx   = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, st.n_embd, 1, st.n_tokens);
+    st.gids = ggml_new_tensor_2d(ctx, GGML_TYPE_I32, st.n_used, st.n_tokens);
+    st.gw   = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, 1, st.n_used, st.n_tokens);
+    ggml_set_input(st.gx);
+    ggml_set_input(st.gids);
+    ggml_set_input(st.gw);
+
+    ggml_tensor * up   = ggml_mul_mat_id(ctx, st.w[0], st.gx, st.gids);
+    ggml_tensor * gate = ggml_mul_mat_id(ctx, st.w[1], st.gx, st.gids);
+    ggml_tensor * act  = ggml_swiglu_split(ctx, gate, up);
+    ggml_tensor * down = ggml_mul_mat_id(ctx, st.w[2], act, st.gids);
+    ggml_tensor * wd   = ggml_mul(ctx, down, st.gw);
+
+    ggml_tensor * out = ggml_view_2d(ctx, wd, st.n_embd, st.n_tokens, wd->nb[2], 0);
+    for (int k = 1; k < st.n_used; k++) {
+        out = ggml_add(ctx, out, ggml_view_2d(ctx, wd, st.n_embd, st.n_tokens, wd->nb[2], k*wd->nb[1]));
+    }
+    if (st.n_used == 1) {
+        out = ggml_cont(ctx, out);
+    }
+    ggml_set_output(out);
+    st.gout = out;
+
+    st.gf = ggml_new_graph(ctx);
+    ggml_build_forward_expand(st.gf, out);
+    if (!ggml_gallocr_alloc_graph(st.galloc, st.gf)) {
+        return false;
+    }
+    st.g_embd = st.n_embd; st.g_tokens = st.n_tokens; st.g_used = st.n_used;
+    return true;
+}
+
+void run_job(split_state & st) {
+    const auto t0 = clk::now();
+    if (!build_graph(st)) {
+        GGML_ABORT("%s: the card's graph does not fit", __func__);
+    }
+
+    // runs of consecutive experts go in one copy each
+    const size_t n = st.heavy.size();
+    for (int i = 0; i < 3; i++) {
+        const size_t esz = st.src[i]->nb[2];
+        size_t a = 0;
+        while (a < n) {
+            size_t b = a + 1;
+            while (b < n && st.heavy[b] == st.heavy[b - 1] + 1) {
+                b++;
+            }
+            ggml_backend_tensor_set_async(st.gpu, st.w[i], (const char *) st.src[i]->data + st.heavy[a]*esz, a*esz, (b - a)*esz);
+            a = b;
+        }
+    }
+    ggml_backend_tensor_set_async(st.gpu, st.gx,   st.x,             0, ggml_nbytes(st.gx));
+    ggml_backend_tensor_set_async(st.gpu, st.gids, st.ids_gpu.data(), 0, ggml_nbytes(st.gids));
+    ggml_backend_tensor_set_async(st.gpu, st.gw,   st.w_gpu.data(),   0, ggml_nbytes(st.gw));
+    const auto t1 = clk::now();
+
+    if (ggml_backend_graph_compute_async(st.gpu, st.gf) != GGML_STATUS_SUCCESS) {
+        GGML_ABORT("%s: the card's graph failed", __func__);
+    }
+    st.out.resize(ggml_nelements(st.gout));
+    ggml_backend_tensor_get_async(st.gpu, st.gout, st.out.data(), 0, ggml_nbytes(st.gout));
+    ggml_backend_synchronize(st.gpu);
+
+    st.t_upload = std::chrono::duration<double, std::milli>(t1 - t0).count();
+    st.t_total  = std::chrono::duration<double, std::milli>(clk::now() - t0).count();
+}
+
+void helper_main(split_state * st) {
+    for (;;) {
+        {
+            std::unique_lock<std::mutex> lk(st->mu);
+            st->cv.wait(lk, [&] { return st->have_job; });
+            st->have_job = false;
+        }
+        run_job(*st);
+        st->done.store(1, std::memory_order_release);
+    }
+}
+
+// src: 0 cur [n_embd, n_tokens], 1 selected experts [n_used, n_tokens], 2 weights [1, n_used, n_tokens],
+//      3 up, 4 gate, 5 down. dst: the ids the CPU computes with.
+void begin_op(ggml_tensor * dst, int ith, int nth, void * userdata) {
+    GGML_UNUSED(nth);
+    GGML_UNUSED(userdata);
+    if (ith != 0) {
+        return;
+    }
+    split_state & st = state();
+
+    const ggml_tensor * cur = dst->src[0];
+    const ggml_tensor * ids = dst->src[1];
+    const ggml_tensor * w   = dst->src[2];
+    const llama_moe_split_exps exps = { dst->src[3], dst->src[4], dst->src[5] };
+
+    bool expected = false;
+    if (!st.busy.compare_exchange_strong(expected, true)) {
+        GGML_ABORT("%s: two MoE splits at once", __func__);
+    }
+    st.t_begin = clk::now();
+
+    if (!st.init_done) {
+        st.init_done = true;
+        st.failed = !init(st, exps);
+        if (st.failed) {
+            LLAMA_LOG_WARN("%s: no card for the MoE split; the CPU computes every expert\n", __func__);
+        } else {
+            st.th = std::thread(helper_main, &st);
+        }
+    }
+
+    const int     n_used   = (int) ids->ne[0];
+    const int64_t n_tokens = ids->ne[1];
+    const int     n_expert = (int) exps.up->ne[2];
+    int32_t * ids_cpu = (int32_t *) dst->data;
+
+    GGML_ASSERT(ids->nb[0] == sizeof(int32_t) && w->nb[1] == sizeof(float));
+    GGML_ASSERT(ggml_is_contiguous(cur) && ggml_is_contiguous(dst));
+
+    st.ids_gpu.resize(n_used*n_tokens);
+    st.w_gpu.resize(n_used*n_tokens);
+    llama_moe_split_plan((const int32_t *) ids->data, ids->nb[1]/sizeof(int32_t), (const float *) w->data, w->nb[2]/sizeof(float),
+        n_used, n_tokens, n_expert, llama_moe_split_min_tokens(), st.failed ? 0 : st.max_experts,
+        st.heavy, ids_cpu, st.ids_gpu.data(), st.w_gpu.data());
+
+    st.active = !st.heavy.empty();
+    if (!st.active) {
+        return;
+    }
+    for (int i = 0; i < 3; i++) {
+        const ggml_tensor * s = i == 0 ? exps.up : i == 1 ? exps.gate : exps.down;
+        GGML_ASSERT(s->type == st.w[i]->type && s->ne[0] == st.w[i]->ne[0] && s->ne[1] == st.w[i]->ne[1]);
+        st.src[i] = s;
+    }
+    st.x        = (const float *) cur->data;
+    st.n_embd   = cur->ne[0];
+    st.n_tokens = n_tokens;
+    st.n_used   = n_used;
+
+    st.done.store(0, std::memory_order_relaxed);
+    {
+        std::lock_guard<std::mutex> lk(st.mu);
+        st.have_job = true;
+    }
+    st.cv.notify_one();
+}
+
+// src: 0 moe_cpu [n_embd, n_tokens], 1 ids_cpu (orders this after begin), 2 cur (kept alive for the upload)
+void end_op(ggml_tensor * dst, int ith, int nth, void * userdata) {
+    GGML_UNUSED(userdata);
+    split_state & st = state();
+
+    const auto t0 = clk::now();
+    while (st.done.load(std::memory_order_acquire) == 0) {
+        std::this_thread::yield();
+    }
+    const auto t1 = clk::now();
+
+    const ggml_tensor * moe = dst->src[0];
+    const int64_t ne0 = moe->ne[0];
+    const int64_t nr  = ggml_nrows(moe);
+    GGML_ASSERT(ggml_is_contiguous(moe) && ggml_is_contiguous(dst));
+
+    const float * a = (const float *) moe->data;
+    float * d = (float *) dst->data;
+    const int64_t r0 = nr*ith/nth;
+    const int64_t r1 = nr*(ith + 1)/nth;
+    if (st.active) {
+        const float * b = st.out.data();
+        for (int64_t i = r0*ne0; i < r1*ne0; i++) {
+            d[i] = a[i] + b[i];
+        }
+    } else {
+        memcpy(d + r0*ne0, a + r0*ne0, (r1 - r0)*ne0*sizeof(float));
+    }
+
+    if (ith == 0) {
+        if (st.debug) {
+            const double cpu  = std::chrono::duration<double, std::milli>(t0 - st.t_begin).count();
+            const double wait = std::chrono::duration<double, std::milli>(t1 - t0).count();
+            LLAMA_LOG_INFO("moe split: %zu experts on the card, upload %.2f ms, card total %.2f ms; CPU share %.2f ms, wait %.2f ms\n",
+                st.active ? st.heavy.size() : (size_t) 0, st.active ? st.t_upload : 0.0, st.active ? st.t_total : 0.0, cpu, wait);
+        }
+        st.busy.store(false);
+    }
+}
+
+} // namespace
+
+void llama_moe_split_register(const llama_moe_split_exps & exps) {
+    // pinned host memory: the uploads then run without the CPU, at the full rate of the link.
+    // ggml-cuda registers only with GGML_CUDA_REGISTER_HOST set.
+    static std::mutex mu;
+    static std::vector<const void *> done;
+    static bool (*reg_fn)(void *, size_t) = nullptr;
+    static bool looked = false;
+
+    std::lock_guard<std::mutex> lk(mu);
+    if (!looked) {
+        looked = true;
+        ggml_backend_dev_t dev = ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_GPU);
+        if (dev != nullptr) {
+            reg_fn = (bool (*)(void *, size_t)) ggml_backend_reg_get_proc_address(ggml_backend_dev_backend_reg(dev), "ggml_backend_register_host_buffer");
+        }
+    }
+    if (reg_fn == nullptr) {
+        return;
+    }
+    const size_t page = 4096;
+    for (const ggml_tensor * t : { exps.up, exps.gate, exps.down }) {
+        if (std::find(done.begin(), done.end(), t->data) != done.end()) {
+            continue;
+        }
+        done.push_back(t->data);
+        // whole pages inside the tensor: a neighbour may register the pages at its ends
+        const uintptr_t a = ((uintptr_t) t->data + page - 1) & ~(page - 1);
+        const uintptr_t b = ((uintptr_t) t->data + ggml_nbytes(t)) & ~(page - 1);
+        if (b > a && reg_fn((void *) a, b - a)) {
+            static size_t total = 0;
+            total += b - a;
+            LLAMA_LOG_DEBUG("%s: pinned %s, %.2f GiB in all\n", __func__, t->name, total/1073741824.0);
+        }
+    }
+}
+
+ggml_tensor * llama_moe_split_begin(ggml_context * ctx, ggml_tensor * cur, ggml_tensor * selected_experts,
+        ggml_tensor * weights, const llama_moe_split_exps & exps) {
+    ggml_tensor * args[6] = { cur, selected_experts, weights, exps.up, exps.gate, exps.down };
+    return ggml_custom_4d(ctx, GGML_TYPE_I32, selected_experts->ne[0], selected_experts->ne[1], 1, 1, args, 6, begin_op, 1, nullptr);
+}
+
+ggml_tensor * llama_moe_split_end(ggml_context * ctx, ggml_tensor * moe_cpu, ggml_tensor * ids_cpu, ggml_tensor * cur) {
+    ggml_tensor * args[3] = { moe_cpu, ids_cpu, cur };
+    return ggml_custom_4d(ctx, GGML_TYPE_F32, moe_cpu->ne[0], moe_cpu->ne[1], 1, 1, args, 3, end_op, GGML_N_TASKS_MAX, nullptr);
+}
diff --git a/src/llama-moe-split.h b/src/llama-moe-split.h
new file mode 100644
index 000000000..750b4494f
--- /dev/null
+++ b/src/llama-moe-split.h
@@ -0,0 +1,83 @@
+#pragma once
+
+// Split of the routed experts of one MoE layer between the card and the CPU (prefill).
+//
+// The experts stay in host memory. Per ubatch, the experts that at least `min_tokens` tokens
+// route to are uploaded to the card and computed there; the CPU computes the rest at the same
+// time. LLAMA_MOE_SPLIT=<min_tokens> turns it on; LLAMA_MOE_SPLIT_MAX=<n> caps the experts a
+// layer uploads (default 64).
+
+#include "ggml.h"
+#include "ggml-backend.h"
+
+#include <algorithm>
+#include <cstdint>
+#include <vector>
+
+// The plan for one ubatch of one layer.
+//   ids [n_tokens][n_used] (row stride ids_stride), w the routing weights (row stride w_stride).
+//   heavy:   the experts the card computes, ascending; its slot j holds expert heavy[j]
+//   ids_cpu: the expert of each slot, or -1 where the card computes it
+//   ids_gpu: the card slot of each slot; 0 where the CPU computes it (its weight is then 0)
+//   w_gpu:   the routing weight where the card computes the slot, else 0
+// The experts with at least min_tokens tokens are heavy, at most max_experts of them: the most
+// routed, the lower id first on a tie.
+inline void llama_moe_split_plan(
+        const int32_t * ids, int64_t ids_stride, const float * w, int64_t w_stride,
+        int n_used, int64_t n_tokens, int n_expert, int min_tokens, int max_experts,
+        std::vector<int32_t> & heavy, int32_t * ids_cpu, int32_t * ids_gpu, float * w_gpu) {
+    std::vector<int32_t> count(n_expert, 0);
+    for (int64_t t = 0; t < n_tokens; t++) {
+        for (int k = 0; k < n_used; k++) {
+            count[ids[t*ids_stride + k]]++;
+        }
+    }
+
+    heavy.clear();
+    for (int e = 0; e < n_expert; e++) {
+        if (count[e] >= min_tokens) {
+            heavy.push_back(e);
+        }
+    }
+    if ((int) heavy.size() > max_experts) {
+        std::stable_sort(heavy.begin(), heavy.end(), [&](int32_t a, int32_t b) { return count[a] > count[b]; });
+        heavy.resize(std::max(max_experts, 0));
+        std::sort(heavy.begin(), heavy.end());
+    }
+
+    std::vector<int32_t> slot(n_expert, -1);
+    for (size_t j = 0; j < heavy.size(); j++) {
+        slot[heavy[j]] = (int32_t) j;
+    }
+
+    for (int64_t t = 0; t < n_tokens; t++) {
+        for (int k = 0; k < n_used; k++) {
+            const int32_t e = ids[t*ids_stride + k];
+            const int32_t j = slot[e];
+            ids_cpu[t*n_used + k] = j >= 0 ? -1 : e;
+            ids_gpu[t*n_used + k] = j >= 0 ?  j : 0;
+            w_gpu  [t*n_used + k] = j >= 0 ? w[t*w_stride + k] : 0.0f;
+        }
+    }
+}
+
+struct llama_moe_split_exps {
+    ggml_tensor * up;
+    ggml_tensor * gate;
+    ggml_tensor * down;
+};
+
+// Minimum tokens per expert from LLAMA_MOE_SPLIT; 0 when the split is off.
+int llama_moe_split_min_tokens();
+
+// Pins the host memory of the experts once (with GGML_CUDA_REGISTER_HOST set).
+void llama_moe_split_register(const llama_moe_split_exps & exps);
+
+// Graph nodes, all on the CPU backend.
+// The first takes the plan and starts the card's share; it returns the ids the CPU computes
+// with (-1 where the card computes). cur is [n_embd, n_tokens].
+ggml_tensor * llama_moe_split_begin(ggml_context * ctx, ggml_tensor * cur, ggml_tensor * selected_experts,
+        ggml_tensor * weights, const llama_moe_split_exps & exps);
+
+// The second waits for the card and returns moe_cpu plus the card's weighted sum.
+ggml_tensor * llama_moe_split_end(ggml_context * ctx, ggml_tensor * moe_cpu, ggml_tensor * ids_cpu, ggml_tensor * cur);
