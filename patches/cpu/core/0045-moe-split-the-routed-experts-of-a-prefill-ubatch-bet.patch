+        // from here on the CPU computes with the ids this returns: -1 where the card computes
+        selected_experts = llama_moe_split_begin(ctx0, cur_in, selected_experts, weights, { up_exps, gate_exps, down_exps });
+        cb(selected_experts, "ffn_moe_split_ids", il);
