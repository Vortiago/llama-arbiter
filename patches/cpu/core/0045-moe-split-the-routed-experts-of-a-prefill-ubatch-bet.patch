 src/llama-moe-split.cpp      | 355 +++++++++++++++++++++++++++++++++++
 src/llama-moe-split.h        |  83 ++++++++
 tests/CMakeLists.txt         |   1 +
 tests/test-moe-split.cpp     | 104 ++++++++++
