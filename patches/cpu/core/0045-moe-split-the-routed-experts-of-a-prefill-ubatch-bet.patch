     cur = ggml_reshape_3d(ctx0, cur, n_embd, 1, n_tokens);
 
     if (weight_before_ffn) {
@@ -2275,6 +2303,7 @@ ggml_tensor * llm_graph_context::build_moe_ffn(
         // separate gate and up path
         up = build_lora_mm_id(up_exps, cur, selected_experts, up_exps_s); // [n_ff, n_expert_used, n_tokens]
         cb(up, "ffn_moe_up", il);
+        set_backend(sched, backend_split_cpu, up);
 
         if (up_exps_s) {
             cb(up, "ffn_moe_up_scaled", il);
@@ -2288,6 +2317,7 @@ ggml_tensor * llm_graph_context::build_moe_ffn(
         if (gate_exps) {
             cur = build_lora_mm_id(gate_exps, cur, selected_experts, gate_exps_s); // [n_ff, n_expert_used, n_tokens]
             cb(cur, "ffn_moe_gate", il);
+            set_backend(sched, backend_split_cpu, cur);
         } else {
             cur = up;
         }
@@ -2393,6 +2423,7 @@ ggml_tensor * llm_graph_context::build_moe_ffn(
         ggml_prec_set_src(experts, GGML_PREC_F32, 1);
     }
     cb(experts, "ffn_moe_down", il);
+    set_backend(sched, backend_split_cpu, experts);
 
     if (down_exps_s) {
         cb(experts, "ffn_moe_down_scaled", il);
@@ -2447,6 +2478,12 @@ ggml_tensor * llm_graph_context::build_moe_ffn(
         set_backend(sched, backend_exps, moe_out);
     }
 
