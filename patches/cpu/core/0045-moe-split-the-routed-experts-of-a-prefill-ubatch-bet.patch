--- a/src/llama-graph.cpp
+++ b/src/llama-graph.cpp
@@ -15,6 +15,7 @@
 #include "llama-memory-hybrid.h"
 #include "llama-memory-hybrid-iswa.h"
 #include "llama-memory-recurrent.h"
+#include "llama-moe-split.h"
 
 #include <cassert>
 #include <cmath>
@@ -2105,6 +2106,8 @@ ggml_tensor * llm_graph_context::build_moe_ffn(
     const int64_t n_tokens = cur->ne[1];
     const bool weight_before_ffn = arch == LLM_ARCH_LLAMA4; // for llama4, we apply the sigmoid-ed weights before the FFN
 
+    ggml_tensor * cur_in = cur;
+
     ggml_tensor * logits = nullptr;
 
     if (probs_in == nullptr) {
@@ -2240,6 +2243,31 @@ ggml_tensor * llm_graph_context::build_moe_ffn(
     //call early so that topk-moe can be used
     ggml_build_forward_expand(gf, weights);
 
+    // the split of the experts between the card and the CPU (llama-moe-split.h)
+    ggml_backend_t backend_split_cpu = nullptr;
+    if (sched != nullptr && llama_moe_split_min_tokens() > 0 && n_tokens >= llama_moe_split_min_tokens() &&
+        !weight_before_ffn && type_op == LLM_FFN_SILU && gate_exps && up_exps && !gate_up_exps &&
+        !up_exps_b && !gate_exps_b && !down_exps_b && !up_exps_s && !gate_exps_s && !down_exps_s &&
+        (loras == nullptr || loras->empty()) && ggml_is_contiguous(cur_in) &&
+        (il < 0 || hparams.swiglu_clamp_exp[il] <= 1e-6f) &&
+        up_exps->buffer && gate_exps->buffer && down_exps->buffer &&
+        ggml_backend_buffer_is_host(up_exps->buffer) && ggml_backend_buffer_is_host(gate_exps->buffer) &&
+        ggml_backend_buffer_is_host(down_exps->buffer)) {
+        for (int i = 0; i < ggml_backend_sched_get_n_backends(sched); i++) {
+            ggml_backend_t b = ggml_backend_sched_get_backend(sched, i);
+            if (ggml_backend_dev_type(ggml_backend_get_device(b)) == GGML_BACKEND_DEVICE_TYPE_CPU) {
+                backend_split_cpu = b;
