diff --git a/tests/test-moe-split.cpp b/tests/test-moe-split.cpp
new file mode 100644
index 000000000..08b640ab4
--- /dev/null
+++ b/tests/test-moe-split.cpp
@@ -0,0 +1,104 @@
+// The MoE split between the card and the CPU: the plan, and a CPU MUL_MAT_ID with negative ids.
+#include "../src/llama-moe-split.h"
+
+#include "ggml.h"
+#include "ggml-cpu.h"
+
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <random>
+#include <vector>
+
+#define CHECK(c) do { if (!(c)) { fprintf(stderr, "%s:%d: CHECK(%s) failed\n", __FILE__, __LINE__, #c); exit(1); } } while (0)
+
+static void test_plan() {
+    // 4 tokens, 2 used, 6 experts: expert 1 has 4 tokens, expert 3 has 3, expert 0 has 1
+    const int n_used = 2, n_tokens = 4, n_expert = 6;
+    const int32_t ids[n_tokens*n_used] = { 1, 3,  1, 0,  3, 1,  1, 3 };
+    const float   w  [n_tokens*n_used] = { .1f, .2f, .3f, .4f, .5f, .6f, .7f, .8f };
+    int32_t ids_cpu[8], ids_gpu[8];
+    float w_gpu[8];
+    std::vector<int32_t> heavy;
+
+    llama_moe_split_plan(ids, n_used, w, n_used, n_used, n_tokens, n_expert, 3, 8, heavy, ids_cpu, ids_gpu, w_gpu);
+    CHECK(heavy.size() == 2 && heavy[0] == 1 && heavy[1] == 3);
+    for (int s = 0; s < 8; s++) {
+        if (ids[s] == 0) {
+            CHECK(ids_cpu[s] == 0 && w_gpu[s] == 0.0f && ids_gpu[s] == 0);
+        } else {
+            CHECK(ids_cpu[s] == -1 && heavy[ids_gpu[s]] == ids[s] && w_gpu[s] == w[s]);
+        }
+    }
+
+    // at most one expert: the most routed
+    llama_moe_split_plan(ids, n_used, w, n_used, n_used, n_tokens, n_expert, 1, 1, heavy, ids_cpu, ids_gpu, w_gpu);
+    CHECK(heavy.size() == 1 && heavy[0] == 1);
+    CHECK(ids_cpu[1] == 3 && ids_cpu[0] == -1 && ids_gpu[0] == 0);
+
+    // none reaches the threshold: the CPU computes everything
+    llama_moe_split_plan(ids, n_used, w, n_used, n_used, n_tokens, n_expert, 5, 8, heavy, ids_cpu, ids_gpu, w_gpu);
+    CHECK(heavy.empty());
+    for (int s = 0; s < 8; s++) {
+        CHECK(ids_cpu[s] == ids[s] && w_gpu[s] == 0.0f);
+    }
+}
+
+// MUL_MAT_ID on the CPU, Q8_0 experts: a row with a negative id is zero, and every other row is
+// the same as with all ids given
+static void test_cpu_negative_ids(int n_tokens) {
+    const int n_embd = 256, n_ff = 64, n_expert = 8, n_used = 3;
+
+    ggml_init_params ip = { 64*1024*1024, nullptr, false };
+    ggml_context * ctx = ggml_init(ip);
+
+    ggml_tensor * wf  = ggml_new_tensor_3d(ctx, GGML_TYPE_F32,  n_embd, n_ff, n_expert);
+    ggml_tensor * wq  = ggml_new_tensor_3d(ctx, GGML_TYPE_Q8_0, n_embd, n_ff, n_expert);
+    ggml_tensor * x   = ggml_new_tensor_3d(ctx, GGML_TYPE_F32,  n_embd, 1, n_tokens);
+    ggml_tensor * ids = ggml_new_tensor_2d(ctx, GGML_TYPE_I32,  n_used, n_tokens);
+    ggml_tensor * sk  = ggml_new_tensor_2d(ctx, GGML_TYPE_I32,  n_used, n_tokens);
+
+    std::mt19937 rng(42);
+    std::uniform_real_distribution<float> u(-1.0f, 1.0f);
+    for (int64_t i = 0; i < ggml_nelements(wf); i++) ((float *) wf->data)[i] = u(rng);
+    for (int64_t i = 0; i < ggml_nelements(x);  i++) ((float *) x->data)[i]  = u(rng);
+    ggml_quantize_chunk(GGML_TYPE_Q8_0, (const float *) wf->data, wq->data, 0, n_ff*n_expert, n_embd, nullptr);
+
+    for (int t = 0; t < n_tokens; t++) {
+        for (int k = 0; k < n_used; k++) {
+            const int32_t e = (t*7 + k*3) % n_expert;
+            ((int32_t *) ids->data)[t*n_used + k] = e;
+            ((int32_t *) sk->data)[t*n_used + k]  = (e % 3 == 0) ? -1 : e;
+        }
+    }
+
+    ggml_tensor * full = ggml_mul_mat_id(ctx, wq, x, ids);
+    ggml_tensor * part = ggml_mul_mat_id(ctx, wq, x, sk);
+    // the zero rows must be written: start from NaN
+    ggml_cgraph * gf = ggml_new_graph(ctx);
+    ggml_build_forward_expand(gf, full);
+    ggml_build_forward_expand(gf, part);
+    for (int64_t i = 0; i < ggml_nelements(part); i++) ((float *) part->data)[i] = NAN;
+    CHECK(ggml_graph_compute_with_ctx(ctx, gf, 4) == GGML_STATUS_SUCCESS);
+
+    for (int t = 0; t < n_tokens; t++) {
+        for (int k = 0; k < n_used; k++) {
+            const float * a = (const float *) ((const char *) full->data + k*full->nb[1] + t*full->nb[2]);
+            const float * b = (const float *) ((const char *) part->data + k*part->nb[1] + t*part->nb[2]);
+            const bool skipped = ((int32_t *) sk->data)[t*n_used + k] < 0;
+            for (int i = 0; i < n_ff; i++) {
+                CHECK(skipped ? b[i] == 0.0f : b[i] == a[i]);
+            }
+        }
+    }
+    ggml_free(ctx);
+}
+
+int main() {
+    test_plan();
+    test_cpu_negative_ids(5);
+    test_cpu_negative_ids(300);  // enough rows per expert for the sgemm path
+    printf("ok\n");
+    return 0;
+}
