 tests/test-backend-ops.cpp |  7 +++++
 2 files changed, 66 insertions(+)

diff --git a/ggml/src/ggml-cpu/ops.cpp b/ggml/src/ggml-cpu/ops.cpp
index 333fd3509..e970b4f6a 100644
--- a/ggml/src/ggml-cpu/ops.cpp
+++ b/ggml/src/ggml-cpu/ops.cpp
@@ -11590,6 +11590,58 @@ void ggml_compute_forward_dsv4_hc_pre(
 
 // ggml_compute_forward_dsv4_hc_post
 
+// Element range [ir0, ir1) of dst, flattened over (n_embd, hc, n_tokens), one stream row segment at a time.
+// Each element keeps the operation order of the scalar path, so the result is the same bit for bit.
+static void ggml_compute_forward_dsv4_hc_post_rows(
+        const ggml_tensor * x,
+        const ggml_tensor * residual,
+        const ggml_tensor * post,
+        const ggml_tensor * comb,
+        ggml_tensor * dst,
+        const int64_t ir0,
+        const int64_t ir1) {
+    const int64_t n_embd = x->ne[0];
+    const int64_t hc     = residual->ne[1];
+
+    for (int64_t ir = ir0; ir < ir1; ) {
+        const int64_t row  = ir / n_embd;
+        const int64_t i0   = ir - row*n_embd;
+        const int64_t idst = row % hc;
+        const int64_t it   = row / hc;
+        const int     n    = (int) MIN(n_embd - i0, ir1 - ir);
+
+        const float * xr = (const float *) ((const char *) x->data + it*x->nb[1]) + i0;
+        float       * d  = (float *) ((char *) dst->data + idst*dst->nb[1] + it*dst->nb[2]) + i0;
+        const float   pv = *(const float *) ((const char *) post->data + idst*post->nb[0] + it*post->nb[1]);
+
+        if (comb) {
+            // One sum over the streams per element, in the scalar order. The same chain shape gets the
+            // same FMA choice from the compiler: GCC tuned for znver2 keeps the chain as mul and add.
+            const char * residual_tok = (const char *) residual->data + it*residual->nb[2];
+            const char * comb_row     = (const char *) comb->data + idst*comb->nb[0] + it*comb->nb[2];
+            for (int i = 0; i < n; ++i) {
+                float sum = xr[i] * pv;
+                for (int64_t isrc = 0; isrc < hc; ++isrc) {
+                    const float rv = ((const float *) (residual_tok + isrc*residual->nb[1]))[i0 + i];
+                    const float cv = *(const float *) (comb_row + isrc*comb->nb[1]);
+                    sum += rv * cv;
+                }
+                d[i] = sum;
+            }
+        } else {
+            // Two passes, not d[i] = xr[i]*pv + rr[i]: GCC would contract that into an FMA,
+            // and the scalar path rounds the product before the add.
+            const float * rr = (const float *) ((const char *) residual->data + idst*residual->nb[1] + it*residual->nb[2]) + i0;
+            for (int i = 0; i < n; ++i) {
+                d[i] = xr[i] * pv;
+            }
+            ggml_vec_acc_f32(n, d, rr);
+        }
+
+        ir += n;
+    }
+}
+
 static void ggml_compute_forward_dsv4_hc_post_f32(
         const ggml_compute_params * params,
         ggml_tensor * dst) {
@@ -11642,6 +11694,13 @@ static void ggml_compute_forward_dsv4_hc_post_f32(
     const int64_t ir0 = dr * ith;
     const int64_t ir1 = MIN(ir0 + dr, nr);
 
+    // use_ref keeps the scalar loop, so a CPU-only test compares the row walk against it
+    const bool rows_contiguous = nbx0 == sizeof(float) && nbr0 == sizeof(float) && nbd0 == sizeof(float);
+    if (rows_contiguous && !params->use_ref) {
+        ggml_compute_forward_dsv4_hc_post_rows(x, residual, post, comb, dst, ir0, ir1);
+        return;
+    }
+
     for (int64_t ir = ir0; ir < ir1; ++ir) {
         const int64_t i0     = ir % n_embd;
         const int64_t idst   = (ir / n_embd) % hc;
