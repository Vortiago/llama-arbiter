From aa1c52faa814fb8c78b27d819557e6bd3d290a21 Mon Sep 17 00:00:00 2001
From: Vortiago <atle@havso.net>
Date: Wed, 7 Oct 2026 19:19:27 +0200
Subject: [PATCH] perf(ggml-cuda): 16-row MMF tiles for matrices of few row
 tiles

The F32 MoE router [2560, 512] at 4 tokens ran as 16 blocks of 32 rows on
a 48-SM card, about 19 us a layer. When a matrix has fewer 32-row tiles
than the card has SMs, MMF now uses blocks of one 16-row MMA tile, twice
the blocks. A tile's MMA sequence and the sum over the warps keep their
order, so the results are bit-identical.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01C6MCJC4HTKxvuGjKjqDuqQ
---
 ggml/src/ggml-cuda/mmf.cu  |  8 +++++++-
 ggml/src/ggml-cuda/mmf.cuh | 35 ++++++++++++++++++++++++++++++++++-
 tests/test-backend-ops.cpp | 13 +++++++++++++
 3 files changed, 54 insertions(+), 2 deletions(-)

diff --git a/ggml/src/ggml-cuda/mmf.cu b/ggml/src/ggml-cuda/mmf.cu
index 646a5899c..84daf7955 100644
--- a/ggml/src/ggml-cuda/mmf.cu
+++ b/ggml/src/ggml-cuda/mmf.cu
@@ -98,7 +98,13 @@ void ggml_cuda_mul_mat_f(ggml_backend_cuda_context & ctx, const ggml_tensor * sr
 
     const int device    = ggml_cuda_get_device();
     const int cc        = ggml_cuda_info().devices[device].cc;
-    const int rows_per_block = mmf_get_rows_per_block(cc);
+    int rows_per_block = mmf_get_rows_per_block(cc);
+    // Fewer row tiles than SMs leave SMs idle: one 16-row MMA tile a block doubles the blocks. Each
+    // tile's products and the sum over the warps are the same, so the results are too.
+    if (!ids && turing_mma_available(cc) && !volta_mma_available(cc) &&
+            (ne01/rows_per_block)*nchannels_dst*ne3 < ggml_cuda_info().devices[device].nsm) {
+        rows_per_block = MMF_ROWS_PER_BLOCK_SMALL;
+    }
 
     switch (src0->type) {
         case GGML_TYPE_F32: {
diff --git a/ggml/src/ggml-cuda/mmf.cuh b/ggml/src/ggml-cuda/mmf.cuh
index 879a86527..2b3e0485c 100644
--- a/ggml/src/ggml-cuda/mmf.cuh
+++ b/ggml/src/ggml-cuda/mmf.cuh
@@ -7,6 +7,7 @@
 using namespace ggml_cuda_mma;
 
 #define MMF_ROWS_PER_BLOCK 32
+#define MMF_ROWS_PER_BLOCK_SMALL 16 // one 16-row MMA tile a block, for matrices of fewer row tiles than SMs
 #define MMF_ROWS_PER_BLOCK_CDNA 64
 
 static __forceinline__ int64_t mmf_get_max_block_size(int cc) {
@@ -72,7 +73,8 @@ static __global__ void mul_mat_f(
     typedef tile< 8, 4, T,     DATA_LAYOUT_I_MAJOR_MIRRORED> tile_B;
     typedef tile<32, 8, float, DATA_LAYOUT_I_MAJOR>          tile_C;
 #else
-    if constexpr (rows_per_block != MMF_ROWS_PER_BLOCK) {NO_DEVICE_CODE;} else {
+    if constexpr ((rows_per_block != MMF_ROWS_PER_BLOCK && rows_per_block != MMF_ROWS_PER_BLOCK_SMALL) ||
+                  (has_ids && rows_per_block != MMF_ROWS_PER_BLOCK)) {NO_DEVICE_CODE;} else {
     typedef tile<16, 8, T>     tile_A;
     typedef tile<8,  8, T>     tile_B;
     typedef tile<16, 8, float> tile_C;
@@ -256,6 +258,24 @@ static __global__ void mul_mat_f(
         ggml_cuda_syncwarp();
     }
 
+    if constexpr (rows_per_block < warp_size) {
+        // a warp sums warp_size/rows_per_block columns, over the warps in the same order as below
+        constexpr int cols_per_warp = warp_size / rows_per_block;
+        const int i = threadIdx.x % rows_per_block;
+#pragma unroll
+        for (int j0 = 0; j0 < cols_per_block; j0 += nwarps*cols_per_warp) {
+            const int j = j0 + threadIdx.y*cols_per_warp + threadIdx.x / rows_per_block;
+            if (j < cols_per_block) {
+                float sum = 0.0f;
+#pragma unroll
+                for (int i0 = 0; i0 < nwarps*rows_per_block; i0 += rows_per_block) {
+                    sum += buf_iw[j*kiw + i0 + i];
+                }
+                dst[j*stride_col_dst + row0 + i] = sum;
+            }
+        }
+        return;
+    } else {
 #pragma unroll
     for (int j0 = 0; j0 < cols_per_block; j0 += nwarps) {
         const int j = j0 + threadIdx.y;
@@ -292,6 +312,7 @@ static __global__ void mul_mat_f(
         }
     }
     }
+    }
 #else
     GGML_UNUSED_VARS(x, y, ids, dst,
         ncols, ncols_dst_total, nchannels_dst, stride_row, stride_col_y, stride_col_dst,
@@ -868,6 +889,12 @@ static void mul_mat_f_switch_rows_per_block(
                 stride_col_id, stride_row_id, nchannels_x, nchannels_y, nchannels_dst, stride_channel_x, stride_channel_y, stride_channel_dst,
                 nsamples_x, nsamples_dst, stride_sample_x, stride_sample_y, stride_sample_dst, stream, ids_data);
         } break;
+        case MMF_ROWS_PER_BLOCK_SMALL: {
+            mul_mat_f_switch_cols_per_block<T, MMF_ROWS_PER_BLOCK_SMALL>(
+                x, y, ids, dst, ncols_x, nrows_x, ncols_dst, stride_row, stride_col_y, stride_col_dst,
+                stride_col_id, stride_row_id, nchannels_x, nchannels_y, nchannels_dst, stride_channel_x, stride_channel_y, stride_channel_dst,
+                nsamples_x, nsamples_dst, stride_sample_x, stride_sample_y, stride_sample_dst, stream, ids_data);
+        } break;
         case MMF_ROWS_PER_BLOCK_CDNA: {
             mul_mat_f_switch_cols_per_block<T, MMF_ROWS_PER_BLOCK_CDNA>(
                 x, y, ids, dst, ncols_x, nrows_x, ncols_dst, stride_row, stride_col_y, stride_col_dst,
@@ -894,6 +921,9 @@ static void mul_mat_f_switch_rows_per_block(
     extern DECL_MMF_CASE_HELPER(float, MMF_ROWS_PER_BLOCK, ncols_dst) \
     extern DECL_MMF_CASE_HELPER(half2, MMF_ROWS_PER_BLOCK, ncols_dst) \
     extern DECL_MMF_CASE_HELPER(nv_bfloat162, MMF_ROWS_PER_BLOCK, ncols_dst) \
+    extern DECL_MMF_CASE_HELPER(float, MMF_ROWS_PER_BLOCK_SMALL, ncols_dst) \
+    extern DECL_MMF_CASE_HELPER(half2, MMF_ROWS_PER_BLOCK_SMALL, ncols_dst) \
+    extern DECL_MMF_CASE_HELPER(nv_bfloat162, MMF_ROWS_PER_BLOCK_SMALL, ncols_dst) \
     extern DECL_MMF_CASE_HELPER(float, MMF_ROWS_PER_BLOCK_CDNA, ncols_dst) \
     extern DECL_MMF_CASE_HELPER(half2, MMF_ROWS_PER_BLOCK_CDNA, ncols_dst) \
     extern DECL_MMF_CASE_HELPER(nv_bfloat162, MMF_ROWS_PER_BLOCK_CDNA, ncols_dst)
@@ -902,6 +932,9 @@ static void mul_mat_f_switch_rows_per_block(
     DECL_MMF_CASE_HELPER(float, MMF_ROWS_PER_BLOCK, ncols_dst) \
     DECL_MMF_CASE_HELPER(half2, MMF_ROWS_PER_BLOCK, ncols_dst) \
     DECL_MMF_CASE_HELPER(nv_bfloat162, MMF_ROWS_PER_BLOCK, ncols_dst) \
+    DECL_MMF_CASE_HELPER(float, MMF_ROWS_PER_BLOCK_SMALL, ncols_dst) \
+    DECL_MMF_CASE_HELPER(half2, MMF_ROWS_PER_BLOCK_SMALL, ncols_dst) \
+    DECL_MMF_CASE_HELPER(nv_bfloat162, MMF_ROWS_PER_BLOCK_SMALL, ncols_dst) \
     DECL_MMF_CASE_HELPER(float, MMF_ROWS_PER_BLOCK_CDNA, ncols_dst) \
     DECL_MMF_CASE_HELPER(half2, MMF_ROWS_PER_BLOCK_CDNA, ncols_dst) \
     DECL_MMF_CASE_HELPER(nv_bfloat162, MMF_ROWS_PER_BLOCK_CDNA, ncols_dst)
diff --git a/tests/test-backend-ops.cpp b/tests/test-backend-ops.cpp
index a90f3e007..280ca5fb0 100644
--- a/tests/test-backend-ops.cpp
+++ b/tests/test-backend-ops.cpp
@@ -10922,6 +10922,14 @@ static std::vector<std::unique_ptr<test_case>> make_test_cases_eval() {
             test_cases.emplace_back(new test_mul_mat_id_shared(type, n));
         }
     }
+    // float matrices of few row tiles (a MoE router, an indexer projection), 1 to 16 columns
+    for (ggml_type type : { GGML_TYPE_F32, GGML_TYPE_F16, GGML_TYPE_BF16 }) {
+        for (int64_t n : { 1, 4, 5, 8, 13, 16 }) {
+            test_cases.emplace_back(new test_mul_mat(type, GGML_TYPE_F32, 512, n, 2560, {1, 1}, {1, 1}));
+            test_cases.emplace_back(new test_mul_mat(type, GGML_TYPE_F32, 128, n, 640,  {1, 1}, {1, 1}));
+            test_cases.emplace_back(new test_mul_mat(type, GGML_TYPE_F32, 64,  n, 256,  {2, 1}, {1, 1}));
+        }
+    }
     for (ggml_type type : { GGML_TYPE_Q4_0, GGML_TYPE_Q4_K, GGML_TYPE_Q8_0 }) {
         for (int64_t n : { 1, 2, 4, 8, 9 }) {
             test_cases.emplace_back(new test_mul_mat_multi(type, 256, n, { 64, 5 }));
@@ -11987,6 +11995,11 @@ static std::vector<std::unique_ptr<test_case>> make_test_cases_perf() {
         }
     }
 
+    // Qwen3.8-Flash-Next router (F32) and indexer q and k projections (BF16) in a 4-token verify window
+    test_cases.emplace_back(new test_mul_mat(GGML_TYPE_F32,  GGML_TYPE_F32, 512, 4, 2560, {1, 1}, {1, 1}));
+    test_cases.emplace_back(new test_mul_mat(GGML_TYPE_BF16, GGML_TYPE_F32, 512, 4, 2560, {1, 1}, {1, 1}));
+    test_cases.emplace_back(new test_mul_mat(GGML_TYPE_BF16, GGML_TYPE_F32, 128, 4, 2560, {1, 1}, {1, 1}));
+
     // Qwen3.8-Flash-Next weights that read one input: hyper-connection down and inject, shared expert
     // gate and up, DeltaNet qkv, gate, beta and alpha, attention q, k and v
     for (int n : {1, 4}) {
