+static bool ggml_backend_cuda_host_gate_wait(ggml_backend_t backend, const ggml_cgraph * next) {
+#if defined(GGML_USE_HIP) || defined(GGML_USE_MUSA)
+    GGML_UNUSED(backend);
+    GGML_UNUSED(next);
+    return false;
+#else
     ggml_backend_cuda_context * cuda_ctx = (ggml_backend_cuda_context *) backend->context;
 
     ggml_cuda_set_device(cuda_ctx->device);
-    CUDA_CHECK(cudaLaunchHostFunc(cuda_ctx->stream(), func, data));
+    // the host queues next behind the gate before it opens the gate: queueing next must not wait for the stream
+    if (!ggml_cuda_graph_ready(cuda_ctx, const_cast<ggml_cgraph *>(next))) {
+        return false;
+    }
+    if (cuda_ctx->gate_host == nullptr) {
