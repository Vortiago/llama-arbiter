-static void ggml_backend_cuda_launch_host_func(ggml_backend_t backend, void (*func)(void * data), void * data) {
+// true if computing cgraph would only launch its CUDA graph, unchanged: that calls nothing that can
+// wait for the stream (a first kernel launch, for example, can load a module and wait for the device)
+static bool ggml_cuda_graph_ready(ggml_backend_cuda_context * cuda_ctx, ggml_cgraph * cgraph) {
+#ifdef USE_CUDA_GRAPH
+    auto it = cuda_ctx->cuda_graphs.find(ggml_cuda_graph_get_key(cgraph));
+    if (it == cuda_ctx->cuda_graphs.end()) {
+        return false;
+    }
+    const ggml_cuda_graph * graph = it->second.get();
+    // cuda_graph() evicts a graph unused for 10 s: one used in the last 5 s stays
+    if (!graph->is_enabled() || !graph->warmup_complete || graph->instance == nullptr ||
+        ggml_time_us() - graph->last_used_time >= 5'000'000 || !ggml_cuda_graph_check_compability(cgraph)) {
+        return false;
+    }
+    if (cgraph->uid != 0 && cgraph->uid == graph->uid) {
+        return true;
+    }
+    if ((int) graph->node_props.size() != cgraph->n_nodes) {
+        return false;
+    }
+    // the same test as ggml_cuda_graph_update_required, without the update
+    for (int i = 0; i < cgraph->n_nodes; i++) {
+        ggml_cuda_graph::node_properties prop = {};
+        memcpy(&prop.node, cgraph->nodes[i], sizeof(ggml_tensor));
+        for (int j = 0; j < GGML_MAX_SRC; ++j) {
+            if (cgraph->nodes[i]->src[j]) {
+                prop.node_src_data_ptrs[j] = cgraph->nodes[i]->src[j]->data;
+                memcpy(prop.node_src_ne[j], cgraph->nodes[i]->src[j]->ne, sizeof(prop.node_src_ne[j]));
+                memcpy(prop.node_src_nb[j], cgraph->nodes[i]->src[j]->nb, sizeof(prop.node_src_nb[j]));
+            }
+        }
+        if (memcmp(&graph->node_props[i], &prop, sizeof(prop)) != 0) {
+            return false;
+        }
+    }
+    return true;
+#else
+    GGML_UNUSED(cuda_ctx);
+    GGML_UNUSED(cgraph);
+    return false;
+#endif // USE_CUDA_GRAPH
+}
