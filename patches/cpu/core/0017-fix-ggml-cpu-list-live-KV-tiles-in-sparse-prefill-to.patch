+// A mask built the way qwen4exp builds its QSA mask: 0 for a cell a row sees, -inf for the rest, no other value.
+// Row i1 is the token in cell kv_head + i1, as in a later ubatch, and the cells after the ubatch are padding.
+// A row sees its top pools of 4 complete cells, scored by a shared base plus per row noise so adjacent rows overlap,
+// and the cells of its own incomplete pool. A row with fewer complete pools than the budget sees all of them.
+static void init_tensor_kq_mask_qsa(ggml_tensor * tensor, int64_t n_kv_max, int64_t kv_head) {
+    GGML_ASSERT(tensor->type == GGML_TYPE_F16);
+
+    static constexpr int64_t pool = 4;
+
+    const int64_t ne0      = tensor->ne[0];
+    const int64_t ne1      = tensor->ne[1];
+    const int64_t n_slices = tensor->ne[2]*tensor->ne[3];
+    const int64_t n_top    = (n_kv_max - (pool - 1))/pool;
+    GGML_ASSERT(n_top > 0 && kv_head + ne1 <= ne0);
+
+    std::vector<float>       data_f32(ggml_nelements(tensor), -INFINITY);
+    std::vector<ggml_fp16_t> data_f16(ggml_nelements(tensor));
+
+    std::mt19937 gen(0x05A0);
+    std::normal_distribution<float> noise(0.0f, 1.0f);
+
+    std::vector<float>   base(ne0/pool);
+    std::vector<float>   score;
+    std::vector<int64_t> order;
+
+    for (int64_t slice = 0; slice < n_slices; ++slice) {
+        for (float & b : base) {
+            b = 2.0f*noise(gen);
+        }
+        for (int64_t i1 = 0; i1 < ne1; ++i1) {
+            const int64_t pos     = kv_head + i1;
+            const int64_t n_pools = (pos + 1)/pool;
+
+            score.resize(n_pools);
+            order.resize(n_pools);
+            for (int64_t p = 0; p < n_pools; ++p) {
+                score[p] = base[p] + noise(gen);
+                order[p] = p;
+            }
+            const int64_t n_pick = std::min(n_top, n_pools);
+            std::partial_sort(order.begin(), order.begin() + n_pick, order.end(),
+                    [&](int64_t a, int64_t b) { return score[a] > score[b]; });
+
+            float * row = data_f32.data() + (slice*ne1 + i1)*ne0;
+            for (int64_t j = 0; j < n_pick; ++j) {
+                std::fill(row + order[j]*pool, row + (order[j] + 1)*pool, 0.0f);
+            }
+            std::fill(row + n_pools*pool, row + pos + 1, 0.0f);
+        }
+    }
+
+    ggml_fp32_to_fp16_row(data_f32.data(), data_f16.data(), data_f16.size());
+    ggml_backend_tensor_set(tensor, data_f16.data(), 0, data_f16.size()*sizeof(ggml_fp16_t));
+}
