             enum ggml_status ec = compute_late();
             if (ec != GGML_STATUS_SUCCESS) {
@@ -1895,14 +1924,17 @@ static enum ggml_status ggml_backend_sched_compute_splits(ggml_backend_sched_t s
             }
         }
         const bool late = can_compute_late(split_id);
+        if (late) {
