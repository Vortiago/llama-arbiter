+// scheduler synchronize calls, counting and timing them when the gate is on
+static void ggml_op_stats_sync(ggml_backend_t backend) {
+    if (!ggml_op_stats_enabled()) {
+        ggml_backend_synchronize(backend);
+        return;
+    }
+    const int64_t t0 = ggml_time_us();
+    ggml_backend_synchronize(backend);
+    GGML_OP_STATS_ADD(sched_syncs, 1);
+    GGML_OP_STATS_ADD(sched_sync_us, ggml_time_us() - t0);
+}
+
+static void ggml_op_stats_event_sync(ggml_backend_event_t event) {
+    if (!ggml_op_stats_enabled()) {
+        ggml_backend_event_synchronize(event);
+        return;
+    }
+    const int64_t t0 = ggml_time_us();
+    ggml_backend_event_synchronize(event);
+    GGML_OP_STATS_ADD(sched_syncs, 1);
+    GGML_OP_STATS_ADD(sched_sync_us, ggml_time_us() - t0);
+}
+
 static enum ggml_status ggml_backend_sched_compute_splits(ggml_backend_sched_t sched) {
     GGML_ASSERT(sched);
     struct ggml_backend_sched_split * splits = sched->splits;
 
+    GGML_OP_STATS_ADD(sched_graphs, 1);
+
     ggml_tensor * prev_ids_tensor = nullptr;
     std::vector<int32_t> ids;
     std::vector<ggml_bitset_t> used_ids;
@@ -1877,9 +1903,10 @@ static enum ggml_status ggml_backend_sched_compute_splits(ggml_backend_sched_t s
         struct ggml_backend_sched_split * split = &splits[late_split];
         ggml_backend_t qb = sched->backends[splits[late_split - 1].backend_id];
         late_split = -1;
-        ggml_backend_event_synchronize(sched->host_ready_events[ggml_backend_sched_backend_id(sched, qb)]);
+        ggml_op_stats_event_sync(sched->host_ready_events[ggml_backend_sched_backend_id(sched, qb)]);
         enum ggml_status ec = ggml_backend_graph_compute_async(sched->backends[split->backend_id], &split->graph);
         qb->iface.host_gate_open(qb);
+        GGML_OP_STATS_ADD(sched_gate_opens, 1);
         return ec;
     };
 
@@ -1888,6 +1915,8 @@ static enum ggml_status ggml_backend_sched_compute_splits(ggml_backend_sched_t s
         int split_backend_id = split->backend_id;
