@@ -2024,7 +2061,9 @@ static enum ggml_status ggml_backend_sched_compute_splits(ggml_backend_sched_t s
                 } else if (ggml_backend_buffer_is_host(input->buffer) && split_backend->iface.set_tensor_async &&
                            input_cpy->buffer->buft == ggml_backend_get_default_buffer_type(split_backend)) {
