diff --git a/tests/test-backend-stats.cpp b/tests/test-backend-stats.cpp
new file mode 100644
index 000000000..bb086fec2
--- /dev/null
+++ b/tests/test-backend-stats.cpp
@@ -0,0 +1,422 @@
+// The scheduler and CUDA counters in ggml/src/ggml-stats.cpp move by known amounts.
+//
+// The scheduler only inserts input copies between backends with different buffer types, so a
+// CPU-only graph cannot be split (every CPU backend shares the CPU buffer type and pass 3 of
+// ggml_backend_sched_split_graph merges same-buft backends). The test therefore has:
+//   - a CPU-only smoke case that runs a graph and checks the scheduler graph/split counters, and
+//   - a GPU+CPU case that forces copies and splits and checks the sched_* and cuda_* counters.
+// The GPU case runs only when the GPU reports enough free VRAM (or GGML_OP_STATS_TEST_GPU=1),
+// so it does not disturb a busy GPU by default.
+#include "ggml.h"
+#include "ggml-alloc.h"
+#include "ggml-backend.h"
+#include "ggml-cuda.h"
+#include "ggml-stats.h"
+
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <random>
+#include <vector>
+
+static void set_gate(const char * name, const char * value) {
+#ifdef _WIN32
+    _putenv_s(name, value);
+#else
+    setenv(name, value, 1);
+#endif
+}
+
+// case-insensitive ASCII compare
+static bool ieq(const char * a, const char * b) {
+    while (*a != '\0' && *b != '\0') {
+        char ca = *a, cb = *b;
+        if (ca >= 'A' && ca <= 'Z') ca = (char) (ca - 'A' + 'a');
+        if (cb >= 'A' && cb <= 'Z') cb = (char) (cb - 'A' + 'a');
+        if (ca != cb) {
+            return false;
+        }
+        a++;
+        b++;
+    }
+    return *a == '\0' && *b == '\0';
+}
+
+static int check(const char * what, uint64_t got, uint64_t want) {
+    if (got != want) {
+        printf("FAILED %s: got %llu, want %llu\n", what, (unsigned long long) got, (unsigned long long) want);
+        return 1;
+    }
+    return 0;
+}
+
+#define DELTA(lo, hi, field) ((hi).field - (lo).field)
+
+// run one small graph on two CPU backends: exercises the per-graph scheduler counters
+static bool run_cpu_case(struct ggml_op_stats * before, struct ggml_op_stats * after) {
+    ggml_backend_t b0 = ggml_backend_init_by_type(GGML_BACKEND_DEVICE_TYPE_CPU, nullptr);
+    ggml_backend_t b1 = ggml_backend_init_by_type(GGML_BACKEND_DEVICE_TYPE_CPU, nullptr);
+    if (!b0 || !b1) {
+        return false;
+    }
+
+    const int n_embd = 128, n_tok = 4;
+    ggml_init_params wp = { ggml_tensor_overhead() * 8, nullptr, true };
+    ggml_context * ctx_w = ggml_init(wp);
+    ggml_tensor * w = ggml_new_tensor_2d(ctx_w, GGML_TYPE_F32, n_embd, n_embd);
+
+    ggml_init_params gp = { ggml_tensor_overhead() * 64 + ggml_graph_overhead(), nullptr, true };
+    ggml_context * ctx = ggml_init(gp);
+    ggml_tensor * x = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, n_embd, n_tok);
+    ggml_set_input(x);
+    ggml_tensor * y = ggml_mul_mat(ctx, w, x);
+    ggml_set_output(y);
+
+    ggml_cgraph * gf = ggml_new_graph(ctx);
+    ggml_build_forward_expand(gf, y);
+
+    ggml_backend_t backends[2] = { b0, b1 };
+    ggml_backend_sched_t sched = ggml_backend_sched_new(backends, nullptr, 2, 64, false, true);
+    ggml_backend_sched_reset(sched);
+    ggml_backend_sched_set_tensor_backend(sched, x, b0);
+    ggml_backend_sched_set_tensor_backend(sched, w, b0);
+    ggml_backend_sched_set_tensor_backend(sched, y, b1);
+    if (!ggml_backend_sched_alloc_graph(sched, gf)) {
+        printf("cpu alloc failed\n");
+        return false;
+    }
+
+    std::vector<float> w_in(n_embd * n_embd, 1.0f), x_in(n_embd * n_tok, 1.0f);
+    ggml_backend_tensor_set(w, w_in.data(), 0, ggml_nbytes(w));
+    ggml_backend_tensor_set(x, x_in.data(), 0, ggml_nbytes(x));
+
+    ggml_op_stats_reset();
+    *before = g_ggml_op_stats;
+    const enum ggml_status st = ggml_backend_sched_graph_compute(sched, gf);
+    *after = g_ggml_op_stats;
+
+    const bool ok = st == GGML_STATUS_SUCCESS;
+
+    ggml_backend_sched_free(sched);
+    ggml_free(ctx);
+    ggml_free(ctx_w);
+    ggml_backend_free(b0);
+    ggml_backend_free(b1);
+    return ok;
+}
+
+enum {
+    GPU_CASE_SKIP  = 0, // no GPU backend available
+    GPU_CASE_OK    = 1,
+    GPU_CASE_FAIL  = 2,
+    GPU_CASE_ALLOC = 3, // buffer allocation failed (environment)
+};
+
+// Three computes of the same graph. Pass 1 runs directly and warms up the CUDA graphs, pass 2
+// captures, instantiates and replays them, pass 3 only replays.
+#define N_PASSES 3
+
+// run x -> a=g*tanh(w_gpu*x) on GPU, b=w_cpu*a on CPU, y=g+b on GPU: forces copies on both
+// directions. bufts, when non-null, overrides the backends' buffer types (used to put the CPU
+// splits in the GPU's pinned host memory so the scheduler can defer them behind the host gate).
+static int run_gpu_case(ggml_backend_buffer_type_t * bufts,
+                        struct ggml_op_stats b[N_PASSES], struct ggml_op_stats a[N_PASSES]) {
+    ggml_backend_t gpu = ggml_backend_init_by_type(GGML_BACKEND_DEVICE_TYPE_GPU, nullptr);
+    ggml_backend_t cpu = ggml_backend_init_by_type(GGML_BACKEND_DEVICE_TYPE_CPU, nullptr);
+    if (!gpu || !cpu) {
+        if (gpu) {
+            ggml_backend_free(gpu);
+        }
+        if (cpu) {
+            ggml_backend_free(cpu);
+        }
+        return GPU_CASE_SKIP;
+    }
+
+#ifdef GGML_USE_CUDA
+    // the first GPU backend in registry order may not be CUDA, but the cuda_* counters are
+    if (!ggml_backend_is_cuda(gpu)) {
+        printf("gpu case skipped: first GPU backend is not CUDA\n");
+        ggml_backend_free(gpu);
+        ggml_backend_free(cpu);
+        return GPU_CASE_SKIP;
+    }
+#else
+    printf("gpu case skipped: built without CUDA\n");
+    ggml_backend_free(gpu);
+    ggml_backend_free(cpu);
+    return GPU_CASE_SKIP;
+#endif
+
+    const int n_layer = 2, n_embd = 128, n_tok = 4;
+
+    ggml_init_params wp = { ggml_tensor_overhead() * (2 * n_layer + 1), nullptr, true };
+    ggml_context * ctx_g = ggml_init(wp);
+    ggml_context * ctx_c = ggml_init(wp);
+    std::vector<ggml_tensor *> wg(n_layer), wc(n_layer);
+    for (int i = 0; i < n_layer; i++) {
+        wg[i] = ggml_new_tensor_2d(ctx_g, GGML_TYPE_F32, n_embd, n_embd);
+        wc[i] = ggml_new_tensor_2d(ctx_c, GGML_TYPE_F32, n_embd, n_embd);
+    }
+    ggml_backend_buffer_t buf_g = ggml_backend_alloc_ctx_tensors(ctx_g, gpu);
+    ggml_backend_buffer_t buf_c = ggml_backend_alloc_ctx_tensors(ctx_c, cpu);
+    ggml_backend_buffer_set_usage(buf_g, GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+    ggml_backend_buffer_set_usage(buf_c, GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+
+    std::mt19937 rng(42);
+    std::normal_distribution<float> nd(0.0f, 1.0f / std::sqrt((float) n_embd));
+    std::vector<float> w(n_embd * n_embd);
+    for (int i = 0; i < n_layer; i++) {
+        for (auto & v : w) v = nd(rng);
+        ggml_backend_tensor_set(wg[i], w.data(), 0, ggml_nbytes(wg[i]));
+        for (auto & v : w) v = nd(rng);
+        ggml_backend_tensor_set(wc[i], w.data(), 0, ggml_nbytes(wc[i]));
+    }
+
+    ggml_init_params gp = { ggml_tensor_overhead() * 4096 + ggml_graph_overhead(), nullptr, true };
+    ggml_context * ctx = ggml_init(gp);
+    ggml_tensor * x = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, n_embd, n_tok);
+    ggml_set_input(x);
+    ggml_tensor * h = x;
+    std::vector<ggml_tensor *> on_gpu;
+    for (int i = 0; i < n_layer; i++) {
+        ggml_tensor * g = ggml_tanh(ctx, ggml_mul_mat(ctx, wg[i], h));
+        ggml_tensor * c = ggml_mul_mat(ctx, wc[i], g);
+        h = ggml_add(ctx, g, c);
+        on_gpu.push_back(g->src[0]);
+        on_gpu.push_back(g);
+        on_gpu.push_back(h);
+    }
+    ggml_set_output(h);
+
+    ggml_cgraph * gf = ggml_new_graph(ctx);
+    ggml_build_forward_expand(gf, h);
+
+    ggml_backend_t backends[2] = { gpu, cpu };
+    ggml_backend_sched_t sched = ggml_backend_sched_new(backends, bufts, 2, 4096, false, true);
+    ggml_backend_sched_reset(sched);
+    for (ggml_tensor * t : on_gpu) {
+        ggml_backend_sched_set_tensor_backend(sched, t, gpu);
+    }
+    if (!ggml_backend_sched_alloc_graph(sched, gf)) {
+        printf("gpu alloc failed\n");
+        ggml_backend_sched_free(sched);
+        ggml_backend_buffer_free(buf_g);
+        ggml_backend_buffer_free(buf_c);
+        ggml_free(ctx);
+        ggml_free(ctx_g);
+        ggml_free(ctx_c);
+        ggml_backend_free(gpu);
+        ggml_backend_free(cpu);
+        return GPU_CASE_ALLOC;
+    }
+    std::vector<float> x_in(n_embd * n_tok, 1.0f);
+    ggml_backend_tensor_set(x, x_in.data(), 0, ggml_nbytes(x));
+
+    ggml_op_stats_reset();
+    bool ok = true;
+    for (int p = 0; p < N_PASSES; p++) {
+        b[p] = g_ggml_op_stats;
+        ok = ok && ggml_backend_sched_graph_compute(sched, gf) == GGML_STATUS_SUCCESS;
+        a[p] = g_ggml_op_stats;
+    }
+
+    ggml_backend_sched_free(sched);
+    ggml_backend_buffer_free(buf_g);
+    ggml_backend_buffer_free(buf_c);
+    ggml_free(ctx);
+    ggml_free(ctx_g);
+    ggml_free(ctx_c);
+    ggml_backend_free(gpu);
+    ggml_backend_free(cpu);
+    return ok ? GPU_CASE_OK : GPU_CASE_FAIL;
+}
+
+int main() {
+    // enable the gate before any compute: the stats module reads it once on first use
+    set_gate("GGML_OP_STATS", "1");
+    ggml_backend_load_all();
+
+    struct ggml_op_stats before = {}, after = {};
+
+    int fails = 0;
+
+    // CPU smoke case
+    if (!run_cpu_case(&before, &after)) {
+        printf("FAILED (cpu case did not run)\n");
+        return 1;
+    }
+    const uint64_t cpu_graphs = after.sched_graphs - before.sched_graphs;
+    const uint64_t cpu_splits = after.sched_splits - before.sched_splits;
+    printf("cpu stats: graphs=%llu splits=%llu\n", (unsigned long long) cpu_graphs, (unsigned long long) cpu_splits);
+    fails += check("cpu graphs", cpu_graphs, 1);
+    fails += check("cpu splits", cpu_splits, 1);
+
+    // the report block must not change the counters
+    ggml_op_stats_print("test");
+    fails += check("print is side-effect free", g_ggml_op_stats.sched_splits - after.sched_splits, 0);
+
+    // GPU case: run only when the GPU has room, so a busy GPU is left alone
+    const char * force = getenv("GGML_OP_STATS_TEST_GPU");
+    // "1", "yes" and "true" (any case) enable the GPU case; anything else set disables it
+    const bool forced   = force != nullptr && (ieq(force, "yes") || ieq(force, "true") || atoi(force) >= 1);
+    const bool disabled = force != nullptr && !forced;
+
+    size_t vram_free = 0, vram_total = 0;
+    ggml_backend_dev_t gpu_dev = ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_GPU);
+    if (gpu_dev) {
+        ggml_backend_dev_memory(gpu_dev, &vram_free, &vram_total);
+    }
+
+    const size_t vram_need = 512ull * 1024 * 1024;
+    if (disabled) {
+        printf("gpu case disabled (GGML_OP_STATS_TEST_GPU=%s)\n", force);
+    } else if (!forced && (!gpu_dev || vram_free < vram_need)) {
+        printf("gpu case skipped: no GPU or free VRAM %zu MiB < %zu MiB\n",
+               vram_free / 1024 / 1024, vram_need / 1024 / 1024);
+    } else {
+        struct ggml_op_stats b[N_PASSES] = {}, a[N_PASSES] = {};
+        const int rc = run_gpu_case(nullptr, b, a);
+        if (rc == GPU_CASE_SKIP) {
+            printf("gpu case skipped: no GPU backend\n");
+            return 0;
+        }
+        if (rc == GPU_CASE_FAIL || rc == GPU_CASE_ALLOC) {
+            printf("FAILED (gpu case did not run)\n");
+            return 1;
+        }
+
+        // the CUDA fast synchronize shortcut only exists for a single non-HIP/MUSA device
+        bool sync_fast_cuda = false;
+#ifdef GGML_USE_CUDA
+        sync_fast_cuda = gpu_dev != nullptr && ggml_backend_cuda_get_device_count() == 1 &&
+                         strncmp(ggml_backend_dev_name(gpu_dev), "CUDA", 4) == 0;
+#endif
+
+        // 5 splits, 5 input copies (x, the two GPU->host and two host->GPU handoffs), all F32 128x4
+        for (int p = 0; p < N_PASSES; p++) {
+            char what[64];
+            snprintf(what, sizeof(what), "plain pass%d", p + 1);
+            fails += check(what, DELTA(b[p], a[p], sched_graphs), 1);
+            snprintf(what, sizeof(what), "plain pass%d splits", p + 1);
+            fails += check(what, DELTA(b[p], a[p], sched_splits), 5);
+            snprintf(what, sizeof(what), "plain pass%d input_copies", p + 1);
+            fails += check(what, DELTA(b[p], a[p], sched_input_copies), 5);
+            snprintf(what, sizeof(what), "plain pass%d copy_bytes", p + 1);
+            fails += check(what, DELTA(b[p], a[p], sched_copy_bytes), 10240);
+            snprintf(what, sizeof(what), "plain pass%d sched_syncs", p + 1);
+            fails += check(what, DELTA(b[p], a[p], sched_syncs), 10);
+            snprintf(what, sizeof(what), "plain pass%d cuda_h2d", p + 1);
+            fails += check(what, DELTA(b[p], a[p], cuda_h2d_bytes), 4096);
+            snprintf(what, sizeof(what), "plain pass%d cuda_d2h", p + 1);
+            fails += check(what, DELTA(b[p], a[p], cuda_d2h_bytes), 4096);
+            snprintf(what, sizeof(what), "plain pass%d cuda_d2d", p + 1);
+            fails += check(what, DELTA(b[p], a[p], cuda_d2d_bytes), 0);
+            snprintf(what, sizeof(what), "plain pass%d cuda_sync_total", p + 1);
+            fails += check(what, DELTA(b[p], a[p], cuda_sync_waited) + DELTA(b[p], a[p], cuda_sync_fast), 6);
+            if (sync_fast_cuda) {
+                snprintf(what, sizeof(what), "plain pass%d cuda_sync_waited", p + 1);
+                fails += check(what, DELTA(b[p], a[p], cuda_sync_waited), 3);
+                snprintf(what, sizeof(what), "plain pass%d cuda_sync_fast", p + 1);
+                fails += check(what, DELTA(b[p], a[p], cuda_sync_fast), 3);
+            }
+            // no host split is eligible here: the CPU splits write into the CPU default buffer,
+            // not the GPU's pinned host buffer, so the next GPU split is not a queued host copy
+            snprintf(what, sizeof(what), "plain pass%d late_eligible", p + 1);
+            fails += check(what, DELTA(b[p], a[p], sched_late_eligible), 0);
+            snprintf(what, sizeof(what), "plain pass%d late_splits", p + 1);
+            fails += check(what, DELTA(b[p], a[p], sched_late_splits), 0);
+            snprintf(what, sizeof(what), "plain pass%d gate_waits", p + 1);
+            fails += check(what, DELTA(b[p], a[p], sched_gate_waits), 0);
+        }
+
+        // the 3 GPU splits have 2, 3 and 1 nodes; pass 2 captures all 3, so 6 nodes total
+        fails += check("plain pass1 cuda_ops", DELTA(b[0], a[0], cuda_ops), 6);
+        fails += check("plain pass2 cuda_ops", DELTA(b[1], a[1], cuda_ops), 6);
+        const bool graphs_on = DELTA(b[1], a[1], cuda_graph_captures) > 0;
+        if (graphs_on) {
+            fails += check("plain pass1 cuda_graph_captures", DELTA(b[0], a[0], cuda_graph_captures), 0);
+            fails += check("plain pass2 cuda_graph_captures", DELTA(b[1], a[1], cuda_graph_captures), 3);
+            fails += check("plain pass2 cuda_graph_capture_nodes", DELTA(b[1], a[1], cuda_graph_capture_nodes), 6);
+            fails += check("plain pass2 cuda_graph_instantiates", DELTA(b[1], a[1], cuda_graph_instantiates), 3);
+            fails += check("plain pass2 cuda_graph_updates", DELTA(b[1], a[1], cuda_graph_updates), 3);
+            fails += check("plain pass2 cuda_graph_replays", DELTA(b[1], a[1], cuda_graph_replays), 3);
+            fails += check("plain pass2 cuda_graph_evictions", DELTA(b[1], a[1], cuda_graph_evictions), 0);
+            fails += check("plain pass3 cuda_ops", DELTA(b[2], a[2], cuda_ops), 0);
+            fails += check("plain pass3 cuda_graph_captures", DELTA(b[2], a[2], cuda_graph_captures), 0);
+            fails += check("plain pass3 cuda_graph_replays", DELTA(b[2], a[2], cuda_graph_replays), 3);
+        }
+
+        // same graph, but the CPU split's tensors live in the GPU's pinned host memory: on pass 3
+        // the graphs are warm and instantiated, so the scheduler defers the two host splits
+        ggml_backend_buffer_type_t host_buft = ggml_backend_dev_host_buffer_type(gpu_dev);
+        if (host_buft == nullptr) {
+            printf("late case skipped: GPU has no host buffer type\n");
+        } else {
+            ggml_backend_buffer_type_t bufts[2] = { ggml_backend_dev_buffer_type(gpu_dev), host_buft };
+            struct ggml_op_stats lb[N_PASSES] = {}, la[N_PASSES] = {};
+            const int lrc = run_gpu_case(bufts, lb, la);
+            if (lrc == GPU_CASE_ALLOC) {
+                printf("late case skipped: pinned host alloc failed\n");
+                return 0;
+            }
+            if (lrc != GPU_CASE_OK) {
+                printf("FAILED (late case did not run)\n");
+                return 1;
+            }
+
+            const bool graphs_on = DELTA(lb[1], la[1], cuda_graph_captures) > 0;
+            for (int p = 0; p < N_PASSES; p++) {
+                char what[64];
+                snprintf(what, sizeof(what), "late pass%d splits", p + 1);
+                fails += check(what, DELTA(lb[p], la[p], sched_splits), 5);
+                snprintf(what, sizeof(what), "late pass%d late_eligible", p + 1);
+                fails += check(what, DELTA(lb[p], la[p], sched_late_eligible), 2);
+
+                // passes 1-2 defer nothing; pass 3 defers only once the graphs are warm.
+                // gate_waits, gate_opens and the cuda gate counters == late_splits here
+                const uint64_t defer = (p == N_PASSES - 1 && graphs_on) ? 2 : 0;
+                snprintf(what, sizeof(what), "late pass%d late_splits", p + 1);
+                fails += check(what, DELTA(lb[p], la[p], sched_late_splits), defer);
+                snprintf(what, sizeof(what), "late pass%d gate_waits", p + 1);
+                fails += check(what, DELTA(lb[p], la[p], sched_gate_waits), defer);
+                snprintf(what, sizeof(what), "late pass%d gate_opens", p + 1);
+                fails += check(what, DELTA(lb[p], la[p], sched_gate_opens), defer);
+                snprintf(what, sizeof(what), "late pass%d cuda_gate_waits", p + 1);
+                fails += check(what, DELTA(lb[p], la[p], cuda_gate_waits), defer);
+                snprintf(what, sizeof(what), "late pass%d cuda_gate_opens", p + 1);
+                fails += check(what, DELTA(lb[p], la[p], cuda_gate_opens), defer);
+            }
+
+            if (graphs_on) {
+                fails += check("late pass3 cuda_ops",     DELTA(lb[2], la[2], cuda_ops), 0);
+                fails += check("late pass3 cuda_graph_replays", DELTA(lb[2], la[2], cuda_graph_replays), 3);
+            }
+
+            printf("late stats: pass3 eligible=%llu splits=%llu gate_waits=%llu gate_opens=%llu"
+                   " cuda_gate_waits=%llu cuda_gate_opens=%llu\n",
+                   (unsigned long long) DELTA(lb[2], la[2], sched_late_eligible),
+                   (unsigned long long) DELTA(lb[2], la[2], sched_late_splits),
+                   (unsigned long long) DELTA(lb[2], la[2], sched_gate_waits),
+                   (unsigned long long) DELTA(lb[2], la[2], sched_gate_opens),
+                   (unsigned long long) DELTA(lb[2], la[2], cuda_gate_waits),
+                   (unsigned long long) DELTA(lb[2], la[2], cuda_gate_opens));
+        }
+
+        printf("gpu stats: pass1 splits=%llu copies=%llu bytes=%llu cuda_ops=%llu h2d=%llu"
+               " pass2 captures=%llu instantiates=%llu updates=%llu replays=%llu\n",
+               (unsigned long long) DELTA(b[0], a[0], sched_splits),
+               (unsigned long long) DELTA(b[0], a[0], sched_input_copies),
+               (unsigned long long) DELTA(b[0], a[0], sched_copy_bytes),
+               (unsigned long long) DELTA(b[0], a[0], cuda_ops),
+               (unsigned long long) DELTA(b[0], a[0], cuda_h2d_bytes),
+               (unsigned long long) DELTA(b[1], a[1], cuda_graph_captures),
+               (unsigned long long) DELTA(b[1], a[1], cuda_graph_instantiates),
+               (unsigned long long) DELTA(b[1], a[1], cuda_graph_updates),
+               (unsigned long long) DELTA(b[1], a[1], cuda_graph_replays));
+    }
+
+    printf(fails ? "FAILED (%d)\n" : "OK\n", fails);
+    return fails ? 1 : 0;
+}
