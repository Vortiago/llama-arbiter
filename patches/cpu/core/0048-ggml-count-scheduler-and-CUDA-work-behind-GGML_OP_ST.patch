index 000000000..68de56a80
--- /dev/null
+++ b/ggml/include/ggml-stats.h
@@ -0,0 +1,78 @@
+#pragma once
+
+// ggml operation statistics
+//
+// Pure process-lifetime counters for the scheduler and the CUDA backend. They are
+// disabled by default and enabled once by the env gate GGML_OP_STATS (>= 1). The
+// gate is read lazily on first use and cached, so no getenv runs on the hot path.
+//
+// Counters are process-global and unsynchronized. This is a debug/observability
+// tool, not a synchronization primitive: a multi-context embedder can drive more
+// than one scheduler or CUDA context at a time, and concurrent increments may
+// race and lose counts. Increments allocate nothing and take no locks. Add with
+// GGML_OP_STATS_ADD(), which is a no-op while the gate is off.
+//
+// ggml_op_stats_print() reports the delta since the previous call as one stable,
+// greppable block (prefix "ggml_op_stats:"). ggml_op_stats_graph_tick() drives the
+// optional "interval mode" (GGML_OP_STATS_INTERVAL=N graphs).
+
+#include <stdint.h>
+
+#include "ggml.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+struct ggml_op_stats {
+    // scheduler: ggml_backend_sched_compute_splits()
+    uint64_t sched_graphs;
+    uint64_t sched_splits;
+    uint64_t sched_input_copies;
+    uint64_t sched_copy_bytes;         // bytes copied into split backends (incl. expert bytes)
+    uint64_t sched_expert_copy_bytes;  // MoE: bytes copied by copy_experts()
+    uint64_t sched_syncs;              // backend / event synchronize calls
+    uint64_t sched_sync_us;            // wall time waited in those synchronize calls
+    uint64_t sched_late_eligible;      // can_compute_late() returned true
+    uint64_t sched_late_splits;        // eligible host split deferred behind the gate
+    uint64_t sched_gate_waits;         // host_gate_wait() queued a wait
+    uint64_t sched_gate_opens;         // host_gate_open() released the gate
+    uint64_t sched_gate_wait_us;       // wall time in host_gate_wait() calls that waited
+
+    // CUDA backend: ggml-cuda.cu / common.cuh
+    uint64_t cuda_h2d_bytes;           // set_tensor_async (and 2d)
+    uint64_t cuda_d2h_bytes;           // get_tensor_async (and 2d)
+    uint64_t cuda_d2d_bytes;           // cpy_tensor_async (and peer copy)
+    uint64_t cuda_ops;                 // ggml_cuda_compute_forward() calls
+    uint64_t cuda_sync_waited;         // context synchronize() that actually synchronized
+    uint64_t cuda_sync_fast;           // context synchronize() that returned early
+    uint64_t cuda_graph_captures;      // cudaStreamBeginCapture
+    uint64_t cuda_graph_capture_nodes; // nodes recorded during capture
+    uint64_t cuda_graph_instantiates;  // cudaGraphInstantiate
+    uint64_t cuda_graph_updates;       // ggml_cuda_graph_update_executable
+    uint64_t cuda_graph_replays;       // cudaGraphLaunch
+    uint64_t cuda_graph_evictions;     // LRU eviction in the graph cache
+    uint64_t cuda_gate_waits;          // host_gate_wait queued a stream wait
+    uint64_t cuda_gate_opens;          // host_gate_open published gate_waits
+};
+
+GGML_API struct ggml_op_stats g_ggml_op_stats;
+
+// the GGML_OP_STATS gate, read once
+GGML_API int  ggml_op_stats_enabled(void);
+
+// zero the counters and the delta baseline
+GGML_API void ggml_op_stats_reset(void);
+
+// print the delta since the previous print as one greppable block (no-op when disabled)
+GGML_API void ggml_op_stats_print(const char * tag);
+
+// register a computed graph; in interval mode (GGML_OP_STATS_INTERVAL=N) print every N graphs
+GGML_API void ggml_op_stats_graph_tick(void);
+
+#ifdef __cplusplus
+}
+#endif
+
+#define GGML_OP_STATS_ADD(field, val) \
+    do { if (ggml_op_stats_enabled()) { g_ggml_op_stats.field += (uint64_t) (val); } } while (0)
