diff --git a/ggml/src/ggml-stats.cpp b/ggml/src/ggml-stats.cpp
new file mode 100644
index 000000000..f0aad8cf9
--- /dev/null
+++ b/ggml/src/ggml-stats.cpp
@@ -0,0 +1,100 @@
+#include "ggml-stats.h"
+#include "ggml-impl.h"
+
+#include <inttypes.h>
+#include <stdlib.h>
+#include <string.h>
+
+struct ggml_op_stats g_ggml_op_stats = {};
+
+// baseline for the delta printed by ggml_op_stats_print()
+static struct ggml_op_stats g_ggml_op_stats_last = {};
+
+// interval mode: every N computed graphs print the delta (0 = off)
+static int64_t g_ggml_op_stats_graphs = 0;
+
+int ggml_op_stats_enabled(void) {
+    static const int enabled = []() -> int {
+        const char * v = getenv("GGML_OP_STATS");
+        return v != nullptr && atoi(v) >= 1;
+    }();
+    return enabled;
+}
+
+static int64_t ggml_op_stats_interval(void) {
+    static const int64_t interval = []() -> int64_t {
+        const char * v = getenv("GGML_OP_STATS_INTERVAL");
+        return v != nullptr ? (int64_t) atoll(v) : 0;
+    }();
+    return interval;
+}
+
+void ggml_op_stats_reset(void) {
+    memset(&g_ggml_op_stats, 0, sizeof(g_ggml_op_stats));
+    memset(&g_ggml_op_stats_last, 0, sizeof(g_ggml_op_stats_last));
+    g_ggml_op_stats_graphs = 0;
+}
+
+void ggml_op_stats_print(const char * tag) {
+    if (!ggml_op_stats_enabled()) {
+        return;
+    }
+
+    const struct ggml_op_stats * s = &g_ggml_op_stats;
+    const struct ggml_op_stats * p = &g_ggml_op_stats_last;
+
+    GGML_LOG_INFO("ggml_op_stats: tag=%s graphs=%" PRIu64 " splits=%" PRIu64
+            " input_copies=%" PRIu64 " copy_bytes=%" PRIu64 " expert_copy_bytes=%" PRIu64
+            " sched_syncs=%" PRIu64 " sched_sync_us=%" PRIu64 " late_eligible=%" PRIu64
+            " late_splits=%" PRIu64 " sched_gate_waits=%" PRIu64 " sched_gate_opens=%" PRIu64
+            " sched_gate_wait_us=%" PRIu64 "\n",
+            tag,
+            s->sched_graphs        - p->sched_graphs,
+            s->sched_splits        - p->sched_splits,
+            s->sched_input_copies  - p->sched_input_copies,
+            s->sched_copy_bytes    - p->sched_copy_bytes,
+            s->sched_expert_copy_bytes - p->sched_expert_copy_bytes,
+            s->sched_syncs         - p->sched_syncs,
+            s->sched_sync_us       - p->sched_sync_us,
+            s->sched_late_eligible - p->sched_late_eligible,
+            s->sched_late_splits   - p->sched_late_splits,
+            s->sched_gate_waits    - p->sched_gate_waits,
+            s->sched_gate_opens    - p->sched_gate_opens,
+            s->sched_gate_wait_us  - p->sched_gate_wait_us);
+
+    GGML_LOG_INFO("ggml_op_stats: tag=%s cuda_h2d_bytes=%" PRIu64 " cuda_d2h_bytes=%" PRIu64
+            " cuda_d2d_bytes=%" PRIu64 " cuda_ops=%" PRIu64 " cuda_sync_waited=%" PRIu64
+            " cuda_sync_fast=%" PRIu64 " cuda_graph_captures=%" PRIu64
+            " cuda_graph_capture_nodes=%" PRIu64 " cuda_graph_instantiates=%" PRIu64
+            " cuda_graph_updates=%" PRIu64 " cuda_graph_replays=%" PRIu64
+            " cuda_graph_evictions=%" PRIu64 " cuda_gate_waits=%" PRIu64
+            " cuda_gate_opens=%" PRIu64 "\n",
+            tag,
+            s->cuda_h2d_bytes        - p->cuda_h2d_bytes,
+            s->cuda_d2h_bytes        - p->cuda_d2h_bytes,
+            s->cuda_d2d_bytes        - p->cuda_d2d_bytes,
+            s->cuda_ops              - p->cuda_ops,
+            s->cuda_sync_waited      - p->cuda_sync_waited,
+            s->cuda_sync_fast        - p->cuda_sync_fast,
+            s->cuda_graph_captures   - p->cuda_graph_captures,
+            s->cuda_graph_capture_nodes - p->cuda_graph_capture_nodes,
+            s->cuda_graph_instantiates - p->cuda_graph_instantiates,
+            s->cuda_graph_updates    - p->cuda_graph_updates,
+            s->cuda_graph_replays    - p->cuda_graph_replays,
+            s->cuda_graph_evictions  - p->cuda_graph_evictions,
+            s->cuda_gate_waits       - p->cuda_gate_waits,
+            s->cuda_gate_opens       - p->cuda_gate_opens);
+
+    g_ggml_op_stats_last = g_ggml_op_stats;
+}
+
+void ggml_op_stats_graph_tick(void) {
+    if (!ggml_op_stats_enabled()) {
+        return;
+    }
+    const int64_t interval = ggml_op_stats_interval();
+    g_ggml_op_stats_graphs++;
+    if (interval > 0 && g_ggml_op_stats_graphs % interval == 0) {
+        ggml_op_stats_print("interval");
+    }
+}
