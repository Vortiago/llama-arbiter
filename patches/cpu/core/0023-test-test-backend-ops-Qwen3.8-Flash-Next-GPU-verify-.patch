From 136acc1db5d31963c76ed88d2cc93b1175cb298e Mon Sep 17 00:00:00 2001
From: Vortiago <atle@havso.net>
Date: Wed, 7 Oct 2026 16:13:53 +0200
Subject: [PATCH] test(test-backend-ops): Qwen3.8-Flash-Next GPU verify cases

Eval cases for gated_delta_net with three value heads a q/k head, the
layout of Qwen3.8-Flash-Next (48 value heads on 16 q/k heads), with KDA,
permuted inputs and state snapshots.

Perf cases at the model's GPU shapes: gated_delta_net at 1 and 4 tokens,
the dense Q8_0 weights on the card at 1 and 4 tokens, and the QSA
indexer in a 4-token window at 1K, 32K and 128K context.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01C6MCJC4HTKxvuGjKjqDuqQ
---
 tests/test-backend-ops.cpp | 26 ++++++++++++++++++++++++++
 1 file changed, 26 insertions(+)

diff --git a/tests/test-backend-ops.cpp b/tests/test-backend-ops.cpp
index 222da4c58..d8adc01ae 100644
--- a/tests/test-backend-ops.cpp
+++ b/tests/test-backend-ops.cpp
@@ -11838,6 +11838,12 @@ static std::vector<std::unique_ptr<test_case>> make_test_cases_eval() {
     test_cases.emplace_back(new test_gated_delta_net(GGML_TYPE_F32, 8, 128,  4, 1, 1, false, false, /*K=*/4));
     test_cases.emplace_back(new test_gated_delta_net(GGML_TYPE_F32, 4, 64,   4, 2, 1, false, true,  /*K=*/4));
     test_cases.emplace_back(new test_gated_delta_net(GGML_TYPE_F32, 8, 32,   4, 2, 2, false, true,  /*K=*/4));
+    // three value heads a q/k head, as in Qwen3.8-Flash-Next (48 value heads, 16 q/k heads)
+    test_cases.emplace_back(new test_gated_delta_net(GGML_TYPE_F32, 16, 128, 4, 1, 3));
+    test_cases.emplace_back(new test_gated_delta_net(GGML_TYPE_F32, 4, 32,   4, 2, 3, true));
+    test_cases.emplace_back(new test_gated_delta_net(GGML_TYPE_F32, 4, 32,   4, 2, 3, false, true));
+    test_cases.emplace_back(new test_gated_delta_net(GGML_TYPE_F32, 4, 64,   4, 1, 3, false, false, /*K=*/4));
+    test_cases.emplace_back(new test_gated_delta_net(GGML_TYPE_F32, 4, 64,   4, 2, 3, false, true,  /*K=*/4));
     // overflow: n_tokens > K — only the last K snapshots kept.
     test_cases.emplace_back(new test_gated_delta_net(GGML_TYPE_F32, 4, 32,   8, 1, 1, false, false, /*K=*/3));
     test_cases.emplace_back(new test_gated_delta_net(GGML_TYPE_F32, 4, 64,  16, 2, 1, false, false, /*K=*/4));
@@ -11910,6 +11916,23 @@ static std::vector<std::unique_ptr<test_case>> make_test_cases_perf() {
         test_cases.emplace_back(new test_mul_mat_id(GGML_TYPE_Q8_0, GGML_TYPE_F32, 512, 10, false, 2560, n,  640));
     }
 
+    // Qwen3.8-Flash-Next dense Q8_0 weights on the card, {rows, K}: hyper-connection up, down and
+    // inject, shared expert up and down, DeltaNet alpha, qkv, gate and out, attention q. 4 tokens
+    // is an MTP verify window, 1 a plain decode.
+    for (int n : {1, 4}) {
+        for (auto [m, k] : std::initializer_list<std::pair<int64_t, int64_t>>{
+                {10240, 320}, {320, 10240}, {4, 10240}, {640, 2560}, {2560, 640},
+                {48, 2560}, {10240, 2560}, {6144, 2560}, {2560, 6144}, {12288, 2560}}) {
+            test_cases.emplace_back(new test_mul_mat(GGML_TYPE_Q8_0, GGML_TYPE_F32, m, n, k, {1, 1}, {1, 1}));
+        }
+    }
+
+    // Qwen3.8-Flash-Next QSA indexer in a 4-token verify window: 4 heads, F32 pooled keys, one
+    // pooled key per 4 cells (1K, 32K and 128K context)
+    for (int kv : {256, 8192, 32768}) {
+        test_cases.emplace_back(new test_lightning_indexer(128, 4, kv, 4, 1, 1, GGML_TYPE_F32));
+    }
+
     // SWIGLU at a 27B-class FFN width, fused [gate|up] vs split operands
     // note: same bytes either way, so a backend that indexes them differently shows it here
     for (ggml_type type : {GGML_TYPE_F16, GGML_TYPE_F32, GGML_TYPE_BF16}) {
@@ -12370,6 +12393,9 @@ static std::vector<std::unique_ptr<test_case>> make_test_cases_perf() {
     test_cases.emplace_back(new test_gated_delta_net(GGML_TYPE_F32, 32, 128, 1, 1));   // Qwen3.5-like: 32 heads, d=128
     test_cases.emplace_back(new test_gated_delta_net(GGML_TYPE_F32, 16, 64,  1, 1));   // smaller model
     test_cases.emplace_back(new test_gated_delta_net(GGML_TYPE_F32, 32, 128, 1, 1, 1, false, true)); // KDA
+    // Qwen3.8-Flash-Next: 48 value heads on 16 q/k heads, a decode token and a 4-token MTP verify
+    test_cases.emplace_back(new test_gated_delta_net(GGML_TYPE_F32, 16, 128, 1, 1, 3));
+    test_cases.emplace_back(new test_gated_delta_net(GGML_TYPE_F32, 16, 128, 4, 1, 3));
     // PP: n_seq_tokens=64,256 (prompt processing)
     test_cases.emplace_back(new test_gated_delta_net(GGML_TYPE_F32, 32, 128, 64, 1));  // PP-64
     test_cases.emplace_back(new test_gated_delta_net(GGML_TYPE_F32, 32, 128, 256, 1)); // PP-256
