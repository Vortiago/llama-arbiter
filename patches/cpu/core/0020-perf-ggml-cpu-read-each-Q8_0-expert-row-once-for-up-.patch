 // ref: https://github.com/ggml-org/llama.cpp/pull/14146#issuecomment-2972561679
 // quants.c
 #define quantize_row_q8_K_generic quantize_row_q8_K
@@ -169,6 +172,7 @@
 #define ggml_gemm_q8_0_4x4_q8_0_generic ggml_gemm_q8_0_4x4_q8_0
 #define ggml_gemm_q8_0_4x8_q8_0_generic ggml_gemm_q8_0_4x8_q8_0
 #elif defined(__loongarch64)
+#define ggml_vec_dot_q8_0_q8_0_ncols_generic ggml_vec_dot_q8_0_q8_0_ncols
 // quants.c
 #define quantize_row_q8_K_generic quantize_row_q8_K
 #define ggml_vec_dot_tq1_0_q8_K_generic ggml_vec_dot_tq1_0_q8_K
@@ -220,6 +224,7 @@
 #define ggml_gemm_q8_0_4x4_q8_0_generic ggml_gemm_q8_0_4x4_q8_0
 #define ggml_gemm_q8_0_4x8_q8_0_generic ggml_gemm_q8_0_4x8_q8_0
 #elif defined(__riscv)
+#define ggml_vec_dot_q8_0_q8_0_ncols_generic ggml_vec_dot_q8_0_q8_0_ncols
 // quants.c
 #define ggml_vec_dot_nvfp4_q8_0_generic ggml_vec_dot_nvfp4_q8_0
 #define ggml_vec_dot_q2_0_q8_0_generic ggml_vec_dot_q2_0_q8_0
@@ -264,6 +269,7 @@
 #define ggml_gemm_q8_0_4x4_q8_0_generic ggml_gemm_q8_0_4x4_q8_0
 #define ggml_gemm_q8_0_4x8_q8_0_generic ggml_gemm_q8_0_4x8_q8_0
 #elif defined(__s390x__)
+#define ggml_vec_dot_q8_0_q8_0_ncols_generic ggml_vec_dot_q8_0_q8_0_ncols
 // quants.c
 #define quantize_row_q8_K_generic quantize_row_q8_K
 #define ggml_vec_dot_nvfp4_q8_0_generic ggml_vec_dot_nvfp4_q8_0
@@ -317,6 +323,7 @@
 #define ggml_gemm_q8_0_4x4_q8_0_generic ggml_gemm_q8_0_4x4_q8_0
 #define ggml_gemm_q8_0_4x8_q8_0_generic ggml_gemm_q8_0_4x8_q8_0
 #elif defined(__wasm__)
+#define ggml_vec_dot_q8_0_q8_0_ncols_generic ggml_vec_dot_q8_0_q8_0_ncols
 // quants.c
 #define ggml_vec_dot_tq1_0_q8_K_generic ggml_vec_dot_tq1_0_q8_K
 #define ggml_vec_dot_tq2_0_q8_K_generic ggml_vec_dot_tq2_0_q8_K
diff --git a/ggml/src/ggml-cpu/arch/x86/quants.c b/ggml/src/ggml-cpu/arch/x86/quants.c
index ea54cfe44..76d244345 100644
--- a/ggml/src/ggml-cpu/arch/x86/quants.c
+++ b/ggml/src/ggml-cpu/arch/x86/quants.c
@@ -1373,6 +1373,77 @@ void ggml_vec_dot_q8_0_q8_0(int n, float * GGML_RESTRICT s, size_t bs, const voi
     *s = sumf;
 }
 
+#if defined(__AVX2__)
+#ifndef Q8_0_NCOLS_PREFETCH
+#define Q8_0_NCOLS_PREFETCH 4096
+#endif
+
+// nc (1 to 4) columns of ggml_vec_dot_q8_0_q8_0 at once: each column keeps its own accumulator,
+// block order and horizontal sum, so the results match it bit for bit. Each x block is loaded
+// once for all columns, and the nc FMA chains run side by side.
+static inline void ggml_vec_dot_q8_0_q8_0_cols(int nb, float * GGML_RESTRICT s, size_t bs,
+        const block_q8_0 * GGML_RESTRICT x, const block_q8_0 * const * y, const int nc) {
+    __m256 acc[4] = { _mm256_setzero_ps(), _mm256_setzero_ps(), _mm256_setzero_ps(), _mm256_setzero_ps() };
+
+    for (int ib = 0; ib < nb; ++ib) {
+        // x streams from memory: fetch Q8_0_NCOLS_PREFETCH bytes ahead, about one line per
+        // block, so the hardware prefetcher's stop at each 4 KiB page does not stall it
+        _mm_prefetch((const char *) &x[ib] + Q8_0_NCOLS_PREFETCH, _MM_HINT_T0);
+
+        const float  dx = GGML_CPU_FP16_TO_FP32(x[ib].d);
+        const __m256i qx = _mm256_loadu_si256((const __m256i *) x[ib].qs);
+
+        for (int j = 0; j < nc; ++j) {
+            const __m256  d  = _mm256_set1_ps(dx * GGML_CPU_FP16_TO_FP32(y[j][ib].d));
+            const __m256i qy = _mm256_loadu_si256((const __m256i *) y[j][ib].qs);
+
+            acc[j] = _mm256_fmadd_ps(d, mul_sum_i8_pairs_float(qx, qy), acc[j]);
+        }
+    }
+
+    for (int j = 0; j < nc; ++j) {
+        s[j*bs] = hsum_float_8(acc[j]);
+    }
+}
+#endif
+
+#if defined(__AVX2__)
+// nr rows of x against the same nc columns, nc constant after inlining
+static inline void ggml_vec_dot_q8_0_q8_0_rows(int nb, float * GGML_RESTRICT s, size_t bs,
+        const char * GGML_RESTRICT x, size_t bx, int nr, const block_q8_0 * const * y, const int nc) {
+    for (int r = 0; r < nr; ++r) {
+        ggml_vec_dot_q8_0_q8_0_cols(nb, s + r, bs, (const block_q8_0 *) (x + r*bx), y, nc);
+    }
+}
+#endif
+
+void ggml_vec_dot_q8_0_q8_0_ncols(int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT vx, size_t bx, int nr, const void * const * vy, int nc) {
+    assert(n % QK8_0 == 0);
+
+#if defined(__AVX2__)
+    const int nb = n / QK8_0;
+    const block_q8_0 * const * y = (const block_q8_0 * const *) vy;
+
+    int j = 0;
+    for (; j + 4 <= nc; j += 4) {
+        ggml_vec_dot_q8_0_q8_0_rows(nb, s + j*bs, bs, vx, bx, nr, y + j, 4);
+    }
+    // the compiler unrolls each case with a constant column count
+    switch (nc - j) {
+        case 3: ggml_vec_dot_q8_0_q8_0_rows(nb, s + j*bs, bs, vx, bx, nr, y + j, 3); break;
+        case 2: ggml_vec_dot_q8_0_q8_0_rows(nb, s + j*bs, bs, vx, bx, nr, y + j, 2); break;
+        case 1: ggml_vec_dot_q8_0_q8_0_rows(nb, s + j*bs, bs, vx, bx, nr, y + j, 1); break;
+        default: break;
+    }
+#else
+    for (int r = 0; r < nr; ++r) {
+        for (int j = 0; j < nc; ++j) {
+            ggml_vec_dot_q8_0_q8_0(n, s + j*bs + r, 0, (const char *) vx + r*bx, 0, vy[j], 0, 1);
+        }
+    }
+#endif
+}
+
 void ggml_vec_dot_tq1_0_q8_K(int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT vx, size_t bx, const void * GGML_RESTRICT vy, size_t by, int nrc) {
     assert(nrc == 1);
     UNUSED(nrc);
diff --git a/ggml/src/ggml-cpu/ggml-cpu.c b/ggml/src/ggml-cpu/ggml-cpu.c
index 5278614a6..bdbb94e90 100644
--- a/ggml/src/ggml-cpu/ggml-cpu.c
+++ b/ggml/src/ggml-cpu/ggml-cpu.c
@@ -1530,6 +1530,44 @@ static void ggml_compute_forward_mul_mat_id_one_chunk(
     const int64_t blck_0 = 16;
     const int64_t blck_1 = 16;
 
+    if (type == GGML_TYPE_Q8_0 && vec_dot_type == GGML_TYPE_Q8_0) {
+        // Up to 4 src1 columns per pass over the src0 rows, so a pass reads each src0 row
+        // once for all its columns. ggml_vec_dot_q8_0_q8_0_ncols is bit-exact with vec_dot.
+        float tmp[4*16];
+
+        for (int64_t iir1 = ir1_start; iir1 < ir1_end; iir1 += 4) {
+            const int nc = (int) MIN(4, ir1_end - iir1);
+
+            const void * src1_cols[4];
+            float      * dst_cols[4];
+
+            for (int j = 0; j < nc; ++j) {
+                const struct mmid_row_mapping row_mapping = MMID_MATRIX_ROW(cur_a, iir1 + j);
+
+                const int64_t i11 = row_mapping.i1 % ne11;
+                const int64_t i12 = row_mapping.i2;
+
+                // the src1 row as in the general path below
+                src1_cols[j] = (const char *) wdata +
+                    (src1_cont || src1->type != vec_dot_type
+                    ? (i11      + i12*ne11)*row_size
+                    : (i11*nb11 + i12*nb12));
+                dst_cols[j]  = (float *) ((char *) dst->data + (row_mapping.i1*nb1 + i12*nb2));
+            }
+
+            for (int64_t iir0 = ir0_start; iir0 < ir0_end; iir0 += blck_0) {
+                const int64_t ir0_lim = MIN(iir0 + blck_0, ir0_end);
+
+                ggml_vec_dot_q8_0_q8_0_ncols(ne00, tmp, 16, src0_cur + iir0*nb01, nb01, (int) (ir0_lim - iir0), src1_cols, nc);
+
+                for (int j = 0; j < nc; ++j) {
+                    memcpy(&dst_cols[j][iir0], &tmp[j*16], (ir0_lim - iir0)*sizeof(float));
+                }
+            }
+        }
+        return;
+    }
+
     float tmp[16];
 
     for (int64_t iir1 = ir1_start; iir1 < ir1_end; iir1 += blck_1) {
diff --git a/ggml/src/ggml-cpu/quants.c b/ggml/src/ggml-cpu/quants.c
index 5e36459f8..d3bd8ab9d 100644
--- a/ggml/src/ggml-cpu/quants.c
+++ b/ggml/src/ggml-cpu/quants.c
@@ -478,6 +478,14 @@ void ggml_vec_dot_q8_0_q8_0_generic(int n, float * GGML_RESTRICT s, size_t bs, c
     *s = sumf;
 }
 
+void ggml_vec_dot_q8_0_q8_0_ncols_generic(int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT vx, size_t bx, int nr, const void * const * vy, int nc) {
+    for (int r = 0; r < nr; ++r) {
+        for (int j = 0; j < nc; ++j) {
+            ggml_vec_dot_q8_0_q8_0(n, s + j*bs + r, 0, (const char *) vx + r*bx, 0, vy[j], 0, 1);
+        }
+    }
+}
+
 void ggml_vec_dot_tq1_0_q8_K_generic(int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT vx, size_t bx, const void * GGML_RESTRICT vy, size_t by, int nrc) {
     assert(nrc == 1);
     UNUSED(nrc);
