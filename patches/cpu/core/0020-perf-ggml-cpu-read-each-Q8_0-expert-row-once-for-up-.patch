 ggml/src/ggml-cpu/arch/x86/quants.c | 71 +++++++++++++++++++++++++++++
 ggml/src/ggml-cpu/ggml-cpu.c        | 38 +++++++++++++++
 ggml/src/ggml-cpu/quants.c          |  8 ++++
 ggml/src/ggml-cpu/quants.h          |  4 ++
