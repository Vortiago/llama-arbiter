     GGML_ASSERT(params->wsize >= (size_t) ((char *) wdata_cur - (char *) params->wdata));
 
@@ -2248,9 +2343,12 @@ static void ggml_compute_forward_moe_ffn(
         }
         active[n_as] = n;
 
-        // every thread starts at unit ith
-        atomic_store_explicit((atomic_int *) next_unit[0], nth, memory_order_relaxed);
-        atomic_store_explicit((atomic_int *) next_unit[1], nth, memory_order_relaxed);
+        // every thread starts at unit ig of its group
+        for (int k = 0; k < ng; ++k) {
+            const int nthk = (nth - k + ng - 1)/ng;
+            atomic_store_explicit((atomic_int *) next_unit[k],                       (int) (n*nb_ug*k/ng) + nthk, memory_order_relaxed);
+            atomic_store_explicit((atomic_int *) next_unit[GGML_NUMA_MAX_NODES + k], (int) (n*nb_dn*k/ng) + nthk, memory_order_relaxed);
+        }
     }
 
     ggml_barrier(params->threadpool);
@@ -2260,14 +2358,14 @@ static void ggml_compute_forward_moe_ffn(
     // 2. gate, up, SWIGLU and down's quantization. The units are (expert, block of rows) in
