@@ -2207,8 +2291,19 @@ static void ggml_compute_forward_moe_ffn(
     struct mmid_row_mapping * matrix_rows =
         incr_ptr_aligned(&wdata_cur, n_as*ids->ne[0]*ids->ne[1]*sizeof(struct mmid_row_mapping), CACHE_LINE_SIZE);
     int32_t * active = incr_ptr_aligned(&wdata_cur, (n_as + 1)*sizeof(int32_t), CACHE_LINE_SIZE);
-    // the next unit of steps 2 and 3, one cache line each
-    char (*next_unit)[CACHE_LINE_SIZE] = incr_ptr_aligned(&wdata_cur, 2*CACHE_LINE_SIZE, CACHE_LINE_SIZE);
+    // the next unit of steps 2 and 3 for each group of threads, one cache line each
+    char (*next_unit)[CACHE_LINE_SIZE] = incr_ptr_aligned(&wdata_cur, 2*GGML_NUMA_MAX_NODES*CACHE_LINE_SIZE, CACHE_LINE_SIZE);
+
+    // The threads work in groups, one per node (ggml_numa_n_groups). Group grp takes the units
+    // [n*grp/ng, n*(grp+1)/ng) of a step from its own counter, so no counter moves between nodes.
