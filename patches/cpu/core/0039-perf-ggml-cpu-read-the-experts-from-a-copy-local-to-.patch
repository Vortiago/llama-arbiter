+#if defined(_POSIX_MAPPED_FILES) && defined(__linux__)
+static void * llama_cpu_proc_address(const char * name) {
+    auto * dev = ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_CPU);
