+// NUMA mirrors. A mirror is a second copy of a range of memory whose pages are on one node,
+// for example a model file mapped again from a copy of the file that node's page cache holds.
+// A thread whose CPUs are all on one node reads the weights of MUL_MAT_ID from the copy of its
+// node (ggml_numa_local). The copy has the same bytes, so the results do not change.
+
+#define GGML_NUMA_MAX_MIRRORS 64
+
+struct ggml_numa_mirror {
+    const char * base;
+    size_t       size; // 0: a free slot
+    int          node;
+    const char * copy;
+};
+
+static struct ggml_numa_mirror g_numa_mirrors[GGML_NUMA_MAX_MIRRORS];
+static atomic_int              g_numa_n_mirrors; // slots in use or freed, a prefix of g_numa_mirrors
+
+#if defined(__gnu_linux__)
+// the node of this thread's CPUs, or -1 when they are on several nodes or it is not known
+static __thread int ggml_numa_thread_node = -1;
+#endif
+
+void ggml_numa_mirror_set(const void * base, size_t size, int node, const void * copy) {
+    GGML_ASSERT(node >= 0 && node < GGML_NUMA_MAX_NODES && size > 0);
+    ggml_critical_section_start();
+    int n = atomic_load_explicit(&g_numa_n_mirrors, memory_order_relaxed);
+    int i = 0;
+    while (i < n && g_numa_mirrors[i].size != 0) {
+        i++;
+    }
+    GGML_ASSERT(i < GGML_NUMA_MAX_MIRRORS);
+    g_numa_mirrors[i] = (struct ggml_numa_mirror) { (const char *) base, size, node, (const char *) copy };
+    if (i == n) {
+        atomic_store_explicit(&g_numa_n_mirrors, n + 1, memory_order_release);
+    }
+    ggml_critical_section_end();
+}
+
+// forget the mirrors of every range that starts in [base, base + size)
+void ggml_numa_mirror_clear(const void * base, size_t size) {
+    ggml_critical_section_start();
+    const int n = atomic_load_explicit(&g_numa_n_mirrors, memory_order_relaxed);
+    for (int i = 0; i < n; ++i) {
+        struct ggml_numa_mirror * m = &g_numa_mirrors[i];
+        if (m->size != 0 && m->base >= (const char *) base && m->base < (const char *) base + size) {
+            m->size = 0;
+        }
+    }
+    ggml_critical_section_end();
+}
+
+// p, or the address of the same byte in the copy local to this thread's node
+static inline const char * ggml_numa_local(const char * p) {
+#if defined(__gnu_linux__)
+    const int node = ggml_numa_thread_node;
+    if (node < 0) {
+        return p;
+    }
+    const int n = atomic_load_explicit(&g_numa_n_mirrors, memory_order_acquire);
+    for (int i = 0; i < n; ++i) {
+        const struct ggml_numa_mirror * m = &g_numa_mirrors[i];
+        if (m->node == node && p >= m->base && p < m->base + m->size) {
+            return m->copy + (p - m->base);
+        }
+    }
+#endif
+    return p;
+}
+
+// The threads of a graph as groups, one per node: GGML_NUMA_STRATEGY_DISTRIBUTE puts thread
+// ith on node ith % n_nodes. One group otherwise.
+static int ggml_numa_n_groups(int nth) {
+    if (g_state.numa.numa_strategy == GGML_NUMA_STRATEGY_DISTRIBUTE && g_state.numa.n_nodes > 1) {
+        return MIN((int) g_state.numa.n_nodes, nth);
+    }
+    return 1;
+}
