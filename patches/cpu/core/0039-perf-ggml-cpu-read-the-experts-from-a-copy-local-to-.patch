 struct llama_mmap::impl {
 #ifdef _POSIX_MAPPED_FILES
     std::vector<std::pair<size_t, size_t>> mapped_fragments;
 
+    // Copies of the file whose pages are on other nodes, mapped whole: (node, address).
+    // LLAMA_NUMA_MIRROR lists them as node:from=to entries separated by commas. A file whose
+    // path starts with from has its copy for that node at the same path under to, for example
+    // LLAMA_NUMA_MIRROR=1:/mnt/nvme/models/=/mnt/nvme/models-node1/
+    std::vector<std::pair<int, void *>> mirrors;
+
+#ifdef __linux__
+    void mirrors_init(int fd) {
+        const char * env = getenv("LLAMA_NUMA_MIRROR");
+        if (env == nullptr || *env == '\0') {
+            return;
+        }
+        char path[4096];
+        const ssize_t n = readlink(format("/proc/self/fd/%d", fd).c_str(), path, sizeof(path) - 1);
+        if (n <= 0) {
+            return;
+        }
+        path[n] = '\0';
+        const std::string fname = path;
+
+        std::string list = env;
+        size_t pos = 0;
+        while (pos <= list.size()) {
+            size_t end = list.find(',', pos);
+            if (end == std::string::npos) {
+                end = list.size();
+            }
+            const std::string entry = list.substr(pos, end - pos);
+            pos = end + 1;
+
+            const size_t colon = entry.find(':');
+            const size_t eq    = entry.find('=');
+            if (colon == std::string::npos || eq == std::string::npos || eq < colon) {
+                LLAMA_LOG_WARN("%s: LLAMA_NUMA_MIRROR entry '%s' is not node:from=to\n", __func__, entry.c_str());
+                continue;
+            }
+            const int         node = atoi(entry.substr(0, colon).c_str());
+            const std::string from = entry.substr(colon + 1, eq - colon - 1);
+            const std::string to   = entry.substr(eq + 1);
+            if (from.empty() || fname.compare(0, from.size(), from) != 0) {
+                continue;
+            }
+            const std::string copy = to + fname.substr(from.size());
+
+            const int cfd = open(copy.c_str(), O_RDONLY);
+            if (cfd < 0) {
+                LLAMA_LOG_WARN("%s: cannot open %s: %s\n", __func__, copy.c_str(), strerror(errno));
+                continue;
+            }
+            struct stat st;
+            if (fstat(cfd, &st) != 0 || (size_t) st.st_size != size) {
+                LLAMA_LOG_WARN("%s: %s is not the size of %s\n", __func__, copy.c_str(), fname.c_str());
+                close(cfd);
+                continue;
+            }
+            void * caddr = mmap(NULL, size, PROT_READ, MAP_SHARED, cfd, 0);
+            close(cfd);
+            if (caddr == MAP_FAILED) {
+                LLAMA_LOG_WARN("%s: mmap of %s failed: %s\n", __func__, copy.c_str(), strerror(errno));
+                continue;
+            }
+            // no readahead: a fault reads one page
+            posix_madvise(caddr, size, POSIX_MADV_RANDOM);
+            LLAMA_LOG_INFO("%s: node %d reads %s for %s\n", __func__, node, copy.c_str(), fname.c_str());
+            mirrors.emplace_back(node, caddr);
+        }
+        mirrors_publish();
+    }
+
+    // tell the CPU backend about the copies of the fragments still mapped
+    void mirrors_publish() {
+        if (mirrors.empty()) {
+            return;
+        }
+        auto * mirror_set   = (decltype(ggml_numa_mirror_set)   *) llama_cpu_proc_address("ggml_backend_cpu_numa_mirror_set");
+        auto * mirror_clear = (decltype(ggml_numa_mirror_clear) *) llama_cpu_proc_address("ggml_backend_cpu_numa_mirror_clear");
+        if (mirror_set == nullptr || mirror_clear == nullptr) {
+            return;
+        }
+        mirror_clear(addr, size);
+        for (const auto & frag : mapped_fragments) {
+            for (const auto & [node, caddr] : mirrors) {
+                mirror_set((char *) addr + frag.first, frag.second - frag.first, node, (char *) caddr + frag.first);
+            }
+        }
+    }
+
+    void mirrors_free() {
+        if (mirrors.empty()) {
+            return;
+        }
+        auto * mirror_clear = (decltype(ggml_numa_mirror_clear) *) llama_cpu_proc_address("ggml_backend_cpu_numa_mirror_clear");
+        if (mirror_clear != nullptr) {
+            mirror_clear(addr, size);
+        }
+        for (const auto & [node, caddr] : mirrors) {
+            munmap(caddr, size);
+        }
+        mirrors.clear();
+    }
+#else
+    void mirrors_init(int) {}
+    void mirrors_publish() {}
+    void mirrors_free() {}
