From 0084821ea93c8963e6288d324899168f3fdbecb7 Mon Sep 17 00:00:00 2001
From: Vortiago <atle@havso.net>
Date: Wed, 14 Oct 2026 04:32:13 +0200
Subject: [PATCH] perf(ggml-cpu): two Q8_0 expert rows per 512-bit register in
 the multi-column dot

At 4 tokens an expert the 256-bit multi-column dot (core/0020) is
compute bound on Skylake-SP: a one-layer bench on the real experts with
10 experts of 4 tokens each takes as long as 20 experts of 2 (1234 us
against 1236 us, 42 GB/s). Its 256-bit integer and FMA work runs on
ports 0 and 1 only and leaves port 5 idle.

With AVX-512BW, ggml_vec_dot_q8_0_q8_0_ncols now puts two rows of x in
one register: lanes 0-7 hold row r's accumulator of the 256-bit path,
lanes 8-15 row r + 1's. Each lane gets the same integers (|x|, y
negated where x < 0, maddubs, madd), the same scale dx*dy rounded to
float, and the same FMAs in block order, and each half ends in the same
hsum_float_8. The y scales are converted to float once per call. An odd
last row, or rows longer than 512 blocks, take the 256-bit path.

Exact: on one layer's real experts, 400 steps of 1 to 16 tokens with
random and shared expert sets, fused and lone MUL_MAT_ID, the hashes of
all 108.8 million outputs equal the base build's.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01C6MCJC4HTKxvuGjKjqDuqQ
---
 ggml/src/ggml-cpu/arch/x86/quants.c | 84 +++++++++++++++++++++++++++++
 1 file changed, 84 insertions(+)

diff --git a/ggml/src/ggml-cpu/arch/x86/quants.c b/ggml/src/ggml-cpu/arch/x86/quants.c
index 76d244345..1dbbed97b 100644
--- a/ggml/src/ggml-cpu/arch/x86/quants.c
+++ b/ggml/src/ggml-cpu/arch/x86/quants.c
@@ -1417,6 +1417,66 @@ static inline void ggml_vec_dot_q8_0_q8_0_rows(int nb, float * GGML_RESTRICT s,
 }
 #endif
 
+#if defined(__AVX512BW__)
+// Max blocks a row for the AVX-512 path below (its y scales live on the stack).
+#define Q8_0_NCOLS_512_MAX_NB 512
+
+// Two rows of x (r and r + 1) against nc columns, one 512-bit register per column: lanes 0-7
+// carry row r's accumulator of the 256-bit path above, lanes 8-15 row r + 1's. Each lane sees
+// the same integers (|x| and y negated where x < 0, maddubs, madd), the same scale
+// dx*dy rounded to float, and the same FMAs in block order, and each half ends in the same
+// hsum_float_8, so the results match vec_dot bit for bit. Port 5 takes half of the 512-bit
+// work, which on Skylake-SP the 256-bit path leaves idle. dy holds the y scales as float,
+// [nb][4].
+static inline void ggml_vec_dot_q8_0_q8_0_rows2(int nb, float * GGML_RESTRICT s, size_t bs,
+        const block_q8_0 * GGML_RESTRICT x0, const block_q8_0 * GGML_RESTRICT x1,
+        const block_q8_0 * const * y, const float * GGML_RESTRICT dy, const int nc) {
+    __m512 acc[4] = { _mm512_setzero_ps(), _mm512_setzero_ps(), _mm512_setzero_ps(), _mm512_setzero_ps() };
+    const __m512i zero = _mm512_setzero_si512();
+    const __m512i ones = _mm512_set1_epi16(1);
+
+    for (int ib = 0; ib < nb; ++ib) {
+        _mm_prefetch((const char *) &x0[ib] + Q8_0_NCOLS_PREFETCH, _MM_HINT_T0);
+        _mm_prefetch((const char *) &x1[ib] + Q8_0_NCOLS_PREFETCH, _MM_HINT_T0);
+
+        const __m512 dx = _mm512_castpd_ps(_mm512_insertf64x4(
+            _mm512_castps_pd(_mm512_set1_ps(GGML_CPU_FP16_TO_FP32(x0[ib].d))),
+            _mm256_castps_pd(_mm256_set1_ps(GGML_CPU_FP16_TO_FP32(x1[ib].d))), 1));
+        const __m512i qx = _mm512_inserti64x4(
+            _mm512_castsi256_si512(_mm256_loadu_si256((const __m256i *) x0[ib].qs)),
+            _mm256_loadu_si256((const __m256i *) x1[ib].qs), 1);
+        const __m512i   ax  = _mm512_abs_epi8(qx);
+        const __mmask64 neg = _mm512_movepi8_mask(qx);
+
+        for (int j = 0; j < nc; ++j) {
+            const __m512i qy = _mm512_broadcast_i64x4(_mm256_loadu_si256((const __m256i *) y[j][ib].qs));
+            const __m512i sy = _mm512_mask_sub_epi8(qy, neg, zero, qy);
+            const __m512  q  = _mm512_cvtepi32_ps(_mm512_madd_epi16(ones, _mm512_maddubs_epi16(ax, sy)));
+            const __m512  d  = _mm512_mul_ps(dx, _mm512_set1_ps(dy[ib*4 + j]));
+
+            acc[j] = _mm512_fmadd_ps(d, q, acc[j]);
+        }
+    }
+
+    for (int j = 0; j < nc; ++j) {
+        s[j*bs + 0] = hsum_float_8(_mm512_castps512_ps256(acc[j]));
+        s[j*bs + 1] = hsum_float_8(_mm256_castpd_ps(_mm512_extractf64x4_pd(_mm512_castps_pd(acc[j]), 1)));
+    }
+}
+
+// nr rows of x against the same nc columns, two rows at a time, nc constant after inlining
+static inline void ggml_vec_dot_q8_0_q8_0_rows_512(int nb, float * GGML_RESTRICT s, size_t bs,
+        const char * GGML_RESTRICT x, size_t bx, int nr, const block_q8_0 * const * y, const float * dy, const int nc) {
+    int r = 0;
+    for (; r + 1 < nr; r += 2) {
+        ggml_vec_dot_q8_0_q8_0_rows2(nb, s + r, bs, (const block_q8_0 *) (x + r*bx), (const block_q8_0 *) (x + (r + 1)*bx), y, dy, nc);
+    }
+    if (r < nr) {
+        ggml_vec_dot_q8_0_q8_0_cols(nb, s + r, bs, (const block_q8_0 *) (x + r*bx), y, nc);
+    }
+}
+#endif
+
 void ggml_vec_dot_q8_0_q8_0_ncols(int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT vx, size_t bx, int nr, const void * const * vy, int nc) {
     assert(n % QK8_0 == 0);
 
@@ -1424,6 +1484,30 @@ void ggml_vec_dot_q8_0_q8_0_ncols(int n, float * GGML_RESTRICT s, size_t bs, con
     const int nb = n / QK8_0;
     const block_q8_0 * const * y = (const block_q8_0 * const *) vy;
 
+#if defined(__AVX512BW__)
+    if (nb <= Q8_0_NCOLS_512_MAX_NB) {
+        float dy[4*Q8_0_NCOLS_512_MAX_NB];
+
+        for (int j0 = 0; j0 < nc; j0 += 4) {
+            const int ncj = MIN(4, nc - j0);
+            for (int j = 0; j < ncj; ++j) {
+                for (int ib = 0; ib < nb; ++ib) {
+                    dy[ib*4 + j] = GGML_CPU_FP16_TO_FP32(y[j0 + j][ib].d);
+                }
+            }
+            // the compiler unrolls each case with a constant column count
+            switch (ncj) {
+                case 4: ggml_vec_dot_q8_0_q8_0_rows_512(nb, s + j0*bs, bs, vx, bx, nr, y + j0, dy, 4); break;
+                case 3: ggml_vec_dot_q8_0_q8_0_rows_512(nb, s + j0*bs, bs, vx, bx, nr, y + j0, dy, 3); break;
+                case 2: ggml_vec_dot_q8_0_q8_0_rows_512(nb, s + j0*bs, bs, vx, bx, nr, y + j0, dy, 2); break;
+                case 1: ggml_vec_dot_q8_0_q8_0_rows_512(nb, s + j0*bs, bs, vx, bx, nr, y + j0, dy, 1); break;
+                default: break;
+            }
+        }
+        return;
+    }
+#endif
+
     int j = 0;
     for (; j + 4 <= nc; j += 4) {
         ggml_vec_dot_q8_0_q8_0_rows(nb, s + j*bs, bs, vx, bx, nr, y + j, 4);
