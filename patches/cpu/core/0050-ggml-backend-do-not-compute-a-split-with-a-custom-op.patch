diff --git a/ggml/src/ggml-backend.cpp b/ggml/src/ggml-backend.cpp
index 47d6530ff..54d778438 100644
--- a/ggml/src/ggml-backend.cpp
+++ b/ggml/src/ggml-backend.cpp
@@ -1873,6 +1873,14 @@ static enum ggml_status ggml_backend_sched_compute_splits(ggml_backend_sched_t s
             qb->iface.host_gate_wait == NULL || qb->iface.get_tensor_async == NULL) {
             return false;
         }
+        // a custom op can call into any backend, and a call that waits for the device would wait for
+        // the gated stream: the host would never open the gate
+        for (int i = 0; i < split->graph.n_nodes; i++) {
+            const enum ggml_op op = split->graph.nodes[i]->op;
+            if (op == GGML_OP_CUSTOM || op == GGML_OP_MAP_CUSTOM1 || op == GGML_OP_MAP_CUSTOM2 || op == GGML_OP_MAP_CUSTOM3) {
+                return false;
+            }
+        }
         // every input is a queued copy from the backend's own buffer to host memory
         for (int input_id = 0; input_id < split->n_inputs; input_id++) {
             struct ggml_tensor * input = split->inputs[input_id];
