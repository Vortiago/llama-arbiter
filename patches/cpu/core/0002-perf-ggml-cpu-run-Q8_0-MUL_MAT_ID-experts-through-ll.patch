---
 ggml/src/ggml-cpu/ggml-cpu.c | 240 +++++++++++++++++++++++++++++++++++
 1 file changed, 240 insertions(+)

diff --git a/ggml/src/ggml-cpu/ggml-cpu.c b/ggml/src/ggml-cpu/ggml-cpu.c
index 7c274c03b..80014dc61 100644
--- a/ggml/src/ggml-cpu/ggml-cpu.c
+++ b/ggml/src/ggml-cpu/ggml-cpu.c
@@ -1551,6 +1551,227 @@ static void * incr_ptr_aligned(void ** p, size_t size, size_t align) {
     return ptr;
 }
 
+// The sgemm path of MUL_MAT_ID runs only where llamafile_sgemm has a Q8_0 kernel that takes
+// any shape (its GGML_TYPE_Q8_0 case). Elsewhere every call would fall back to vec_dot after
+// the gather and the extra barrier had been paid for.
+#if GGML_USE_LLAMAFILE && (defined(__AVX__) || defined(__AVX2__) || defined(__AVX512F__) || defined(__ARM_FEATURE_DOTPROD))
+#define GGML_MMID_SGEMM 1
+#else
+#define GGML_MMID_SGEMM 0
+#endif
+
+#if GGML_MMID_SGEMM
+
+// An expert with at least this many routed rows goes through llamafile_sgemm, which
+// refuses fewer than 2. Its tiles keep 4*RN independent FMA chains where vec_dot has one.
+#define MMID_SGEMM_MIN_ROWS 4
+// Below this many gathered rows in the op, the saving is likely smaller than the gather
+// barrier costs, as in an MTP verify batch where a few experts get all 4 tokens.
+#define MMID_SGEMM_MIN_GATHERED 64
+// src0 rows per work item: a multiple of the 4-row tinyBLAS tile
+#define MMID_SGEMM_BLCK_0 64
+// routed rows per llamafile_sgemm call, which bounds the per-thread result tile
+#define MMID_SGEMM_BLCK_1 64
+
+// Only Q8_0 for now: tinyBLAS_Q0_* split by ith/nth with no barrier, so one thread can
+// call it alone, and its AVX2 arithmetic matches ggml_vec_dot_q8_0_q8_0 bit for bit.
+// Do not add F32, F16 or BF16 here: the float tinyBLAS calls ggml_barrier, which waits
+// for every thread of the pool, so a one-thread call from a work item deadlocks.
+static bool ggml_mmid_sgemm_supported(const struct ggml_tensor * src0, const struct ggml_tensor * src1) {
+    return src0->type == GGML_TYPE_Q8_0 && src1->type == GGML_TYPE_F32;
+}
+
+// Work buffer of the sgemm path: the item counter, one result tile per thread, and the
+// routed src1 rows gathered in expert order. Zero when the path cannot run.
+static size_t ggml_mmid_sgemm_wdata_size(int n_threads, const struct ggml_tensor * dst) {
+    const struct ggml_tensor * src0 = dst->src[0];
+    const struct ggml_tensor * src1 = dst->src[1];
+    const struct ggml_tensor * ids  = dst->src[2];
+
+    if (!ggml_mmid_sgemm_supported(src0, src1)) {
+        return 0;
+    }
+
+    const size_t tile_size = MMID_SGEMM_BLCK_0*MMID_SGEMM_BLCK_1*sizeof(float);
+    const size_t rows_size = ggml_row_size(GGML_TYPE_Q8_0, src1->ne[0])*ids->ne[0]*ids->ne[1];
+
+    return CACHE_LINE_SIZE + GGML_PAD(n_threads*tile_size, CACHE_LINE_SIZE) + rows_size;
+}
+
+// Copies the converted src1 rows of each expert that takes the sgemm path into one run per
+// expert, in expert order. The threads split the n_gathered rows evenly.
+static void ggml_mmid_sgemm_gather(
+        const struct ggml_compute_params * params,
+        const struct ggml_tensor * dst,
+        const int64_t * matrix_row_counts,
+        const struct mmid_row_mapping * matrix_rows,
+        int64_t n_gathered,
+        char * gathered) {
+
+    const struct ggml_tensor * src0 = dst->src[0];
+    const struct ggml_tensor * src1 = dst->src[1];
+    const struct ggml_tensor * ids  = dst->src[2];
+
+    const int64_t n_as     = src0->ne[2];
+    const int64_t ne11     = src1->ne[1];
+    const size_t  row_size = ggml_row_size(GGML_TYPE_Q8_0, src1->ne[0]);
+
+    const int64_t r_start = (params->ith    )*n_gathered/params->nth;
+    const int64_t r_end   = (params->ith + 1)*n_gathered/params->nth;
+
+    // r0 is the gathered index of the first row of cur_a
+    int64_t r0 = 0;
+    for (int64_t cur_a = 0; cur_a < n_as && r0 < r_end; ++cur_a) {
+        const int64_t cne1 = matrix_row_counts[cur_a];
+
+        if (cne1 < MMID_SGEMM_MIN_ROWS) {
+            continue;
+        }
+
+        const int64_t j_start = MAX(r_start - r0, 0);
+        const int64_t j_end   = MIN(r_end   - r0, cne1);
+
+        for (int64_t j = j_start; j < j_end; ++j) {
+            const struct mmid_row_mapping row_mapping = MMID_MATRIX_ROW(cur_a, j);
+
+            const int64_t i11 = row_mapping.i1 % ne11;
+            const int64_t i12 = row_mapping.i2;
+
+            memcpy(gathered + (r0 + j)*row_size, (const char *) params->wdata + (i11 + i12*ne11)*row_size, row_size);
+        }
+
+        r0 += cne1;
+    }
+}
+
+// Computes every expert with at least MMID_SGEMM_MIN_ROWS routed rows through llamafile_sgemm,
+// in work items of MMID_SGEMM_BLCK_0 src0 rows handed out across all those experts. Returns
+// false, before any barrier, when fewer than MMID_SGEMM_MIN_GATHERED rows qualify: every
+// thread reads the same counts.
+static bool ggml_compute_forward_mul_mat_id_sgemm(
+        const struct ggml_compute_params * params,
+              struct ggml_tensor * dst,
+        const int64_t * matrix_row_counts,
+        const struct mmid_row_mapping * matrix_rows,
+        char * wdata_sgemm) {
+
+    const struct ggml_tensor * src0 = dst->src[0];
+    const struct ggml_tensor * src1 = dst->src[1];
+    const struct ggml_tensor * ids  = dst->src[2];
+
+    GGML_TENSOR_BINARY_OP_LOCALS
+
+    const int ith = params->ith;
+    const int nth = params->nth;
+
+    const int64_t n_as      = ne02;
+    const size_t  row_size  = ggml_row_size(GGML_TYPE_Q8_0, ne10);
+    const size_t  tile_size = MMID_SGEMM_BLCK_0*MMID_SGEMM_BLCK_1*sizeof(float);
+    const int64_t n_blck0   = (ne01 + MMID_SGEMM_BLCK_0 - 1)/MMID_SGEMM_BLCK_0;
+
+    int64_t n_gathered = 0;
+    int64_t n_items    = 0;
+    for (int64_t cur_a = 0; cur_a < n_as; ++cur_a) {
+        if (matrix_row_counts[cur_a] >= MMID_SGEMM_MIN_ROWS) {
+            n_gathered += matrix_row_counts[cur_a];
+            n_items    += n_blck0;
+        }
+    }
+
+    if (n_gathered < MMID_SGEMM_MIN_GATHERED) {
+        return false;
+    }
+
+    GGML_ASSERT(n_items <= INT_MAX); // item_ctr is an atomic_int
+
+    atomic_int * item_ctr = (atomic_int *) wdata_sgemm;
+    float      * tile     = (float *) (wdata_sgemm + CACHE_LINE_SIZE + ith*tile_size);
+    char       * gathered = wdata_sgemm + CACHE_LINE_SIZE + GGML_PAD(nth*tile_size, CACHE_LINE_SIZE);
+
+    ggml_mmid_sgemm_gather(params, dst, matrix_row_counts, matrix_rows, n_gathered, gathered);
+
+    if (ith == 0) {
+        // every thread starts at item ith, so the first unclaimed item is nth
+        atomic_store_explicit(item_ctr, nth, memory_order_relaxed);
+    }
+
+    ggml_barrier(params->threadpool);
+
+    // tinyBLAS_Q0_* reads only ith and nth, so a one-thread view computes one item alone
+    struct ggml_compute_params params_item = *params;
+    params_item.ith = 0;
+    params_item.nth = 1;
+
+    const bool src1_cont = ggml_is_contiguous(src1);
+
+    // On NUMA, threads take fixed items as the vec_dot path does, so no shared counter
+    // moves between nodes.
+    const bool disable_chunking = ggml_is_numa();
+
+    // a thread claims items in increasing order, so its expert cursor only moves forward
+    int64_t cur_a    = -1;
+    int64_t i_expert = -1; // index of cur_a among the qualifying experts
+    int64_t r0       = 0;  // gathered index of the first row of cur_a
+    int64_t cne1     = 0;
+
+    for (int64_t item = ith; item < n_items;
+         item = disable_chunking ? item + nth : atomic_fetch_add_explicit(item_ctr, 1, memory_order_relaxed)) {
+        while (i_expert < item/n_blck0) {
+            r0 += cne1;
+            do {
+                cur_a++;
+            } while (matrix_row_counts[cur_a] < MMID_SGEMM_MIN_ROWS);
+            cne1 = matrix_row_counts[cur_a];
+            i_expert++;
+        }
+
+        const int64_t ir0_start = (item % n_blck0)*MMID_SGEMM_BLCK_0;
+        const int64_t ir0_end   = MIN(ir0_start + MMID_SGEMM_BLCK_0, ne01);
+
+        const char * src0_cur = (const char *) src0->data + cur_a*nb02;
+
+        // Even column blocks: each holds cne1 rows, or 32 to 64 when there are several, so no
+        // block is a single row that llamafile_sgemm refuses.
+        const int64_t n_blck1 = (cne1 + MMID_SGEMM_BLCK_1 - 1)/MMID_SGEMM_BLCK_1;
+
+        for (int64_t i_blck1 = 0; i_blck1 < n_blck1; ++i_blck1) {
+            const int64_t j0 = (i_blck1    )*cne1/n_blck1;
+            const int64_t j1 = (i_blck1 + 1)*cne1/n_blck1;
+
+            if (!llamafile_sgemm(&params_item,
+                                 ir0_end - ir0_start, j1 - j0, ne00/ggml_blck_size(GGML_TYPE_Q8_0),
+                                 src0_cur + ir0_start*nb01,
+                                 nb01/ggml_type_size(GGML_TYPE_Q8_0),
+                                 gathered + (r0 + j0)*row_size,
+                                 row_size/ggml_type_size(GGML_TYPE_Q8_0),
+                                 tile,
+                                 MMID_SGEMM_BLCK_0,
+                                 GGML_TYPE_Q8_0,
+                                 GGML_TYPE_Q8_0,
+                                 GGML_TYPE_F32)) {
+                ggml_compute_forward_mul_mat_id_one_chunk(
+                    dst, src0, src1, ids, cur_a,
+                    ir0_start, ir0_end, j0, j1,
+                    src0_cur, matrix_rows, row_size, src1_cont, params->wdata
+                );
+                continue;
+            }
+
+            for (int64_t j = j0; j < j1; ++j) {
+                const struct mmid_row_mapping row_mapping = MMID_MATRIX_ROW(cur_a, j);
+
+                float * dst_col = (float *) ((char *) dst->data + row_mapping.i1*nb1 + row_mapping.i2*nb2);
+
+                memcpy(dst_col + ir0_start, tile + (j - j0)*MMID_SGEMM_BLCK_0, (ir0_end - ir0_start)*sizeof(float));
+            }
+        }
+    }
+
+    return true;
+}
+
+#endif
+
 static void ggml_compute_forward_mul_mat_id(
         const struct ggml_compute_params * params,
               struct ggml_tensor * dst) {
@@ -1604,6 +1825,10 @@ static void ggml_compute_forward_mul_mat_id(
     // reservation is unconditional, the per expert eligibility is decided at dispatch time
     char * tiled_scratch = incr_ptr_aligned(&wdata_cur, ggml_tiled_wdata_size(nth, dst), 64);
 
+#if GGML_MMID_SGEMM
+    char * sgemm_wdata = incr_ptr_aligned(&wdata_cur, ggml_mmid_sgemm_wdata_size(nth, dst), CACHE_LINE_SIZE);
+#endif
+
     GGML_ASSERT(params->wsize >= (size_t)((char *) wdata_cur - (char *) params->wdata));
 
     if (src1->type != vec_dot_type) {
@@ -1668,6 +1893,11 @@ static void ggml_compute_forward_mul_mat_id(
 
     ggml_barrier(params->threadpool);
 
+#if GGML_MMID_SGEMM
+    const bool sgemm_handled = !params->use_ref && ggml_mmid_sgemm_supported(src0, src1) &&
+        ggml_compute_forward_mul_mat_id_sgemm(params, dst, matrix_row_counts, matrix_rows, sgemm_wdata);
+#endif
+
     for (int cur_a = 0; cur_a < n_as; ++cur_a) {
         const int64_t cne1 = matrix_row_counts[cur_a];
 
@@ -1675,6 +1905,12 @@ static void ggml_compute_forward_mul_mat_id(
             continue;
         }
 
+#if GGML_MMID_SGEMM
+        if (sgemm_handled && cne1 >= MMID_SGEMM_MIN_ROWS) {
+            continue;
+        }
+#endif
+
         // tiled takes over if profitable for this expert (see tiled.h)
         if (ggml_compute_forward_mul_mat_id_tiled(params, dst, cur_a, cne1, (const int32_t *) &MMID_MATRIX_ROW(cur_a, 0), tiled_scratch)) {
             continue;
@@ -2911,6 +3147,10 @@ struct ggml_cplan ggml_graph_plan(
                         // Workspace for tiled (see tiled.h)
                         cur = GGML_PAD(cur, 64);
                         cur += ggml_tiled_wdata_size(n_tasks, node);
+#if GGML_MMID_SGEMM
+                        // Workspace for the sgemm path, plus its cache line alignment
+                        cur += ggml_mmid_sgemm_wdata_size(n_tasks, node) + CACHE_LINE_SIZE;
+#endif
                     } break;
                 case GGML_OP_OUT_PROD:
                     {
