diff --git a/ggml/src/ggml-cpu/common.h b/ggml/src/ggml-cpu/common.h
index d46aa1f5e..9984ec8a0 100644
--- a/ggml/src/ggml-cpu/common.h
+++ b/ggml/src/ggml-cpu/common.h
@@ -5,6 +5,7 @@
 #include "ggml-cpu-impl.h"
 #include "ggml-impl.h"
 #include "simd-mappings.h"
+#include "ops.h"
 
 #define GGML_FA_TILE_Q  64
 #define GGML_FA_TILE_KV 64
@@ -12,6 +13,34 @@
 // KV block size for the single query (decode) path. The tiled path needs GGML_FA_TILE_Q query rows, so it cannot serve this case.
 #define GGML_FA_KQ_BLK  32
 
+// Sparse prefill (n_kv_max hint): one list of live KV cells per group of GGML_FA_SPARSE_GROUP_Q query tokens.
+// A unit stacks the group's tokens and up to GGML_FA_SPARSE_ROWS/GGML_FA_SPARSE_GROUP_Q query heads of one KV head.
+#define GGML_FA_SPARSE_GROUP_Q 8
+#define GGML_FA_SPARSE_ROWS    96
+
+// Per thread scratch of the sparse prefill path, in floats:
+// Q[ROWS*DK], KQ[ROWS*TILE_KV], mask[GROUP_Q*TILE_KV], VKQ32[ROWS*DV], V32[TILE_KV*DV], K_f32[TILE_KV*DK], padding.
+static inline size_t ggml_fa_sparse_wdata_per_thread(int64_t DK, int64_t DV) {
+    return (size_t) (GGML_FA_SPARSE_ROWS*(DK + GGML_FA_TILE_KV + DV) + GGML_FA_SPARSE_GROUP_Q*GGML_FA_TILE_KV + GGML_FA_TILE_KV*(DV + DK)) + CACHE_LINE_SIZE_F32;
+}
+
+// The hint bounds each mask row by n_kv_max live cells, so the union of a group never exceeds GROUP_Q*n_kv_max.
+static inline int64_t ggml_fa_sparse_list_cap(int64_t n_kv, int64_t n_kv_max) {
+    return MIN(n_kv, (int64_t) GGML_FA_SPARSE_GROUP_Q*n_kv_max);
+}
+
+// One list per token group and per mask sequence (mask ne[3]).
+static inline int64_t ggml_fa_sparse_n_lists(int64_t n_q, int64_t n_mask_seq) {
+    return (n_q + GGML_FA_SPARSE_GROUP_Q - 1)/GGML_FA_SPARSE_GROUP_Q*n_mask_seq;
+}
+
+// The plan and the kernel both size the work buffer with this: per thread scratch, then the counts, then the lists.
+static inline size_t ggml_fa_sparse_wsize(int64_t DK, int64_t DV, int64_t n_q, int64_t n_kv, int64_t n_kv_max, int64_t n_mask_seq, int n_threads) {
+    const int64_t n_lists = ggml_fa_sparse_n_lists(n_q, n_mask_seq);
+    return sizeof(float)*ggml_fa_sparse_wdata_per_thread(DK, DV)*n_threads +
+           sizeof(int32_t)*(size_t) (n_lists*(1 + ggml_fa_sparse_list_cap(n_kv, n_kv_max)));
+}
+
 #ifdef __cplusplus
 
 #include <utility>
diff --git a/ggml/src/ggml-cpu/ggml-cpu.c b/ggml/src/ggml-cpu/ggml-cpu.c
index 448fd9da4..753b3c08a 100644
--- a/ggml/src/ggml-cpu/ggml-cpu.c
+++ b/ggml/src/ggml-cpu/ggml-cpu.c
@@ -3365,7 +3365,16 @@ struct ggml_cplan ggml_graph_plan(
                         size_t n_chunks = n_tasks;
                         size_t decode   = sizeof(float)*(neq2*n_chunks*(2+DV) + n_tasks*(DK + 2*DV + GGML_FA_KQ_BLK));
 
-                        cur += MAX(prefill, decode);
