+// A sparse mask shaped like Qwen QSA: each row sees whole pools of 4 cells below a causal edge, plus the
+// incomplete tail pool. A row keeps about 3/4 of the pools of the row before it, so adjacent rows overlap.
+// Every row sees at most n_kv_max cells.
+static void init_tensor_kq_mask_sparse_pools(ggml_tensor * tensor, int64_t n_kv_max) {
+    GGML_ASSERT(tensor->type == GGML_TYPE_F16);
+
+    static constexpr int64_t pool = 4;
+
+    const int64_t ne0      = tensor->ne[0];
+    const int64_t ne1      = tensor->ne[1];
+    const int64_t n_slices = tensor->ne[2]*tensor->ne[3];
+    const int64_t n_pools  = (n_kv_max - (pool - 1))/pool;
+    GGML_ASSERT(n_pools > 0 && (ne0 - ne1 + 1)/pool >= 2*n_pools);
+
+    std::vector<float>       data_f32(ggml_nelements(tensor), -INFINITY);
+    std::vector<ggml_fp16_t> data_f16(ggml_nelements(tensor));
+
+    std::mt19937 gen(0x9001);
+    for (int64_t slice = 0; slice < n_slices; ++slice) {
+        std::vector<int64_t> chosen;
+        std::vector<bool>    used((ne0 + pool - 1)/pool, false);
+        for (int64_t i1 = 0; i1 < ne1; ++i1) {
+            const int64_t n_vis       = ne0 - ne1 + i1 + 1;
+            const int64_t n_pools_vis = n_vis/pool;
+            std::uniform_int_distribution<int64_t> pick(0, n_pools_vis - 1);
+
+            auto pick_unused = [&]() {
+                int64_t p;
+                do {
+                    p = pick(gen);
+                } while (used[p]);
+                used[p] = true;
+                return p;
+            };
+
+            if (chosen.empty()) {
+                for (int64_t i = 0; i < n_pools; ++i) {
+                    chosen.push_back(pick_unused());
+                }
+            } else {
+                for (int64_t & p : chosen) {
+                    if (gen() % 4 == 0) {
+                        used[p] = false;
+                        p = pick_unused();
+                    }
+                }
+            }
+
+            float * row = data_f32.data() + (slice*ne1 + i1)*ne0;
+            for (int64_t p : chosen) {
+                for (int64_t c = p*pool; c < (p + 1)*pool; ++c) {
+                    row[c] = -0.03125f * (1 + (c + i1) % 7);
+                }
+            }
+            for (int64_t c = n_pools_vis*pool; c < n_vis; ++c) {
+                row[c] = 0.0f;
+            }
+        }
+    }
+
+    ggml_fp32_to_fp16_row(data_f32.data(), data_f16.data(), data_f16.size());
+    ggml_backend_tensor_set(tensor, data_f16.data(), 0, data_f16.size()*sizeof(ggml_fp16_t));
+}
