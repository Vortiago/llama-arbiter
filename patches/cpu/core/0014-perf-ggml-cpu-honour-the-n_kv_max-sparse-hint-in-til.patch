+                            fa = MAX(fa, sparse);
+                        }
+
+                        cur += fa;
                     } break;
                 case GGML_OP_FLASH_ATTN_BACK:
                     {
diff --git a/ggml/src/ggml-cpu/ops.cpp b/ggml/src/ggml-cpu/ops.cpp
index 32c2d050d..98cd83edf 100644
--- a/ggml/src/ggml-cpu/ops.cpp
+++ b/ggml/src/ggml-cpu/ops.cpp
@@ -9542,6 +9542,386 @@ static void ggml_compute_forward_flash_attn_ext_tiled(
     }
 }
 
+// Sparse prefill (n_kv_max hint): the CUDA sparse gate, plus a prefill batch, an F16 mask shared by all heads
+// and a work buffer that holds the cell lists. Every thread computes the same answer.
+static bool ggml_fa_sparse_prefill_supported(const ggml_compute_params * params, const ggml_tensor * dst) {
+    const ggml_tensor * q    = dst->src[0];
+    const ggml_tensor * k    = dst->src[1];
+    const ggml_tensor * v    = dst->src[2];
+    const ggml_tensor * mask = dst->src[3];
+
+    const int32_t n_kv_max = ggml_get_op_params_i32(dst, 4);
+    if (n_kv_max <= 0 || mask == nullptr) {
+        return false;
+    }
+
+    float max_bias      = 0.0f;
+    float logit_softcap = 0.0f;
+    memcpy(&max_bias,      (const float *) dst->op_params + 1, sizeof(float));
+    memcpy(&logit_softcap, (const float *) dst->op_params + 2, sizeof(float));
+
+    // Head sizes up to 256 (Qwen QSA) for now. DeepSeek (512) and the MLA shape (576/512) keep the tiled path.
+    // The 4096 floor is the CUDA one: a shallow context stays on the tiled path, bit for bit.
+    return mask->type == GGML_TYPE_F16 && mask->ne[2] == 1 && mask->ne[0] >= k->ne[1] &&
+           max_bias == 0.0f && logit_softcap == 0.0f &&
+           k->ne[0] <= 256 && v->ne[0] <= 256 &&
+           k->ne[2] == v->ne[2] && k->ne[3] == v->ne[3] &&
+           k->ne[1] >= 4096 &&
+           params->wsize >= ggml_fa_sparse_wsize(k->ne[0], v->ne[0], q->ne[1], k->ne[1], n_kv_max, mask->ne[3], params->nth);
+}
+
+// Query heads of one KV head split into the fewest blocks of at most ROWS/GROUP_Q heads.
+static int64_t ggml_fa_sparse_n_head_blocks(int64_t rk2) {
+    const int64_t hb_max = GGML_FA_SPARSE_ROWS/GGML_FA_SPARSE_GROUP_Q;
+    return (rk2 + hb_max - 1)/hb_max;
+}
+
+// The ascending list of KV cells that any of the n_rows mask rows can see.
+// Nothing (-1) when the union does not fit in cap, which means a row broke the n_kv_max contract.
+static int64_t ggml_fa_sparse_compact_rows(
+        const ggml_fp16_t * const * rows, int n_rows, int64_t n_kv,
+        int32_t * list, int64_t cap) {
+    // An F16 is finite unless all its exponent bits are set. The masked value, -INFINITY, is 0xFC00.
+    static constexpr uint16_t exp_bits = 0x7C00;
+
+    int64_t n = 0;
+    int64_t i = 0;
+#if defined(__AVX2__)
+    const __m256i exp_bits_v = _mm256_set1_epi16((short) exp_bits);
+    for (; i + 16 <= n_kv; i += 16) {
+        __m256i dead = _mm256_set1_epi16(-1);
+        for (int t = 0; t < n_rows; ++t) {
+            const __m256i h = _mm256_loadu_si256((const __m256i *) (rows[t] + i));
+            dead = _mm256_and_si256(dead, _mm256_cmpeq_epi16(_mm256_and_si256(h, exp_bits_v), exp_bits_v));
+        }
+        // movemask gives two bits per 16 bit lane: keep the low one.
+        const uint32_t live = ~(uint32_t) _mm256_movemask_epi8(dead) & 0x55555555u;
+        if (live == 0) {
+            continue;
+        }
+        for (int b = 0; b < 16; ++b) {
+            if (live & (1u << (2*b))) {
+                if (n == cap) {
+                    return -1;
+                }
+                list[n++] = (int32_t) (i + b);
+            }
+        }
+    }
+#endif
+    for (; i < n_kv; ++i) {
+        bool live = false;
+        for (int t = 0; t < n_rows; ++t) {
+            live |= (rows[t][i] & exp_bits) != exp_bits;
+        }
+        if (live) {
+            if (n == cap) {
+                return -1;
+            }
+            list[n++] = (int32_t) i;
+        }
+    }
+    return n;
+}
+
+// Sparse prefill, phase 1: one cell list per group of GGML_FA_SPARSE_GROUP_Q query tokens and per mask sequence.
+// All KV heads share a list, so the mask is scanned once per group, not once per head.
+static void ggml_compute_forward_flash_attn_ext_sparse_compact(
+        const ggml_compute_params * params,
+        const ggml_tensor * dst,
+        int32_t * counts, int32_t * lists, int64_t cap) {
+    const ggml_tensor * q    = dst->src[0];
+    const ggml_tensor * k    = dst->src[1];
+    const ggml_tensor * mask = dst->src[3];
+
+    const int64_t n_q      = q->ne[1];
+    const int64_t n_kv     = k->ne[1];
+    const int64_t n_groups = (n_q + GGML_FA_SPARSE_GROUP_Q - 1)/GGML_FA_SPARSE_GROUP_Q;
+    const int64_t n_lists  = ggml_fa_sparse_n_lists(n_q, mask->ne[3]);
+
+    for (int64_t il = params->ith; il < n_lists; il += params->nth) {
+        const int64_t im3    = il / n_groups;
+        const int64_t iq1    = (il % n_groups)*GGML_FA_SPARSE_GROUP_Q;
+        const int     n_rows = (int) MIN((int64_t) GGML_FA_SPARSE_GROUP_Q, n_q - iq1);
+
+        const ggml_fp16_t * rows[GGML_FA_SPARSE_GROUP_Q];
+        for (int t = 0; t < n_rows; ++t) {
+            rows[t] = (const ggml_fp16_t *) ((const char *) mask->data + (iq1 + t)*mask->nb[1] + im3*mask->nb[3]);
+        }
+
+#ifndef NDEBUG
+        // The hint contract: no row sees more than n_kv_max cells, or the union can overflow the list.
+        const int32_t n_kv_max = ggml_get_op_params_i32(dst, 4);
+        for (int t = 0; t < n_rows; ++t) {
+            int64_t n_live = 0;
+            for (int64_t i = 0; i < n_kv; ++i) {
+                n_live += (rows[t][i] & 0x7C00) != 0x7C00;
+            }
+            GGML_ASSERT(n_live <= n_kv_max);
+        }
+#endif
+
+        counts[il] = (int32_t) ggml_fa_sparse_compact_rows(rows, n_rows, n_kv, lists + il*cap, cap);
+    }
+}
+
+// True when every list of phase 1 fits. A list that overflowed sends the whole op to the tiled path.
+static bool ggml_fa_sparse_lists_fit(const int32_t * counts, int64_t n_lists) {
+    for (int64_t il = 0; il < n_lists; ++il) {
+        if (counts[il] < 0) {
+            return false;
+        }
+    }
+    return true;
+}
+
+// Prefetch the rows of the next gathered tile: a cell list jumps around a K/V cache far larger than the L2.
+static void ggml_fa_sparse_prefetch_rows(const char * base, const int32_t * idx, int n, size_t nb_row, size_t row_size) {
+#if defined(__GNUC__)
+    for (int c = 0; c < n; ++c) {
+        const char * row = base + (int64_t) idx[c]*nb_row;
+        for (size_t off = 0; off < row_size; off += CACHE_LINE_SIZE) {
+            __builtin_prefetch(row + off);
+        }
+    }
+#else
+    GGML_UNUSED(base);
+    GGML_UNUSED(idx);
+    GGML_UNUSED(n);
+    GGML_UNUSED(nb_row);
+    GGML_UNUSED(row_size);
+#endif
+}
+
+// Sparse prefill, phase 2: one unit is (iq3, token group, KV head, head block).
+// The unit stacks its rows as r = token*HB + head, so the heads of a token share its mask row,
+// and each gathered K/V tile serves all GROUP_Q*HB rows. The softmax and output code is the tiled one.
+static void ggml_compute_forward_flash_attn_ext_sparse(
+        const ggml_compute_params * params,
+        ggml_tensor * dst,
+        int64_t unit,
+        const int32_t * counts, const int32_t * lists, int64_t cap) {
+    const ggml_tensor * q     = dst->src[0];
+    const ggml_tensor * k     = dst->src[1];
+    const ggml_tensor * v     = dst->src[2];
+    const ggml_tensor * mask  = dst->src[3];
+    const ggml_tensor * sinks = dst->src[4];
+
+    GGML_TENSOR_LOCALS(int64_t, neq, q,   ne)
+    GGML_TENSOR_LOCALS(size_t,  nbq, q,   nb)
+    GGML_TENSOR_LOCALS(int64_t, nek, k,   ne)
+    GGML_TENSOR_LOCALS(size_t,  nbk, k,   nb)
+    GGML_TENSOR_LOCALS(int64_t, nev, v,   ne)
+    GGML_TENSOR_LOCALS(size_t,  nbv, v,   nb)
+    GGML_TENSOR_LOCALS(int64_t, ne,  dst, ne)
+    GGML_TENSOR_LOCALS(size_t,  nb,  dst, nb)
+
+    static constexpr int G  = GGML_FA_SPARSE_GROUP_Q;
+    static constexpr int KV = GGML_FA_TILE_KV;
+
+    const int64_t DK = nek0;
+    const int64_t DV = nev0;
+
+    const ggml_type kv_type = k->type;
+
+    const int64_t rk2 = neq2/nek2;
+    const int64_t rk3 = neq3/nek3;
+
+    const int64_t n_groups = (neq1 + G - 1)/G;
+    const int64_t n_hb     = ggml_fa_sparse_n_head_blocks(rk2);
+    const int64_t HB       = (rk2 + n_hb - 1)/n_hb;
+    const int64_t R        = G*HB;
+
+    float scale = 1.0f;
+    memcpy(&scale, (float *) dst->op_params + 0, sizeof(float));
+
+    int64_t rest = unit;
+    const int64_t hb  = rest % n_hb;     rest /= n_hb;
+    const int64_t ik2 = rest % nek2;     rest /= nek2;
+    const int64_t ig  = rest % n_groups; rest /= n_groups;
+    const int64_t iq3 = rest;
+
+    const int64_t ik3    = iq3 / rk3;
+    const int64_t iq1_0  = ig*G;
+    const int64_t h0     = ik2*rk2 + hb*HB;
+    const int     n_tok  = (int) MIN((int64_t) G, neq1 - iq1_0);
+    const int     n_head = (int) MIN(HB, rk2 - hb*HB);
+
+    const int64_t   il      = (iq3 % mask->ne[3])*n_groups + ig;
+    const int32_t * list    = lists + il*cap;
+    const int64_t   n_cells = counts[il];
+
+    float * Q_f32  = (float *) params->wdata + params->ith*ggml_fa_sparse_wdata_per_thread(DK, DV);
+    float * KQ     = Q_f32  + GGML_FA_SPARSE_ROWS*DK;
+    float * mask32 = KQ     + GGML_FA_SPARSE_ROWS*KV;
+    float * VKQ32  = mask32 + G*KV;
+    float * V32    = VKQ32  + GGML_FA_SPARSE_ROWS*DV;
+    float * K_f32  = V32    + KV*DV;
+
+    const ggml_fp16_t * mask_rows[G];
+    for (int t = 0; t < n_tok; ++t) {
+        mask_rows[t] = (const ggml_fp16_t *) ((const char *) mask->data + (iq1_0 + t)*mask->nb[1] + (iq3 % mask->ne[3])*mask->nb[3]);
+    }
+
+    for (int t = 0; t < G; ++t) {
+        for (int hh = 0; hh < HB; ++hh) {
+            float * q_row = Q_f32 + (t*HB + hh)*DK;
+            if (t < n_tok && hh < n_head) {
+                memcpy(q_row, (const char *) q->data + (iq1_0 + t)*nbq1 + (h0 + hh)*nbq2 + iq3*nbq3, DK*sizeof(float));
+            } else {
+                memset(q_row, 0, DK*sizeof(float));
+            }
+        }
+    }
+
+    float S[GGML_FA_SPARSE_ROWS];
+    float M[GGML_FA_SPARSE_ROWS];
+    for (int64_t r = 0; r < R; ++r) {
+        S[r] = 0.0f;
+        M[r] = -INFINITY;
+    }
+    memset(VKQ32, 0, R*DV*sizeof(float));
+
+    const char * k_base = (const char *) k->data + ik2*nbk2 + ik3*nbk3;
+    const char * v_base = (const char *) v->data + ik2*nbv2 + ik3*nbv3;
+
+    for (int64_t j0 = 0; j0 < n_cells; j0 += KV) {
+        const int       nc  = (int) MIN((int64_t) KV, n_cells - j0);
+        const int32_t * idx = list + j0;
+
+        const int nc_next = (int) MIN((int64_t) KV, n_cells - j0 - KV);
+        if (nc_next > 0) {
+            ggml_fa_sparse_prefetch_rows(k_base, idx + KV, nc_next, nbk1, DK*nbk0);
+            ggml_fa_sparse_prefetch_rows(v_base, idx + KV, nc_next, nbv1, DV*nbv0);
+        }
+
+        // One mask row per token. A padded column is -inf, so the softmax gives it zero weight.
+        for (int t = 0; t < n_tok; ++t) {
+            float * mask_row = mask32 + t*KV;
+            for (int c = 0; c < nc; ++c) {
+                mask_row[c] = GGML_CPU_FP16_TO_FP32(mask_rows[t][idx[c]]);
+            }
+            for (int c = nc; c < KV; ++c) {
+                mask_row[c] = -INFINITY;
+            }
+        }
+
+        // Gather K transposed, K_f32[dk][c], zero padded so the GEMM always runs KV columns.
+        for (int c = 0; c < nc; ++c) {
+            const char * k_data = k_base + (int64_t) idx[c]*nbk1;
+            if (kv_type == GGML_TYPE_F16) {
+                const ggml_fp16_t * k_f16 = (const ggml_fp16_t *) k_data;
+                for (int64_t dk = 0; dk < DK; dk++) {
+                    K_f32[dk*KV + c] = GGML_CPU_FP16_TO_FP32(k_f16[dk]);
+                }
+            } else {
+                const float * k_f32_src = (const float *) k_data;
+                for (int64_t dk = 0; dk < DK; dk++) {
+                    K_f32[dk*KV + c] = k_f32_src[dk];
+                }
+            }
+        }
+        if (nc < KV) {
+            for (int64_t dk = 0; dk < DK; dk++) {
+                memset(K_f32 + dk*KV + nc, 0, (KV - nc)*sizeof(float));
+            }
+        }
+
+        memset(KQ, 0, R*KV*sizeof(float));
+        simd_gemm(KQ, Q_f32, K_f32, (int) R, (int) DK, KV);
+        ggml_vec_scale_f32((int) (R*KV), KQ, scale);
+
+        bool skip[GGML_FA_SPARSE_ROWS];
+
+        for (int64_t r = 0; r < R; ++r) {
+            const int64_t t  = r / HB;
+            const int64_t hh = r % HB;
+            float * kq_row = KQ + r*KV;
+
+            if (t >= n_tok || hh >= n_head) {
