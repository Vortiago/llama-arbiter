+// Apply smpl to the candidates the backend left in output row idx, without accept. Returns the selected id.
+static llama_token apply_to_row(llama_sampler * smpl, llama_context * ctx, int32_t idx) {
+    const float *       logits = llama_get_sampled_logits_ith(ctx, idx);
+    const llama_token * ids    = llama_get_sampled_candidates_ith(ctx, idx);
+    const uint32_t      n      = llama_get_sampled_logits_count_ith(ctx, idx);
+    GGML_ASSERT(logits != nullptr && ids != nullptr && n > 0);
+
+    std::vector<llama_token_data> cur(n);
+    for (uint32_t i = 0; i < n; ++i) {
+        cur[i] = { ids[i], logits[i], 0.0f };
+    }
+    llama_token_data_array cur_p = { cur.data(), cur.size(), -1, false };
+    llama_sampler_apply(smpl, &cur_p);
+    GGML_ASSERT(cur_p.selected >= 0 && cur_p.selected < (int64_t) cur_p.size);
+
+    return cur_p.data[cur_p.selected].id;
+}
+
+// The pick of a new dist(seed) that has accepted n_accept tokens, over the candidates of output row idx.
+// dist draws its noise from (seed, accepted count, token id), so this is the pick a dist with that history makes.
+static llama_token reference_dist_pick(llama_context * ctx, int32_t idx, uint32_t seed, int n_accept) {
+    llama_sampler_ptr dist(llama_sampler_init_dist(seed));
+    for (int i = 0; i < n_accept; ++i) {
+        llama_sampler_accept(dist.get(), 0);
+    }
+    return apply_to_row(dist.get(), ctx, idx);
+}
