+static double llama_sampler_dist_exp_noise(uint32_t seed, uint64_t counter, llama_token id) {
+    uint64_t z = (uint64_t) seed ^ (counter * 0x9E3779B97F4A7C15ull) ^ ((uint64_t) (uint32_t) id * 0xD1B54A32D192ED03ull);
+    z += 0x9E3779B97F4A7C15ull;
+    z = (z ^ (z >> 30)) * 0xBF58476D1CE4E5B9ull;
+    z = (z ^ (z >> 27)) * 0x94D049BB133111EBull;
+    z ^= z >> 31;
+    const double u = ((double) (z >> 11) + 0.5) * (1.0 / 9007199254740992.0); // in (0, 1)
+    return -std::log(u);
+}
