+// The dist pick is a Gumbel-max pick keyed by (seed, accepted count, token id), so that a draft that runs
+// the same chain on its own logits gives each shared token the same noise as the target does.
+static llama_token sample_ids(llama_sampler * sampler, const std::vector<llama_token> & ids, const std::vector<float> & logits) {
+    std::vector<llama_token_data> cur;
+    for (size_t i = 0; i < ids.size(); ++i) {
+        cur.push_back({ ids[i], logits[i], 0.0f });
+    }
+
+    llama_token_data_array cur_p = { cur.data(), cur.size(), -1, false };
+    llama_sampler_apply(sampler, &cur_p);
+    GGML_ASSERT(cur_p.selected >= 0 && (size_t) cur_p.selected < cur_p.size);
+    return cur_p.data[cur_p.selected].id;
+}
+
+static void test_dist_gumbel() {
+    // the pick does not depend on the order of the candidates, or on candidates that were not picked
+    for (uint32_t seed = 1; seed <= 200; ++seed) {
+        const std::vector<llama_token> ids    = { 0, 1, 2, 3, 4, 5, 6, 7 };
+        const std::vector<float>       logits = { 0.1f, 0.5f, 0.9f, 0.2f, 0.7f, 0.3f, 0.8f, 0.4f };
+
+        llama_sampler * a = llama_sampler_init_dist(seed);
+        const llama_token x = sample_ids(a, ids, logits);
+        llama_sampler_free(a);
+
+        std::vector<llama_token> ids_b;
+        std::vector<float>       logits_b;
+        for (int i = (int) ids.size() - 1; i >= 0; --i) {
+            if (ids[i] == x || i % 3 != 0) {
+                ids_b.push_back(ids[i]);
+                logits_b.push_back(logits[i]);
+            }
+        }
+
+        llama_sampler * b = llama_sampler_init_dist(seed);
+        GGML_ASSERT(sample_ids(b, ids_b, logits_b) == x);
+        llama_sampler_free(b);
+    }
+
+    // the noise moves on with each accepted token, not with each pick, and a clone keeps the count
+    {
+        const std::vector<float> logits(256, 0.0f);
+
+        llama_sampler * s = llama_sampler_init_dist(77);
+        const llama_token x0 = sample_dist(s, logits);
+        GGML_ASSERT(sample_dist(s, logits) == x0);
+
+        llama_sampler_accept(s, 5);
+        const llama_token x1 = sample_dist(s, logits);
+
+        llama_sampler * t = llama_sampler_init_dist(77);
+        llama_sampler_accept(t, 9);
+        GGML_ASSERT(sample_dist(t, logits) == x1);
+
+        llama_sampler * c = llama_sampler_clone(s);
+        GGML_ASSERT(sample_dist(c, logits) == x1);
+
+        llama_sampler_free(s);
+        llama_sampler_free(t);
+        llama_sampler_free(c);
+    }
+
+    // the pick is a sample of the softmax
+    {
+        const std::vector<float> probs = { 0.1f, 0.2f, 0.3f, 0.4f };
+        std::vector<float> logits;
+        for (float p : probs) {
+            logits.push_back(logf(p));
+        }
+
+        const int n = 40000;
+        std::vector<int> count(probs.size(), 0);
+
+        llama_sampler * s = llama_sampler_init_dist(1234);
+        for (int i = 0; i < n; ++i) {
+            const llama_token x = sample_dist(s, logits);
+            count[x]++;
+            llama_sampler_accept(s, x);
+        }
+        llama_sampler_free(s);
+
+        for (size_t i = 0; i < probs.size(); ++i) {
+            const double f = (double) count[i] / n;
+            printf("dist gumbel: token %zu p %.3f freq %.4f\n", i, probs[i], f);
+            GGML_ASSERT(fabs(f - probs[i]) < 0.01);
+        }
+    }
+}
