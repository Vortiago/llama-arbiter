index e970b4f6a..132fd5ce7 100644
--- a/ggml/src/ggml-cpu/ops.cpp
+++ b/ggml/src/ggml-cpu/ops.cpp
@@ -4214,6 +4214,103 @@ void ggml_compute_forward_rms_norm_mul_fused(
