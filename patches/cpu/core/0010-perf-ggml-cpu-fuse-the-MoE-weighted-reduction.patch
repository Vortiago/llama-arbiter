+struct ggml_cpu_moe_weighted_reduction_match {
+    const struct ggml_tensor * experts;
+    const struct ggml_tensor * expert_scale;
+    const struct ggml_tensor * weights;
+    struct ggml_tensor *       dst;
+    int                        node_count;
+    bool                       stage_weights; // dst overlaps the weights or the expert scale
+};
+
+static bool ggml_cpu_moe_is_experts(const struct ggml_tensor * mul, const struct ggml_tensor * t) {
+    return t && t->type == GGML_TYPE_F32 && ggml_is_contiguous(t) && ggml_are_same_shape(t, mul);
+}
+
+// split a MUL into its [n_embd, k, n_tokens] operand and its [1, k, n_tokens] broadcast operand
+// (ggml_mul gives dst the shape of src[0], so only src[1] can broadcast)
+static bool ggml_cpu_moe_split_mul(const struct ggml_tensor * mul, const struct ggml_tensor ** full, const struct ggml_tensor ** broadcast) {
+    if (mul->op != GGML_OP_MUL || mul->type != GGML_TYPE_F32 || !ggml_is_contiguous(mul) ||
+            !ggml_cpu_moe_is_experts(mul, mul->src[0]) || !ggml_cpu_moe_is_weights(mul, mul->src[1])) {
+        return false;
+    }
+    *full      = mul->src[0];
+    *broadcast = mul->src[1];
+    return true;
+}
+
+// Matches the MoE weighted reduction that build_moe_ffn emits, in either form:
+//   (experts * expert_scale) * weights, or experts * weights,
+// followed by one VIEW per expert and the ADD chain ((v0 + v1) + v2) + ...
+// C port of ggml_cuda_match_moe_weighted_reduction.
+static bool ggml_cpu_match_moe_weighted_reduction(
+        const struct ggml_cgraph * cgraph,
+        const int node_n,
+        const struct ggml_cplan * cplan,
+        struct ggml_cpu_moe_weighted_reduction_match * match) {
+    const struct ggml_tensor * first        = cgraph->nodes[node_n];
+    const struct ggml_tensor * weighted     = first;
+    const struct ggml_tensor * experts      = NULL;
+    const struct ggml_tensor * expert_scale = NULL;
+    const struct ggml_tensor * weights      = NULL;
+    int                        mul_count    = 1;
+
+    if (node_n + 1 < cgraph->n_nodes) {
+        const struct ggml_tensor * second = cgraph->nodes[node_n + 1];
+        const struct ggml_tensor * scaled = NULL;
+        const struct ggml_tensor * second_weights = NULL;
+        if (ggml_cpu_moe_split_mul(second, &scaled, &second_weights) && scaled == first &&
+                ggml_cpu_moe_split_mul(first, &experts, &expert_scale)) {
+            weighted  = second;
+            weights   = second_weights;
+            mul_count = 2;
+        }
+    }
+
+    if (experts == NULL && !ggml_cpu_moe_split_mul(first, &experts, &weights)) {
+        return false;
+    }
+
+    const int     n_expert_used = (int) weighted->ne[1];
+    const int64_t n_tokens      = weighted->ne[2]*weighted->ne[3];
+    if (n_expert_used < 2 || n_expert_used > GGML_CPU_MOE_WEIGHTED_REDUCTION_MAX_EXPERTS) {
+        return false;
+    }
+
+    const int node_count = 2*n_expert_used + mul_count - 1;
+    if (node_n + node_count > cgraph->n_nodes) {
+        return false;
+    }
+
+    enum ggml_op               ops[2*GGML_CPU_MOE_WEIGHTED_REDUCTION_MAX_EXPERTS + 1];
+    const struct ggml_tensor * views[GGML_CPU_MOE_WEIGHTED_REDUCTION_MAX_EXPERTS];
+    const struct ggml_tensor * previous = NULL;
+    int n_views = 0;
+    int n_adds  = 0;
+
+    for (int i = 0; i < mul_count; ++i) {
+        ops[i] = GGML_OP_MUL;
+    }
+    for (int offset = mul_count; offset < node_count; ++offset) {
+        const struct ggml_tensor * candidate = cgraph->nodes[node_n + offset];
+        ops[offset] = candidate->op;
+
+        if (candidate->op == GGML_OP_VIEW) {
+            if (n_views >= n_expert_used || candidate->src[0] != weighted || candidate->view_src != weighted ||
+                    candidate->type != GGML_TYPE_F32 || candidate->ne[0] != weighted->ne[0] ||
+                    candidate->ne[1] != n_tokens || candidate->ne[2] != 1 || candidate->ne[3] != 1 ||
+                    candidate->nb[0] != weighted->nb[0] || candidate->nb[1] != weighted->nb[2] ||
+                    candidate->view_offs != (size_t) n_views*weighted->nb[1]) {
+                return false;
+            }
+            views[n_views++] = candidate;
+            continue;
+        }
+
+        if (candidate->op != GGML_OP_ADD || n_views < 2 || n_adds + 1 >= n_views) {
+            return false;
+        }
+        const struct ggml_tensor * lhs = n_adds == 0 ? views[0] : previous;
+        const struct ggml_tensor * rhs = views[n_adds + 1];
+        if (candidate->src[0] != lhs || candidate->src[1] != rhs || candidate->type != GGML_TYPE_F32) {
+            return false;
+        }
+        previous = candidate;
+        ++n_adds;
+    }
+
+    if (n_views != n_expert_used || n_adds != n_expert_used - 1 || previous == NULL) {
+        return false;
+    }
+    if (!ggml_is_contiguous(previous) || previous->ne[0] != weighted->ne[0] ||
+            previous->ne[1] != n_tokens || previous->ne[2] != 1 || previous->ne[3] != 1) {
+        return false;
+    }
+
+    const int output_idx = node_n + node_count - 1;
+    if (!ggml_can_fuse_subgraph(cgraph, node_n, node_count, ops, &output_idx, 1)) {
+        return false;
+    }
+
+    // The CPU backend has no graph_optimize hook to keep the inputs allocated until dst, as CUDA does
+    // with add_alloc_dep, and callers outside ggml_backend_sched have none either. So the allocator can
+    // place dst over a weights tensor that the unfused MUL was the last to read. The fused kernel then
+    // copies the weights and the expert scale to the work buffer before it writes dst.
+    struct ggml_tensor * dst = cgraph->nodes[output_idx];
+    if (ggml_cpu_ranges_overlap(dst, experts)) {
+        return false;
+    }
+    const bool stage_weights = ggml_cpu_ranges_overlap(dst, weights) ||
+        (expert_scale && ggml_cpu_ranges_overlap(dst, expert_scale));
+    if (stage_weights && cplan->work_size < ggml_cpu_moe_weights_stage_size(weighted)) {
+        return false;
+    }
+
+    match->experts      = experts;
+    match->expert_scale = expert_scale;
+    match->weights      = weights;
+    match->dst          = dst;
+    match->node_count   = node_count;
+    match->stage_weights = stage_weights;
+    return true;
+}
