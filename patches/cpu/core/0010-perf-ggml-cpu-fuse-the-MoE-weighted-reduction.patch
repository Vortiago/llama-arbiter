+// The long form of the MoE weighted reduction spans 2*k + 1 nodes, and ggml_can_fuse_subgraph()
+// accepts at most 31 nodes, so k <= 15. The short form spans 2*k nodes and keeps the same limit.
+// Larger values use the per-operation path.
+#define GGML_CPU_MOE_WEIGHTED_REDUCTION_MAX_EXPERTS 15
+
+// the [1, k, n_tokens] weights or expert scale operand of a MoE weighted reduction MUL
+static bool ggml_cpu_moe_is_weights(const struct ggml_tensor * mul, const struct ggml_tensor * t) {
+    return t && t->type == GGML_TYPE_F32 && ggml_is_contiguous(t) && t->ne[0] == 1 &&
+        t->ne[1] == mul->ne[1] && t->ne[2] == mul->ne[2] && t->ne[3] == mul->ne[3];
+}
+
+// Work buffer for the weights and the expert scale of a fused MoE weighted reduction, one float
+// each per row of the MUL. The fused kernel copies them there when dst overlaps them.
+static size_t ggml_cpu_moe_weights_stage_size(const struct ggml_tensor * mul) {
+    return 2*sizeof(float)*ggml_nrows(mul);
+}
