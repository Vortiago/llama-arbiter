+// y = (x * scale) * weight, rounded like the unfused MUL nodes
+static void ggml_moe_weighted_expert_row(const int64_t n, float * y, const float * x, const float * scale, const float weight) {
+    if (scale) {
+        const float s = *scale; // a local, since y may alias scale
+        for (int64_t i = 0; i < n; ++i) {
+            y[i] = (x[i] * s) * weight;
+        }
+    } else {
+        for (int64_t i = 0; i < n; ++i) {
+            y[i] = x[i] * weight;
+        }
+    }
+}
+
+// Fused MUL + VIEW + ADD chain at the end of build_moe_ffn: dst[:, t] = sum over k of experts[:, k, t] * weights[k, t],
+// with an optional expert_scale MUL before the weights. The sum runs in expert order, as the ADD chain does.
+// stage_weights: dst overlaps the weights or the expert scale, so copy them to wdata before any thread writes dst.
+void ggml_compute_forward_moe_weighted_reduction(
+        const ggml_compute_params * params,
+        const ggml_tensor * experts,
+        const ggml_tensor * expert_scale,
+        const ggml_tensor * weights,
+        ggml_tensor * dst,
+        bool stage_weights) {
+
+    GGML_ASSERT(experts->type == GGML_TYPE_F32 && weights->type == GGML_TYPE_F32 && dst->type == GGML_TYPE_F32);
+    GGML_ASSERT(expert_scale == nullptr || expert_scale->type == GGML_TYPE_F32);
+    GGML_ASSERT(ggml_is_contiguous(experts) && ggml_is_contiguous(weights) && ggml_is_contiguous(dst));
+    GGML_ASSERT(expert_scale == nullptr || ggml_is_contiguous(expert_scale));
+
+    const int64_t n_embd        = experts->ne[0];
+    const int64_t n_expert_used = experts->ne[1];
+    const int64_t n_tokens      = experts->ne[2]*experts->ne[3];
+
+    // Work units are (token, column block), so a single token still spreads over the threads.
+    constexpr int64_t n_cols_per_unit = 64;
+    const int64_t n_units_per_token = (n_embd + n_cols_per_unit - 1)/n_cols_per_unit;
+    const int64_t n_units = n_tokens*n_units_per_token;
+    const int64_t dr      = (n_units + params->nth - 1)/params->nth;
+    const int64_t u0      = std::min(dr*params->ith, n_units);
+    const int64_t u1      = std::min(u0 + dr, n_units);
+
+    const float * x  = (const float *) experts->data;
+    const float * s  = expert_scale ? (const float *) expert_scale->data : nullptr;
+    const float * w  = (const float *) weights->data;
+    float       * y  = (float *) dst->data;
+
+    if (stage_weights) {
+        const int64_t n_rows = n_expert_used*n_tokens;
+        GGML_ASSERT(params->wsize >= 2*sizeof(float)*n_rows);
+
+        float * staged_w = (float *) params->wdata;
+        float * staged_s = staged_w + n_rows;
+
+        const int64_t dr_rows = (n_rows + params->nth - 1)/params->nth;
+        const int64_t r0      = std::min(dr_rows*params->ith, n_rows);
+        const int64_t r1      = std::min(r0 + dr_rows, n_rows);
+        memcpy(staged_w + r0, w + r0, (r1 - r0)*sizeof(float));
+        if (s) {
+            memcpy(staged_s + r0, s + r0, (r1 - r0)*sizeof(float));
+        }
+        // A serial run calls this on thread 0 alone (nth = 1) while the other threads wait at the
+        // barrier after the run, so a barrier here would pair with theirs.
+        if (params->nth > 1) {
+            ggml_barrier(params->threadpool);
+        }
+
+        w = staged_w;
+        s = s ? staged_s : nullptr;
+    }
+
+    float product[n_cols_per_unit];
+
+    for (int64_t u = u0; u < u1; ++u) {
+        const int64_t t    = u/n_units_per_token;
+        const int64_t i0   = (u % n_units_per_token)*n_cols_per_unit;
+        const int64_t n    = std::min(n_cols_per_unit, n_embd - i0);
+        const int64_t row0 = t*n_expert_used;
+
+        float * acc = y + t*n_embd + i0;
+        ggml_moe_weighted_expert_row(n, acc, x + row0*n_embd + i0, s ? s + row0 : nullptr, w[row0]);
+
+        for (int64_t k = 1; k < n_expert_used; ++k) {
+            const int64_t row = row0 + k;
+            ggml_moe_weighted_expert_row(n, product, x + row*n_embd + i0, s ? s + row : nullptr, w[row]);
+            // The products pass through memory, so the compiler cannot contract a product and its add
+            // into an FMA (GCC contracts by default). That keeps dst bit-exact with the unfused nodes.
+#if defined(__GNUC__)
+            __asm__ __volatile__("" : : "r"(product) : "memory");
+#endif
+            for (int64_t i = 0; i < n; ++i) {
+                acc[i] = acc[i] + product[i];
+            }
+        }
+    }
+}
+
 static void ggml_compute_forward_rms_norm_back_f32(
         const ggml_compute_params * params,
         ggml_tensor * dst) {
