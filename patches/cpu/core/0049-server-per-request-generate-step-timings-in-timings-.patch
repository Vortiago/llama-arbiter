diff --git a/tests/test-server-gentrace.cpp b/tests/test-server-gentrace.cpp
new file mode 100644
index 000000000..a4ef942f1
--- /dev/null
+++ b/tests/test-server-gentrace.cpp
@@ -0,0 +1,103 @@
+// server_gen_trace: each microsecond between the first generated token and the
+// last mark goes to exactly one part, and the timings JSON reports the parts.
+
+#include "../tools/server/server-common.h"
+
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+
+static int n_fail = 0;
+
+#define CHECK(cond) do { if (!(cond)) { fprintf(stderr, "FAIL %s:%d: %s\n", __FILE__, __LINE__, #cond); n_fail++; } } while (0)
+
+static bool near(double a, double b) { return std::fabs(a - b) < 1e-9; }
+
+int main() {
+    // not started: marks are ignored and no gen_* fields appear
+    {
+        server_slot_stats st;
+        st.gen.mark(SERVER_GEN_DRAFT, 5000);
+        CHECK(st.gen.wall_us() == 0);
+        CHECK(st.gen.t_us[SERVER_GEN_DRAFT] == 0);
+        const json j = st.to_json();
+        CHECK(!j.contains("gen_steps"));
+        CHECK(!j.contains("gen_wall_ms"));
+    }
+
+    // two steps: the parts sum to the wall time
+    {
+        server_slot_stats st;
+        st.gen.start(1000);                   // first token sampled
+        st.gen.mark(SERVER_GEN_EMIT,   1100); // first token sent
+
+        st.gen.begin_step(1300);              // step 1
+        st.gen.mark(SERVER_GEN_PREP,   1350);
+        st.gen.mark(SERVER_GEN_DRAFT,  2350);
+        st.gen.mark(SERVER_GEN_DECODE, 6350);
+        st.gen.mark(SERVER_GEN_SYNC,   6850);
+        st.gen.mark(SERVER_GEN_SAMPLE, 7050);
+        st.gen.end_step(SERVER_GEN_EMIT, 7150);
+        CHECK(!st.gen.active);
+
+        st.gen.begin_step(7250);              // step 2, rejected: restore, no emit
+        CHECK(st.gen.active);
+        st.gen.mark(SERVER_GEN_DECODE, 9250);
+        st.gen.end_step(SERVER_GEN_CKPT, 9450);
+        st.gen.n_restores++;
+
+        st.gen.add_decode_wait(300);
+
+        CHECK(st.gen.n_steps == 2);
+        CHECK(st.gen.t_us[SERVER_GEN_GAP]    == 200 + 100);
+        CHECK(st.gen.t_us[SERVER_GEN_DECODE] == 4000 + 2000);
+        CHECK(st.gen.t_us[SERVER_GEN_EMIT]   == 100 + 100);
+        CHECK(st.gen.t_us[SERVER_GEN_CKPT]   == 200);
+        CHECK(st.gen.wall_us() == 9450 - 1000);
+
+        int64_t sum = 0;
+        for (int p = 0; p < SERVER_GEN_COUNT; ++p) {
+            sum += st.gen.t_us[p];
+        }
+        CHECK(sum == st.gen.wall_us());
+
+        const json j = st.to_json();
+        CHECK(j.at("gen_steps").get<uint64_t>() == 2);
+        CHECK(j.at("gen_restores").get<uint64_t>() == 1);
+        CHECK(near(j.at("gen_wall_ms").get<double>(), 8.45));
+        CHECK(near(j.at("gen_draft_ms").get<double>(), 1.0));
+        CHECK(near(j.at("gen_draft_per_step_ms").get<double>(), 0.5));
+        CHECK(near(j.at("gen_decode_ms").get<double>(), 6.0));
+        CHECK(near(j.at("gen_decode_per_step_ms").get<double>(), 3.0));
+        CHECK(near(j.at("gen_decode_wait_ms").get<double>(), 0.3));
+        CHECK(j.contains("gen_gap_ms") && j.contains("gen_prep_ms") && j.contains("gen_yield_ms") &&
+              j.contains("gen_ckpt_ms") && j.contains("gen_sync_ms") && j.contains("gen_spec_ms") &&
+              j.contains("gen_sample_ms") && j.contains("gen_emit_ms"));
+    }
+
+    // no decode wait without GGML_OP_STATS: the field is absent
+    {
+        server_slot_stats st;
+        st.gen.start(10);
+        st.gen.begin_step(20);
+        st.gen.end_step(SERVER_GEN_EMIT, 30);
+        CHECK(!st.to_json().contains("gen_decode_wait_ms"));
+    }
+
+    // a mark while not in a step still counts (the first token's emit), but
+    // a step needs begin_step to count
+    {
+        server_gen_trace g;
+        g.start(100);
+        g.mark(SERVER_GEN_EMIT, 150);
+        CHECK(g.n_steps == 0);
+        CHECK(g.t_us[SERVER_GEN_EMIT] == 50);
+    }
+
+    if (n_fail) {
+        fprintf(stderr, "%d check(s) failed\n", n_fail);
+        return 1;
+    }
+    printf("test-server-gentrace: OK\n");
+    return 0;
+}
diff --git a/tools/server/server-common.cpp b/tools/server/server-common.cpp
index 076a85741..5c2ad2ac9 100644
--- a/tools/server/server-common.cpp
+++ b/tools/server/server-common.cpp
@@ -101,6 +101,25 @@ json server_slot_stats::to_json() const {
         base["draft_n_accepted"] = n_draft_accepted;
     }
 
+    if (gen.n_steps > 0) {
+        static const char * names[SERVER_GEN_COUNT] = {
+            "gap", "prep", "yield", "draft", "ckpt", "decode", "sync", "spec", "sample", "emit",
+        };
+        const double steps = (double) gen.n_steps;
+
+        base["gen_steps"]    = gen.n_steps;
+        base["gen_restores"] = gen.n_restores;
+        base["gen_wall_ms"]  = gen.wall_us() / 1000.0;
+        for (int p = 0; p < SERVER_GEN_COUNT; ++p) {
+            base[std::string("gen_") + names[p] + "_ms"]          = gen.t_us[p] / 1000.0;
+            base[std::string("gen_") + names[p] + "_per_step_ms"] = gen.t_us[p] / 1000.0 / steps;
+        }
+        if (gen.t_decode_wait_us >= 0) {
+            base["gen_decode_wait_ms"]          = gen.t_decode_wait_us / 1000.0;
+            base["gen_decode_wait_per_step_ms"] = gen.t_decode_wait_us / 1000.0 / steps;
+        }
+    }
+
     return base;
 }
 
diff --git a/tools/server/server-common.h b/tools/server/server-common.h
index 20cdeacf2..c5db14a13 100644
--- a/tools/server/server-common.h
+++ b/tools/server/server-common.h
@@ -375,8 +375,65 @@ json format_response_rerank(
 // stats and metrics
 //
 
+// the parts of a generate step, in loop order
+enum server_gen_part {
+    SERVER_GEN_GAP,    // previous step's end -> this step's start (queue loop, other tasks, context shift)
+    SERVER_GEN_PREP,   // bookkeeping inside the step (draft params, batch build, other slots' prompts)
+    SERVER_GEN_YIELD,  // yield_to_queue() hand-off and wait for the queue worker
+    SERVER_GEN_DRAFT,  // common_speculative_draft()
+    SERVER_GEN_CKPT,   // speculative checkpoint save, and restore on a rejected draft
+    SERVER_GEN_DECODE, // target llama_process() of the step's batch
+    SERVER_GEN_SYNC,   // llama_synchronize() after it
+    SERVER_GEN_SPEC,   // common_speculative_process() of the decoded batch (draft/MTP update)
+    SERVER_GEN_SAMPLE, // sampling and accepting the draft
+    SERVER_GEN_EMIT,   // accept bookkeeping, detokenize, stop checks, sending the tokens
+    SERVER_GEN_COUNT,
+};
+
+// per-request generate timing: from the first generated token on, each mark
+// adds the time since the previous mark to one part, so the parts sum to the wall time
+struct server_gen_trace {
+    int64_t  t_first = 0; // first generated token, 0 = not started
+    int64_t  t_mark  = 0;
+    bool     active  = false; // inside a generate step, i.e. shared marks apply to this slot
+    uint64_t n_steps    = 0;
+    uint64_t n_restores = 0;
+    int64_t  t_us[SERVER_GEN_COUNT] = {};
+    int64_t  t_decode_wait_us = -1; // scheduler sync + gate wait inside decode, -1 = not counted
+
+    void start(int64_t t) {
+        t_first = t_mark = t;
+    }
+    void mark(server_gen_part p, int64_t t) {
+        if (t_first == 0) {
+            return;
+        }
+        t_us[p] += t - t_mark;
+        t_mark = t;
+    }
+    void begin_step(int64_t t) {
+        mark(SERVER_GEN_GAP, t);
+        if (t_first != 0) {
+            active = true;
+            n_steps++;
+        }
+    }
+    void end_step(server_gen_part p, int64_t t) {
+        mark(p, t);
+        active = false;
+    }
+    void add_decode_wait(int64_t us) {
+        t_decode_wait_us = (t_decode_wait_us < 0 ? 0 : t_decode_wait_us) + us;
+    }
+    int64_t wall_us() const {
+        return t_mark - t_first;
+    }
+};
+
 // shared between server_slot and server_task_result_*
 struct server_slot_stats {
+    server_gen_trace gen;
+
     uint64_t n_prompt_cached    = 0;
     uint64_t n_prompt_processed = 0;
     uint64_t n_gen              = 0;
