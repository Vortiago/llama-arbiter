@@ -4496,6 +4548,16 @@ private:
     // metrics helpers
     //
 
+    // generate trace: add the time up to t to part p, for each slot inside a generate step
+    // note: call on the main thread only, after a yield_to_queue() returns
+    void gen_mark(server_gen_part p, int64_t t) {
+        for (auto & slot : slots) {
+            if (slot.stats.gen.active) {
+                slot.stats.gen.mark(p, t);
