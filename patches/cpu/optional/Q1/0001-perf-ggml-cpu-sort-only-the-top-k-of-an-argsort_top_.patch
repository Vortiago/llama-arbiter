--- a/ggml/src/ggml.c
+++ b/ggml/src/ggml.c
@@ -5480,10 +5480,16 @@ struct ggml_tensor * ggml_argsort_top_k(
         struct ggml_context * ctx,
         struct ggml_tensor  * a,
