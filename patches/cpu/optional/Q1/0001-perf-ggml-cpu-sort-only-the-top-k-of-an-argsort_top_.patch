     };
 
+    // GGML_OP_ARGSORT: op_params[0] is the order, op_params[1] is a top-k hint (0 means none)
+    // with a hint k > 0, only the first k ids of each row are read: they must come out sorted,
+    // and the rest of the row may hold the remaining ids in any order
     GGML_API struct ggml_tensor * ggml_argsort(
             struct ggml_context * ctx,
             struct ggml_tensor  * a,
             enum ggml_sort_order  order);
 
     // similar to ggml_top_k but implemented as `argsort` + `view`
+    // the k ids are in descending order, and the argsort node carries k as its top-k hint
     GGML_API struct ggml_tensor * ggml_argsort_top_k(
             struct ggml_context * ctx,
             struct ggml_tensor  * a,
diff --git a/ggml/src/ggml-cpu/ops.cpp b/ggml/src/ggml-cpu/ops.cpp
index de19fd19f..b618cb08a 100644
--- a/ggml/src/ggml-cpu/ops.cpp
+++ b/ggml/src/ggml-cpu/ops.cpp
@@ -8830,6 +8830,17 @@ struct cmp_argsort {
     }
 };
 
+// Sorts the first n_sorted ids of the row in place.
+// The rest of the row keeps the remaining ids in no particular order.
+template<enum ggml_sort_order order>
+static void ggml_argsort_row(int32_t * ids, int64_t n_sorted, int64_t n, const float * data) {
+    if (n_sorted < n) {
+        std::partial_sort(ids, ids + n_sorted, ids + n, cmp_argsort<order>{data});
+    } else {
+        std::sort(ids, ids + n, cmp_argsort<order>{data});
+    }
+}
+
 static void ggml_compute_forward_argsort_f32(
     const ggml_compute_params * params,
     ggml_tensor * dst) {
@@ -8847,6 +8858,13 @@ static void ggml_compute_forward_argsort_f32(
 
     ggml_sort_order order = (ggml_sort_order) ggml_get_op_params_i32(dst, 0);
 
+    // partial_sort is heap-based and slower than introsort when k nears the row length,
+    // so the top-k hint applies only to a k of at most a quarter of the row.
+    // use_ref sorts the whole row, so test-backend-ops -b CPU checks the hint against a full sort.
+    const int32_t top_k    = ggml_get_op_params_i32(dst, 1);
+    const bool    use_hint = !params->use_ref && top_k > 0 && 4*(int64_t) top_k <= ne0;
+    const int64_t n_sorted = use_hint ? top_k : ne0;
+
     for (int64_t i = ith; i < nr; i += nth) {
         const float * src_data = (float *)((char *) src0->data + i*nb01);
 
@@ -8858,11 +8876,11 @@ static void ggml_compute_forward_argsort_f32(
 
         switch (order) {
             case GGML_SORT_ORDER_ASC:
-                std::sort(dst_data, dst_data + ne0, cmp_argsort<GGML_SORT_ORDER_ASC>{src_data});
+                ggml_argsort_row<GGML_SORT_ORDER_ASC>(dst_data, n_sorted, ne0, src_data);
                 break;
 
             case GGML_SORT_ORDER_DESC:
-                std::sort(dst_data, dst_data + ne0, cmp_argsort<GGML_SORT_ORDER_DESC>{src_data});
+                ggml_argsort_row<GGML_SORT_ORDER_DESC>(dst_data, n_sorted, ne0, src_data);
                 break;
 
             default:
