-    GGML_ASSERT(a->ne[0] >= k);
+    if (k > a->ne[0]) {
+        GGML_ABORT("%s: expected k <= ne0 = %" PRId64 ", got k = %d", __func__, a->ne[0], k);
+    }
 
     struct ggml_tensor * result = ggml_argsort(ctx, a, GGML_SORT_ORDER_DESC);
 
+    // Only the first k ids are read, so a backend may leave the rest of the row unsorted.
+    // The graph stays argsort + view, which the backend top-k fusions match.
+    ggml_set_op_params_i32(result, 1, k);
+
     result = ggml_view_4d(ctx, result,
                 k, result->ne[1], result->ne[2], result->ne[3],
                    result->nb[1], result->nb[2], result->nb[3],
