---
 ggml/src/ggml-cpu/ggml-cpu.c | 151 ++++++++++++++++++++++++++++++++---
 1 file changed, 138 insertions(+), 13 deletions(-)

diff --git a/ggml/src/ggml-cpu/ggml-cpu.c b/ggml/src/ggml-cpu/ggml-cpu.c
index aa414d773..8a78d9334 100644
--- a/ggml/src/ggml-cpu/ggml-cpu.c
+++ b/ggml/src/ggml-cpu/ggml-cpu.c
@@ -3526,6 +3526,121 @@ static int ggml_cpu_try_fuse_ops(
     return 0;
 }
 
+// Nodes up to this many bytes run on thread 0 alone, with no barrier between consecutive ones.
+// 0 disables it. Initialised once in ggml_cpu_init(), read-only afterwards.
+static size_t ggml_cpu_serial_bytes = 32768;
+
+// True for ops that never call ggml_barrier or the threadpool chunk counter, and that give the
+// same result for any thread count, so thread 0 can run them while the other threads skip them.
+static bool ggml_cpu_op_can_run_serial(const struct ggml_tensor * node) {
+    switch (node->op) {
+        case GGML_OP_DUP:
+        case GGML_OP_ADD:
+        case GGML_OP_ADD_ID:
+        case GGML_OP_ADD1:
+        case GGML_OP_SUB:
+        case GGML_OP_MUL:
+        case GGML_OP_DIV:
+        case GGML_OP_SQR:
+        case GGML_OP_SQRT:
+        case GGML_OP_LOG:
+        case GGML_OP_SIN:
+        case GGML_OP_COS:
+        case GGML_OP_SUM:
+        case GGML_OP_SUM_ROWS:
+        case GGML_OP_CUMSUM:
+        case GGML_OP_MEAN:
+        case GGML_OP_ARGMAX:
+        case GGML_OP_REPEAT:
+        case GGML_OP_CONCAT:
+        case GGML_OP_NORM:
+        case GGML_OP_RMS_NORM:
+        case GGML_OP_GROUP_NORM:
+        case GGML_OP_L2_NORM:
+        case GGML_OP_SCALE:
+        case GGML_OP_CPY:
+        case GGML_OP_CONT:
+        case GGML_OP_GET_ROWS:
+        case GGML_OP_SET_ROWS:
+        case GGML_OP_SOFT_MAX:
+        case GGML_OP_ROPE:
+        case GGML_OP_CLAMP:
+        case GGML_OP_PAD:
+        case GGML_OP_ARGSORT:
+        case GGML_OP_TOP_K:
+        case GGML_OP_LEAKY_RELU:
+        case GGML_OP_FILL:
+        case GGML_OP_SSM_CONV:
+        case GGML_OP_DSV4_HC_COMB:
+        case GGML_OP_DSV4_HC_PRE:
+        case GGML_OP_DSV4_HC_POST:
+        case GGML_OP_UNARY:
+        case GGML_OP_GLU:
+            return true;
+        default:
+            return false;
+    }
+}
+
+static size_t ggml_cpu_node_serial_size(const struct ggml_tensor * node) {
+    switch (node->op) {
+        case GGML_OP_GET_ROWS:
+            return ggml_nbytes(node); // src0 is the whole table
+        case GGML_OP_SET_ROWS:
+            return ggml_nbytes(node->src[0]); // dst is the whole table
+        default:
+            return MAX(ggml_nbytes(node), ggml_nbytes(node->src[0]));
+    }
+}
+
+static bool ggml_cpu_node_fits_serial(const struct ggml_tensor * node) {
+    return ggml_cpu_op_can_run_serial(node) && ggml_cpu_node_serial_size(node) <= ggml_cpu_serial_bytes;
+}
+
+// Every thread evaluates this for every node, so all threads agree on where the barriers are.
+static bool ggml_cpu_node_is_serial(const struct ggml_cgraph * cgraph, int node_n) {
+    if (!ggml_cpu_node_fits_serial(cgraph->nodes[node_n])) {
+        return false;
+    }
+
+    // ggml_cpu_try_fuse_ops runs a fused node together with its first node, so both must fit
+    if (cgraph->nodes[node_n]->op == GGML_OP_RMS_NORM && !ggml_cpu_disable_fusion) {
+        const enum ggml_op fuse_ops[] = { GGML_OP_RMS_NORM, GGML_OP_MUL };
+        if (ggml_can_fuse(cgraph, node_n, fuse_ops, 2)) {
+            return ggml_cpu_node_fits_serial(cgraph->nodes[node_n + 1]);
+        }
+    }
+
+    return true;
+}
+
+static bool ggml_cpu_node_is_computed(const struct ggml_tensor * node) {
+    return !ggml_op_is_empty(node->op) && (node->flags & GGML_TENSOR_FLAG_COMPUTE);
+}
+
+static bool ggml_cpu_next_node_is_serial(const struct ggml_cgraph * cgraph, int node_n) {
+    for (int i = node_n + 1; i < cgraph->n_nodes; i++) {
+        if (ggml_cpu_node_is_computed(cgraph->nodes[i])) {
+            return ggml_cpu_node_is_serial(cgraph, i);
+        }
+    }
+    return false;
+}
+
+// Returns the number of nodes skipped by fusion, as ggml_cpu_try_fuse_ops does.
+static int ggml_cpu_compute_node(
+        const struct ggml_cgraph * cgraph,
+        const int node_n,
+        struct ggml_compute_params * params,
+        const struct ggml_cplan * cplan) {
+
+    const int n_fused = ggml_cpu_try_fuse_ops(cgraph, node_n, params, cplan);
+    if (n_fused == 0) {
+        ggml_compute_forward(params, cgraph->nodes[node_n]);
+    }
+    return n_fused;
+}
+
 static thread_ret_t ggml_graph_compute_thread(void * data) {
     struct ggml_compute_state * state = (struct ggml_compute_state *) data;
     struct ggml_threadpool    * tp    = state->threadpool;
@@ -3554,25 +3669,28 @@ static thread_ret_t ggml_graph_compute_thread(void * data) {
     GGML_PRINT_DEBUG("thread #%d compute-start cplan %p last-graph %d\n", state->ith, (const void *)cplan, state->last_graph);
 #endif
 
-    for (int node_n = 0; node_n < cgraph->n_nodes && atomic_load_explicit(&tp->abort, memory_order_relaxed) != node_n; node_n++) {
-        struct ggml_tensor * node = cgraph->nodes[node_n];
+    const bool use_serial = ggml_cpu_serial_bytes > 0 && !cplan->use_ref;
 
-        if (ggml_op_is_empty(node->op)) {
-            // skip NOPs
-            continue;
-        }
+    struct ggml_compute_params serial_params = params;
+    serial_params.nth = 1;
 
-        if ((node->flags & GGML_TENSOR_FLAG_COMPUTE) == 0) {
+    for (int node_n = 0; node_n < cgraph->n_nodes && atomic_load_explicit(&tp->abort, memory_order_relaxed) != node_n; node_n++) {
+        if (!ggml_cpu_node_is_computed(cgraph->nodes[node_n])) {
             continue;
         }
 
         // TODO: move fused-op detection into ggml_graph_plan so fusion decisions are made once at planning time
-        // Try fused ops, fall back to normal compute
-        const int n_fused = ggml_cpu_try_fuse_ops(cgraph, node_n, &params, cplan);
-        if (n_fused > 0) {
-            node_n += n_fused;
-        } else {
-            ggml_compute_forward(&params, node);
+        const bool is_serial = use_serial && ggml_cpu_node_is_serial(cgraph, node_n);
+        if (!is_serial) {
+            node_n += ggml_cpu_compute_node(cgraph, node_n, &params, cplan);
+        } else if (state->ith == 0) {
+            node_n += ggml_cpu_compute_node(cgraph, node_n, &serial_params, cplan);
+        }
+
+        // A run of serial nodes needs one barrier, after its last node. The abort check stays
+        // next to that barrier: the other threads may already have passed any node inside the run.
+        if (is_serial && ggml_cpu_next_node_is_serial(cgraph, node_n)) {
+            continue;
         }
 
         if (state->ith == 0 && cplan->abort_callback &&
@@ -4357,6 +4475,13 @@ void ggml_cpu_init(void) {
             ggml_cpu_disable_fusion = (env != NULL && atoi(env) == 1);
         }
 
+        {
+            const char * env = getenv("GGML_CPU_SERIAL_BYTES");
+            if (env != NULL) {
+                ggml_cpu_serial_bytes = (size_t) atoll(env);
+            }
+        }
+
         is_first_call = false;
     }
 
