         const ggml_compute_params * params,
         ggml_tensor * dst) {
@@ -11550,6 +11581,13 @@ static void ggml_compute_forward_dsv4_hc_pre_f32(
     const int64_t ir0 = dr * ith;
     const int64_t ir1 = MIN(ir0 + dr, nr);
 
+    // use_ref keeps the scalar libm path, so a CPU-only test compares the SIMD path against it
+    const bool rows_contiguous = nbx0 == sizeof(float) && nbw0 == sizeof(float) && nbd0 == sizeof(float);
+    if (gated && rows_contiguous && !params->use_ref) {
+        ggml_compute_forward_dsv4_hc_pre_gated_rows(x, weights, dst, scale, ir0, ir1);
+        return;
+    }
+
     for (int64_t ir = ir0; ir < ir1; ++ir) {
         const int64_t i0 = ir % n_embd;
         const int64_t it = ir / n_embd;
diff --git a/ggml/src/ggml-cpu/vec.cpp b/ggml/src/ggml-cpu/vec.cpp
index 7be3f83ef..1e0c3557a 100644
--- a/ggml/src/ggml-cpu/vec.cpp
+++ b/ggml/src/ggml-cpu/vec.cpp
@@ -489,6 +489,50 @@ void ggml_vec_swiglu_f32(const int n, float * y, const float * x, const float *
     }
 }
 
+void ggml_vec_mad_sigmoid_f32(const int n, float * y, const float * x, const float * g) {
+    int i = 0;
+#if defined(__AVX512F__) && defined(__AVX512DQ__)
+    for (; i + 15 < n; i += 16) {
+        const __m512 xg = _mm512_mul_ps(_mm512_loadu_ps(x + i), ggml_v_sigmoid(_mm512_loadu_ps(g + i)));
+        _mm512_storeu_ps(y + i, _mm512_add_ps(_mm512_loadu_ps(y + i), xg));
+    }
+#elif defined(__AVX2__) && defined(__FMA__)
+    for (; i + 7 < n; i += 8) {
+        const __m256 xg = _mm256_mul_ps(_mm256_loadu_ps(x + i), ggml_v_sigmoid(_mm256_loadu_ps(g + i)));
+        _mm256_storeu_ps(y + i, _mm256_add_ps(_mm256_loadu_ps(y + i), xg));
+    }
+#elif defined(__SSE2__)
+    for (; i + 3 < n; i += 4) {
+        const __m128 xg = _mm_mul_ps(_mm_loadu_ps(x + i), ggml_v_sigmoid(_mm_loadu_ps(g + i)));
+        _mm_storeu_ps(y + i, _mm_add_ps(_mm_loadu_ps(y + i), xg));
+    }
+#elif defined(__ARM_FEATURE_SVE) && defined(__aarch64__)
+    const int vlen = svcntw();
+    for (; i < n; i += vlen) {
+        const svbool_t pg = svwhilelt_b32_s32(i, n);
+        const svfloat32_t xg = svmul_f32_x(pg, svld1_f32(pg, x + i), ggml_v_sigmoid(pg, svld1_f32(pg, g + i)));
+        svst1_f32(pg, y + i, svadd_f32_x(pg, svld1_f32(pg, y + i), xg));
+    }
+#elif defined(__ARM_NEON) && defined(__aarch64__)
+    for (; i + 3 < n; i += 4) {
+        const float32x4_t xg = vmulq_f32(vld1q_f32(x + i), ggml_v_sigmoid(vld1q_f32(g + i)));
+        vst1q_f32(y + i, vaddq_f32(vld1q_f32(y + i), xg));
+    }
+#elif defined(__riscv_v_intrinsic)
+    for (int vl; i < n; i += vl) {
+        vl = __riscv_vsetvl_e32m2(n - i);
+        vfloat32m2_t vx = __riscv_vle32_v_f32m2(&x[i], vl);
+        vfloat32m2_t vg = __riscv_vle32_v_f32m2(&g[i], vl);
+        vfloat32m2_t vy = __riscv_vle32_v_f32m2(&y[i], vl);
+        vy = __riscv_vfadd_vv_f32m2(vy, __riscv_vfmul_vv_f32m2(vx, ggml_v_sigmoid_m2(vg, vl), vl), vl);
+        __riscv_vse32_v_f32m2(&y[i], vy, vl);
+    }
+#endif
+    for (; i < n; ++i) {
+        y[i] += x[i] / (1.f + expf(-g[i]));
+    }
+}
