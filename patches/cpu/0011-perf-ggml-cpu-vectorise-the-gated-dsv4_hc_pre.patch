diff --git a/ggml/src/ggml-cpu/ops.cpp b/ggml/src/ggml-cpu/ops.cpp
index e970b4f6a..2b057da82 100644
--- a/ggml/src/ggml-cpu/ops.cpp
+++ b/ggml/src/ggml-cpu/ops.cpp
@@ -11510,6 +11510,37 @@ void ggml_compute_forward_dsv4_hc_comb(
 
 // ggml_compute_forward_dsv4_hc_pre
 
+// Element range [ir0, ir1) of dst, flattened over (n_embd, n_tokens), one token segment at a time.
+// Sums the streams in the same order as the scalar path.
+static void ggml_compute_forward_dsv4_hc_pre_gated_rows(
+        const ggml_tensor * x,
+        const ggml_tensor * gate,
+        ggml_tensor * dst,
+        const float scale,
+        const int64_t ir0,
+        const int64_t ir1) {
+    const int64_t n_embd = x->ne[0];
+    const int64_t hc     = x->ne[1];
+
+    for (int64_t ir = ir0; ir < ir1; ) {
+        const int64_t it = ir / n_embd;
+        const int64_t i0 = ir % n_embd;
+        const int     n  = (int) MIN(n_embd - i0, ir1 - ir);
+
+        float * d = (float *) ((char *) dst->data + it*dst->nb[1]) + i0;
+
+        ggml_vec_set_f32(n, d, 0.0f);
+        for (int64_t ih = 0; ih < hc; ++ih) {
+            const float * xr = (const float *) ((const char *) x->data    + ih*x->nb[1]    + it*x->nb[2])    + i0;
+            const float * gr = (const float *) ((const char *) gate->data + ih*gate->nb[1] + it*gate->nb[2]) + i0;
+            ggml_vec_mad_sigmoid_f32(n, d, xr, gr);
+        }
+        ggml_vec_scale_f32(n, d, scale);
+
+        ir += n;
+    }
+}
+
