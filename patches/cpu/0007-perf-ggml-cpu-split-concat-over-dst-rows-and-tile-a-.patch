-static void ggml_compute_forward_concat_f16(
+template <typename T>
+static void ggml_concat_copy_row(T * y, const char * x, int64_t n, size_t nb) {
+    if (nb == sizeof(T)) {
+        memcpy(y, x, n*sizeof(T));
+        return;
+    }
+    for (int64_t i = 0; i < n; i++) {
+        y[i] = *(const T *) (x + i*nb);
+    }
+}
