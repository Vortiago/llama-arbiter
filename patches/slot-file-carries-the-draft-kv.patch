+// The draft context holds its own KV for the prompt (an MTP head attends over
+// it). The state file above carries only the target's, so a slot restored on
+// another server drafted over an empty or foreign draft KV, and fewer drafts
+// were accepted. This block carries the draft's sequence state after the
+// checkpoints, the way the in-memory prompt cache carries it.
+static const uint32_t DRAFT_MAGIC = 0x54464451; // "QDFT"
+
+// Returns the bytes appended.
+static size_t draft_save(const std::string & path, llama_context * ctx_dft, llama_seq_id seq_id) {
+    if (ctx_dft == nullptr) {
+        return 0;
+    }
+    std::vector<uint8_t> blob(llama_state_seq_get_size_ext(ctx_dft, seq_id, LLAMA_STATE_SEQ_FLAGS_NONE));
+    blob.resize(llama_state_seq_get_data_ext(ctx_dft, blob.data(), blob.size(), seq_id, LLAMA_STATE_SEQ_FLAGS_NONE));
+    FILE * f = fopen(path.c_str(), "ab");
+    if (!f) {
+        return 0;
+    }
+    const long before = ftell(f);
+    fwrite(&DRAFT_MAGIC, sizeof(DRAFT_MAGIC), 1, f);
+    ckpt_write_blob(f, blob);
+    const long after = ftell(f);
+    fclose(f);
+    return after > before ? (size_t) (after - before) : 0;
+}
+
+// Loads the draft block at `offset` into `ctx_dft`, and returns its bytes. A
+// file without one leaves the draft with no KV for this sequence: KV from an
+// earlier conversation is not this prompt's.
+static size_t draft_load(const std::string & path, size_t offset, llama_context * ctx_dft, llama_seq_id seq_id) {
+    if (ctx_dft == nullptr) {
+        return 0;
+    }
+    llama_memory_seq_rm(llama_get_memory(ctx_dft), seq_id, -1, -1);
+    FILE * f = fopen(path.c_str(), "rb");
+    if (!f) {
+        return 0;
+    }
+    uint32_t magic = 0;
+    std::vector<uint8_t> blob;
+    const bool ok = fseek(f, (long) offset, SEEK_SET) == 0 &&
+                    fread(&magic, sizeof(magic), 1, f) == 1 && magic == DRAFT_MAGIC &&
+                    ckpt_read_blob(f, blob);
+    const long after = ftell(f);
+    fclose(f);
+    if (!ok || llama_state_seq_set_data_ext(ctx_dft, blob.data(), blob.size(), seq_id, LLAMA_STATE_SEQ_FLAGS_NONE) != blob.size()) {
+        llama_memory_seq_rm(llama_get_memory(ctx_dft), seq_id, -1, -1);
+        return 0;
+    }
+    return after > (long) offset ? (size_t) (after - offset) : 0;
+}
+
