diff --git a/scripts/server-test-restore-draft.py b/scripts/server-test-restore-draft.py
new file mode 100755
index 000000000..dcb6f4763
--- /dev/null
+++ b/scripts/server-test-restore-draft.py
@@ -0,0 +1,119 @@
+#!/usr/bin/env python3
+"""A slot restored from a file must draft as well as the server that saved it.
+
+Server A reads a long prompt and answers it twice. The second answer starts
+from a context checkpoint, the way a warm slot does. A saves the slot to a
+file and stops. A fresh server B restores that file and answers the same
+prompt. At temperature 0 the target writes the same text in both cases, so
+the draft must be accepted the same number of times. Before the fix, B's draft
+context held no KV for the restored prompt, and B accepted fewer drafts.
+
+    scripts/server-test-restore-draft.py --server build/bin/llama-server \
+        --model M.gguf --model-draft MTP.gguf --prompt-file text.txt -- <server args>
+
+Exit 0 when B drafts like A, 1 when it does not.
+"""
+
+import argparse
+import json
+import os
+import subprocess
+import sys
+import tempfile
+import time
+import urllib.request
+
+
+def call(port, path, body, timeout=900):
+    req = urllib.request.Request(f"http://127.0.0.1:{port}{path}", json.dumps(body).encode(),
+                                 {"Content-Type": "application/json"})
+    with urllib.request.urlopen(req, timeout=timeout) as r:
+        return json.load(r)
+
+
+def start(args, slot_dir, log_path):
+    cmd = [args.server, "--model", args.model, "--model-draft", args.model_draft,
+           "--spec-type", "draft-mtp", "--spec-draft-n-max", "3",
+           "--parallel", "1", "--cache-ram", "0", "--slot-save-path", slot_dir + "/",
+           "--host", "127.0.0.1", "--port", str(args.port)] + args.extra
+    log = open(log_path, "w")
+    proc = subprocess.Popen(cmd, stdout=log, stderr=subprocess.STDOUT)
+    for _ in range(1200):
+        if proc.poll() is not None:
+            sys.exit(f"server exited, see {log_path}")
+        try:
+            with urllib.request.urlopen(f"http://127.0.0.1:{args.port}/health", timeout=2):
+                return proc
+        except Exception:
+            time.sleep(0.5)
+    proc.kill()
+    sys.exit(f"server did not come up, see {log_path}")
+
+
+def stop(proc):
+    proc.terminate()
+    proc.wait(timeout=120)
+
+
+def ask(args, text, tag):
+    d = call(args.port, "/v1/chat/completions", {
+        "messages": [{"role": "user", "content": text}],
+        "max_tokens": args.n_predict, "temperature": 0,
+        "chat_template_kwargs": {"enable_thinking": False}})
+    t = d["timings"]
+    steps = max(1, t["draft_n"] / 3)
+    print(f"{tag:12s} cache {t['cache_n']:5d} read {t['prompt_n']:5d}, gen {t['predicted_n']}, "
+          f"{t['predicted_per_second']:.2f} tok/s, {t['predicted_ms'] / steps:.1f} ms/step, "
+          f"accepted {t['draft_n_accepted']}/{t['draft_n']}", flush=True)
+    return d["choices"][0]["message"]["content"], t["draft_n_accepted"], t["draft_n"]
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--server", required=True)
+    ap.add_argument("--model", required=True)
+    ap.add_argument("--model-draft", required=True)
+    ap.add_argument("--prompt-file", required=True)
+    ap.add_argument("--prompt-chars", type=int, default=6000)
+    ap.add_argument("--n-predict", type=int, default=128)
+    ap.add_argument("--port", type=int, default=8097)
+    ap.add_argument("--work-dir", default=None)
+    ap.add_argument("extra", nargs="*")
+    args = ap.parse_args()
+
+    work = args.work_dir or tempfile.mkdtemp(prefix="restore-draft-")
+    slot_dir = os.path.join(work, "slots")
+    os.makedirs(slot_dir, exist_ok=True)
+    text = open(args.prompt_file).read()[:args.prompt_chars] + \
+        "\n\nSummarize the text above in about 120 words."
+
+    a = start(args, slot_dir, os.path.join(work, "server-a.log"))
+    try:
+        ask(args, text, "A read")
+        want = ask(args, text, "A warm")
+        saved = call(args.port, "/slots/0?action=save", {"filename": "p.bin"})
+        print(f"saved {saved.get('n_saved')} tokens, {saved.get('n_written')} bytes")
+    finally:
+        stop(a)
+
+    b = start(args, slot_dir, os.path.join(work, "server-b.log"))
+    try:
+        got = call(args.port, "/slots/0?action=restore", {"filename": "p.bin"})
+        print(f"restored {got.get('n_restored')} tokens, {got.get('n_read')} bytes")
+        have = ask(args, text, "B restored")
+    finally:
+        stop(b)
+
+    if have[0] != want[0]:
+        print("FAIL: the target wrote different text after the restore")
+        return 1
+    if have[1:] != want[1:]:
+        print(f"FAIL: drafts accepted {have[1]}/{have[2]} after the restore, "
+              f"{want[1]}/{want[2]} on the server that read the prompt")
+        return 1
+    print("PASS: the restored slot drafts like the server that read the prompt")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
