+def test_anthropic_apply_template():
+    """Render an Anthropic request without running it.
+
+    /apply-template only understands OpenAI-shaped messages, so a client of
+    /v1/messages had no way to ask what its prompt renders to. A tool call is
+    the case that matters: tool_use and tool_result blocks make the OpenAI
+    parser raise "unsupported content[].type".
+    """
+    server.jinja = True
+    server.start()
+
+    body = {
+        "messages": [
+            {"role": "user", "content": [
+                {"type": "text", "text": "What is the weather in Oslo?"}]},
+            {"role": "assistant", "content": [
+                {"type": "text", "text": "Let me check."},
+                {"type": "tool_use", "id": "t1", "name": "get_weather",
+                 "input": {"city": "Oslo"}}]},
+            {"role": "user", "content": [
+                {"type": "tool_result", "tool_use_id": "t1",
+                 "content": [{"type": "text", "text": "7C, rain"}]}]},
+        ]
+    }
+
+    # the OpenAI route cannot read this body
+    res = server.make_request("POST", "/apply-template", data=body)
+    assert res.status_code == 400
+
+    res = server.make_request("POST", "/v1/messages/apply-template", data=body)
+    assert res.status_code == 200
+    prompt = res.body["prompt"]
+    assert "Oslo" in prompt
+    assert "7C, rain" in prompt
+
+    # the rendering has to be the one generation would use, or a prompt
+    # prefilled from it is not a prefix of the real prompt
+    counted = server.make_request("POST", "/v1/messages/count_tokens",
+                                  data={**body, "model": "m"})
+    tokenized = server.make_request("POST", "/tokenize",
+                                    data={"content": prompt,
+                                          "add_special": False})
+    assert len(tokenized.body["tokens"]) == counted.body["input_tokens"]
